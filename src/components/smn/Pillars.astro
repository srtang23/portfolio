---
// Spilt Milk Nannies in three parts (families, sitters, community), drawn as three line-art
// milk bottles at different fill levels. A quiet, minimal take on the brand's own bottles:
// thin grey outlines, soft milk, and only the caps keep the brand colours.
const pillars = [
    { cap: "#2f6f80", level: 18, h: "Busy families", p: "Occasional, high-quality childcare for when family life gets unpredictable." },
    { cap: "#e8c766", level: 34, h: "Exceptional sitters", p: "A hand-picked community of experienced, reliable and fully vetted nannies." },
    { cap: "#e98a86", level: 24, h: "Strong communities", p: "A network of families, caregivers and dedicated small-business owners." },
]
// bottle outline in a 40 × 72 box
const bottle = "M15 9 H25 V15 L30.5 24 V64 Q30.5 69 26 69 H14 Q9.5 69 9.5 64 V24 L15 15 Z"
---

<div class="pillars">
    {
        pillars.map((x, i) => (
            <div class="pillar">
                <svg class="bottle" viewBox="0 0 40 72" aria-hidden="true">
                    <defs>
                        <clipPath id={`pl-clip-${i}`}>
                            <path d={bottle} />
                        </clipPath>
                    </defs>
                    <rect class="air" x="0" y="0" width="40" height="72" clip-path={`url(#pl-clip-${i})`} />
                    <rect class="milk" x="0" y={x.level} width="40" height={72 - x.level} clip-path={`url(#pl-clip-${i})`} />
                    <path class="glass" d={bottle} />
                    <rect x="14" y="3.5" width="12" height="5" rx="1.6" fill={x.cap} />
                </svg>
                <p class="ph">{x.h}</p>
                <p class="pp">{x.p}</p>
            </div>
        ))
    }
</div>

<style>
    .pillars {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 2rem 2rem 1.75rem;
        text-align: center;
    }
    .pillar {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .bottle {
        width: 1.75rem;
        height: auto;
        margin-bottom: 1rem;
        overflow: visible;
    }
    .glass {
        fill: none;
        stroke: #3a3a3a;
        stroke-width: 1.1;
        stroke-linejoin: round;
    }
    .air {
        fill: #ececec;
    }
    .milk {
        fill: #fff;
    }
    .ph {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .pp {
        margin-top: 0.375rem;
        max-width: 15rem;
        font: 400 14px/1.5 var(--para);
        color: var(--label);
        text-wrap: balance;
    }
    @media (max-width: 809.98px) {
        .pillars {
            grid-template-columns: 1fr;
            gap: 1.75rem;
            padding: 1.75rem 1.25rem;
        }
    }
</style>
