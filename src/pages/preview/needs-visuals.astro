---
// Unlisted: the #my-role story told the way rachelchen.tech does it, with short headlines
// carrying the story, a numbered run of user questions, then before → after decision diagrams.
import Base from "../../layouts/Base.astro"

const asks = [
    { n: "01", q: "“I’m booked… now what?”", p: "The booking is confirmed, but the details are spread across email and texts." },
    { n: "02", q: "“Where did the family’s note go?”", p: "It disappears after accepting, so one nanny copied it before tapping accept." },
    { n: "03", q: "“Is this on my calendar?”", p: "All 4 nannies re-entered every booking into a personal calendar by hand." },
    { n: "04", q: "“What should I know before I go?”", p: "Kids’ interests and tips from other nannies are often missing." },
]
const decisions = [
    {
        k: "Decision 1",
        h: "Keep the family’s note after accepting",
        from: "Note disappears after accepting",
        to: "Note stays on the appointment",
        why: "Breaks preparation · fixable on the nanny side",
        out: "fix",
    },
    {
        k: "Decision 2",
        h: "Defer an approve-or-decline step",
        from: "Any family can book any slice of availability",
        to: "Deferred: it would change how families book",
        why: "Breaks booking fit · needs a family-side change",
        out: "later",
    },
]
---

<Base nav="none" noindex title="Preview · My role, Rachel-style">
    <main class="wrap">
        <p class="tag">#my-role</p>

        <!-- 1: the claim, then the evidence as a numbered run of the nanny's own questions -->
        <h2 class="h">A confirmed booking was only part of the job…</h2>
        <p class="body">
            I led the team in mapping each pain point to what the nanny was trying to do at that moment. After a booking was confirmed, nannies were still left asking…
        </p>
        <div class="panel asks">
            {
                asks.map((a) => (
                    <div class="ask">
                        <p class="an">{a.n} /</p>
                        <p class="aq">{a.q}</p>
                        <p class="ap">{a.p}</p>
                    </div>
                ))
            }
        </div>

        <!-- 2: the turn, then the two decisions as before → after diagrams -->
        <h2 class="h cont">…so I guided the team to prioritise by two questions.</h2>
        <p class="body">How much does it disrupt a core flow, and can we change it on the nanny side?</p>
        {
            decisions.map((d) => (
                <div class="dec">
                    <p class="dk">{d.k}</p>
                    <h3 class="dh">{d.h}</h3>
                    <div class="panel diag">
                        <div class="box from">{d.from}</div>
                        <svg class="arr" viewBox="0 0 48 12" aria-hidden="true">
                            <path d="M2 6h42m-6-5 6 5-6 5" />
                        </svg>
                        <div class:list={["box", "to", d.out]}>{d.to}</div>
                    </div>
                    <p class="why">{d.why}</p>
                </div>
            ))
        }
    </main>
</Base>

<style>
    .wrap {
        max-width: 50rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 6rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .h {
        margin-top: 0.25rem;
        font: 500 1.4rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .h.cont {
        margin-top: 2.5rem;
    }
    .panel {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
    }

    /* numbered questions, like Rachel's "01 / The experience left users asking…" */
    .asks {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        padding: 1.25rem;
    }
    .ask {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        background: #fff;
        border: 1px solid #e3e3e3;
        border-radius: 0.5rem;
    }
    .an {
        font: 400 13px/1 var(--sans);
        color: var(--label);
    }
    .aq {
        font: 500 15px/1.3 var(--serif);
        color: var(--ink);
    }
    .ap {
        font: 400 13px/1.45 var(--para);
        color: var(--label);
    }

    /* decisions, like Rachel's "Unclear tool steps → Precise & exhaustive edits" */
    .dec {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .dk {
        font: 400 13px/1 var(--sans);
        color: var(--label);
    }
    .dh {
        font: 500 1.0625rem/1.3 var(--serif);
        color: var(--ink);
    }
    .diag {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: 2.25rem 1.5rem;
    }
    .box {
        flex: 1;
        max-width: 15rem;
        padding: 0.875rem 1rem;
        text-align: center;
        font: 400 14px/1.4 var(--para);
        border-radius: 0.5rem;
    }
    .box.from {
        background: rgba(255, 255, 255, 0.6);
        border: 1px dashed #c3c3c3;
        color: var(--label);
    }
    .box.to.fix {
        background: #fff;
        border: 1px solid #3a3a3a;
        color: var(--ink);
    }
    .box.to.later {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid #c3c3c3;
        color: var(--label);
    }
    .arr {
        flex: none;
        width: 3rem;
        fill: none;
        stroke: #3a3a3a;
        stroke-width: 1.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .why {
        font: 400 13px/1.4 var(--sans);
        color: var(--label);
    }
    @media (max-width: 809.98px) {
        .asks {
            grid-template-columns: 1fr 1fr;
        }
        .diag {
            flex-direction: column;
        }
        .box {
            max-width: none;
            width: 100%;
        }
        .arr {
            transform: rotate(90deg);
        }
    }
</style>
