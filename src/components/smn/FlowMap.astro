---
// The booking flow between the nanny side and the family side, drawn live so it uses the site
// font and the SMN teal. Like the original animation, it plays in two parts when scrolled into
// view: the flow builds up in neutral greys, then the booking path lights up in teal.
// --b is when a piece appears in the build; --h is when it lights up in the highlight.
---

<svg class="flowmap" data-flowmap viewBox="0 0 820 425" role="img" aria-labelledby="flowmap-title">
    <title id="flowmap-title">
        Booking flow. Nanny side: set availability, then availability is posted and shown to families. Family side, out of scope: families browse nannies; if the time is
        covered and they book the nanny, the booking is confirmed and an email notice makes it show up for the nanny. If the time isn't covered, the family requests an open
        shift, which is shown to nannies, who can accept it.
    </title>
    <defs>
        <marker id="fm-a-ink" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1 1 7 4 1 7" fill="none" stroke="#3a3a3a" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
        <marker id="fm-a-grey" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1 1 7 4 1 7" fill="none" stroke="#a3a7ad" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
        <pattern id="fm-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="9" height="9" fill="#f0f0f0"></rect>
            <line x1="0" y1="0" x2="0" y2="9" stroke="#e5e5e5" stroke-width="3"></line>
        </pattern>
    </defs>

    <!-- areas -->
    <g class="st" style="--b:0s">
        <rect class="area-nanny" x="10" y="10" width="800" height="168" rx="12"></rect>
        <text class="area-label" x="30" y="38">Nanny side</text>
        <rect x="10" y="208" width="800" height="207" rx="12" fill="url(#fm-hatch)"></rect>
        <text class="area-label muted" x="30" y="236">Family side</text>
        <rect class="pill" x="30" y="245" width="74" height="19" rx="9.5"></rect>
        <text class="tiny" x="67" y="258" text-anchor="middle">Out of scope</text>
    </g>

    <!-- ===== Part 1: the flow builds up ===== -->
    <g class="st" style="--b:0.3s">
        <rect class="node ink hn" style="--h:0s" x="25" y="50" width="130" height="40" rx="7"></rect>
        <text class="t" x="90" y="74.5" text-anchor="middle">Set availability</text>
    </g>
    <g class="st" style="--b:0.5s"><path class="ln ink" d="M155 70 H191" marker-end="url(#fm-a-ink)"></path></g>
    <g class="st" style="--b:0.65s">
        <rect class="node ink hn" style="--h:0.3s" x="195" y="50" width="130" height="40" rx="7"></rect>
        <text class="t" x="260" y="74.5" text-anchor="middle">Availability posted</text>
    </g>

    <g class="st" style="--b:0.95s">
        <path class="ln grey" d="M260 90 V270"></path>
        <text class="tiny" x="252" y="196" text-anchor="end">shown to families</text>
    </g>
    <g class="st" style="--b:1.15s">
        <rect class="node soft hn" style="--h:0.55s" x="195" y="270" width="130" height="40" rx="7"></rect>
        <text class="t soft-t hn-t" style="--h:0.55s" x="260" y="294.5" text-anchor="middle">Browse nannies</text>
    </g>

    <g class="st" style="--b:1.35s"><path class="ln grey" d="M325 290 H378"></path></g>
    <g class="st" style="--b:1.45s">
        <path class="dia soft hn" style="--h:0.8s" d="M420 260 L462 290 L420 320 L378 290 Z"></path>
        <text class="t s" x="420" y="287" text-anchor="middle">Time</text>
        <text class="t s" x="420" y="300" text-anchor="middle">covered?</text>
    </g>
    <g class="st" style="--b:1.65s">
        <path class="ln grey" d="M462 290 H518"></path>
        <text class="tiny" x="490" y="283" text-anchor="middle">yes</text>
    </g>
    <g class="st" style="--b:1.75s">
        <path class="dia soft hn" style="--h:1.05s" d="M560 260 L602 290 L560 320 L518 290 Z"></path>
        <text class="t s" x="560" y="287" text-anchor="middle">Book this</text>
        <text class="t s" x="560" y="300" text-anchor="middle">nanny?</text>
    </g>
    <g class="st" style="--b:1.95s">
        <path class="ln grey" d="M602 290 H650"></path>
        <text class="tiny" x="626" y="283" text-anchor="middle">yes</text>
    </g>
    <g class="st" style="--b:2.05s">
        <rect class="node soft hn" style="--h:1.3s" x="650" y="270" width="130" height="40" rx="7"></rect>
        <text class="t soft-t hn-t" style="--h:1.3s" x="715" y="294.5" text-anchor="middle">Booking confirmed</text>
    </g>

    <g class="st" style="--b:2.35s">
        <path class="ln grey" d="M420 320 V343" marker-end="url(#fm-a-grey)"></path>
        <text class="tiny" x="428" y="336">no</text>
        <rect class="node soft" x="355" y="345" width="130" height="40" rx="7"></rect>
        <text class="t soft-t" x="420" y="362" text-anchor="middle">Request an open</text>
        <text class="t soft-t" x="420" y="376" text-anchor="middle">shift</text>
    </g>
    <g class="st" style="--b:2.5s">
        <path class="ln grey" d="M560 320 V400 H260 V314" marker-end="url(#fm-a-grey)"></path>
        <text class="tiny" x="568" y="365">no</text>
    </g>
    <g class="st" style="--b:2.75s">
        <path class="ln grey" d="M355 365 H340 V135 H351" marker-end="url(#fm-a-grey)"></path>
        <text class="tiny" x="346" y="196">shown to nannies</text>
    </g>
    <g class="st" style="--b:2.95s">
        <rect class="node ink" x="355" y="115" width="130" height="40" rx="7"></rect>
        <text class="t" x="420" y="132" text-anchor="middle">See open shift</text>
        <text class="t" x="420" y="146" text-anchor="middle">request</text>
    </g>
    <g class="st" style="--b:3.15s"><path class="ln ink" d="M485 135 H512" marker-end="url(#fm-a-ink)"></path></g>
    <g class="st" style="--b:3.3s">
        <path class="dia accept hn-acc" style="--h:1.85s" d="M560 103 L606 135 L560 167 L514 135 Z"></path>
        <text class="t on-strong" x="560" y="139.5" text-anchor="middle">Accept shift?</text>
    </g>
    <g class="st" style="--b:3.5s">
        <path class="ln grey" d="M715 270 V160" marker-end="url(#fm-a-grey)"></path>
        <text class="tiny" x="723" y="196">email notice</text>
    </g>

    <!-- ===== Part 2: the booking path lights up in teal ===== -->
    <path class="hl" style="--h:0.15s" d="M155 70 H195" pathLength="1"></path>
    <path class="hl" style="--h:0.4s" d="M260 90 V270" pathLength="1"></path>
    <path class="hl" style="--h:0.65s" d="M325 290 H378" pathLength="1"></path>
    <path class="hl" style="--h:0.9s" d="M462 290 H518" pathLength="1"></path>
    <path class="hl" style="--h:1.15s" d="M602 290 H650" pathLength="1"></path>
    <path class="hl" style="--h:1.4s" d="M715 270 V155" pathLength="1"></path>
    <g class="hl-in" style="--h:1.6s">
        <rect class="node lit" x="650" y="115" width="130" height="40" rx="7"></rect>
        <text class="t" x="715" y="139.5" text-anchor="middle">Booking shows up</text>
    </g>
    <g class="hl-in" style="--h:2s">
        <path class="ln ink" d="M606 135 H646" marker-end="url(#fm-a-ink)"></path>
        <text class="tiny" x="626" y="128" text-anchor="middle">yes</text>
    </g>
</svg>

<style>
    .flowmap {
        --teal: #3bb3b8;
        --teal-ink: #237f83;
        --build: 3.9s; /* when the highlight starts */
        display: block;
        width: 100%;
        height: auto;
        font-family: var(--sans);
    }
    .area-nanny {
        fill: #fff;
        stroke: #3a3a3a;
    }
    .area-label {
        font-size: 14px;
        font-weight: 500;
        fill: #3a3a3a;
    }
    .area-label.muted {
        fill: #8a8a8a;
    }
    .pill {
        fill: #fff;
        stroke: #dcdcdc;
    }
    .tiny {
        font-size: 10.5px;
        fill: #8f949a;
    }
    .t {
        font-size: 12.5px;
        fill: #3a3a3a;
    }
    .t.s {
        font-size: 11px;
        font-weight: 500;
    }
    .soft-t {
        fill: #8a8a8a;
    }
    .t.on-strong {
        fill: #fff;
        font-size: 11px;
        font-weight: 500;
    }
    .ln {
        fill: none;
        stroke-linejoin: round;
    }
    .ln.ink {
        stroke: #3a3a3a;
        stroke-width: 1;
    }
    .ln.grey {
        stroke: #a3a7ad;
        stroke-width: 1;
    }
    .node {
        fill: #fff;
        stroke-width: 1;
    }
    .node.ink {
        stroke: #3a3a3a;
    }
    .node.soft {
        fill: #f6f6f6;
        stroke: #dedede;
    }
    .node.lit {
        stroke: var(--teal);
        stroke-width: 1.5;
    }
    .dia.soft {
        fill: #e1e1e1;
        stroke: transparent;
        stroke-width: 1.5;
    }
    .dia.accept {
        fill: #8a8a8a;
    }
    .hl {
        fill: none;
        stroke: var(--teal);
        stroke-width: 2;
        stroke-linejoin: round;
    }

    /* the finished, highlighted state: also what shows without scripts or with reduced motion */
    .node.hn,
    .dia.hn {
        stroke: var(--teal);
        stroke-width: 1.5;
    }
    .node.hn {
        fill: #fff;
    }
    .hn-t {
        fill: #3a3a3a;
    }
    .hn-acc {
        fill: var(--teal-ink);
    }

    /* ---- animation, only when scripts run and motion is welcome ---- */
    @media (prefers-reduced-motion: no-preference) {
        :global(.js) .flowmap .st,
        :global(.js) .flowmap .hl-in {
            opacity: 0;
        }
        :global(.js) .flowmap .hl {
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
        }
        /* before the highlight, highlightable pieces wear their neutral look */
        :global(.js) .flowmap .node.ink.hn {
            stroke: #3a3a3a;
            stroke-width: 1;
        }
        :global(.js) .flowmap .node.soft.hn {
            fill: #f6f6f6;
            stroke: #dedede;
            stroke-width: 1;
        }
        :global(.js) .flowmap .dia.hn {
            stroke: transparent;
        }
        :global(.js) .flowmap .hn-t,
        :global(.js) .flowmap .hn-acc {
            fill: #8a8a8a;
        }

        .flowmap.play .st {
            animation: fm-in 0.45s ease var(--b) forwards;
        }
        .flowmap.play .hl {
            animation: fm-draw 0.3s ease-out calc(var(--build) + var(--h)) forwards;
        }
        .flowmap.play .hl-in {
            animation: fm-in 0.4s ease calc(var(--build) + var(--h)) forwards;
        }
        .flowmap.play .node.hn {
            animation: fm-lit 0.35s ease calc(var(--build) + var(--h)) forwards;
        }
        .flowmap.play .dia.hn {
            animation: fm-lit-dia 0.35s ease calc(var(--build) + var(--h)) forwards;
        }
        .flowmap.play .hn-t {
            animation: fm-text 0.35s ease calc(var(--build) + var(--h)) forwards;
        }
        .flowmap.play .hn-acc {
            animation: fm-acc 0.35s ease calc(var(--build) + var(--h)) forwards;
        }
    }
    @keyframes fm-in {
        to {
            opacity: 1;
        }
    }
    @keyframes fm-draw {
        to {
            stroke-dashoffset: 0;
        }
    }
    @keyframes fm-lit {
        to {
            fill: #fff;
            stroke: #3bb3b8;
            stroke-width: 1.5;
        }
    }
    @keyframes fm-lit-dia {
        to {
            stroke: #3bb3b8;
        }
    }
    @keyframes fm-text {
        to {
            fill: #3a3a3a;
        }
    }
    @keyframes fm-acc {
        to {
            fill: #237f83;
        }
    }
</style>

<script>
    // Scripting is on: hold the flow until it scrolls into view, then play it once.
    document.documentElement.classList.add("js")
    const io = new IntersectionObserver(
        (entries) => {
            for (const e of entries) {
                if (e.isIntersecting) {
                    e.target.classList.add("play")
                    io.unobserve(e.target)
                }
            }
        },
        { threshold: 0.45 },
    )
    document.querySelectorAll("[data-flowmap]").forEach((el) => io.observe(el))
</script>
