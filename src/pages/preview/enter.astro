---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Enter animations" noindex>
    <script is:inline>
        const q = new URLSearchParams(location.search)
        document.documentElement.dataset.enter = q.get("v") || "a"
        if (q.has("rec")) document.documentElement.dataset.rec = ""
    </script>
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear aria-label={headline.join(" ")}>
                {
                    headline.map((w, i) => (
                        <span class="word" aria-hidden="true" style={`--i:${i}`}>
                            <span>
                                {[...w].map((c, k) => (
                                    <span class="ch" style={`--c:${headline.slice(0, i).join("").length + k}`}>{c}</span>
                                ))}
                            </span>
                        </span>
                    ))
                }
            </h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <p class="caption">
                                            <span class="name">{p.title}</span>
                                            <span class="slash" aria-hidden="true">/</span>
                                            <span class="meta">{p.meta}</span>
                                        </p>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
    <nav class="switch" aria-label="Enter animation">
        <a href="?v=a">A · Blur in</a>
        <a href="?v=b">B · Letter cascade</a>
        <a href="?v=c">C · Line wipe</a>
        <a href="?v=d">D · Sky first</a>
        <a href="?v=now">Current</a>
    </nav>
</Base>

<style is:global>
    /* ---------- Enter animation variants (preview) ---------- */
    .switch {
        position: fixed;
        z-index: 60;
        left: 50%;
        bottom: 1.25rem;
        transform: translateX(-50%);
        display: flex;
        gap: 0.25rem;
        padding: 0.25rem;
        border-radius: 999px;
        background: rgba(17, 17, 17, 0.88);
    }
    .switch a {
        padding: 0.5rem 0.875rem;
        border-radius: 999px;
        color: rgba(255, 255, 255, 0.72);
        font: 500 0.75rem/1 var(--sans);
        white-space: nowrap;
    }
    html[data-enter="a"] .switch a[href="?v=a"],
    html[data-enter="b"] .switch a[href="?v=b"],
    html[data-enter="c"] .switch a[href="?v=c"],
    html[data-enter="d"] .switch a[href="?v=d"],
    html[data-enter="now"] .switch a[href="?v=now"] {
        background: #fff;
        color: #111;
    }
    .ch {
        display: inline-block;
    }

    /* reset the current word-rise for the new variants */
    html:not([data-enter="now"]) .word {
        overflow: visible !important;
    }
    html:not([data-enter="now"]) .word > span {
        transform: none !important;
        animation: none !important;
    }

    /* A: blur in. Headline sharpens from a soft blur, then the intro, then the sky */
    html[data-enter="a"] .headline {
        animation: e-blur 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.1s;
    }
    html[data-enter="a"] .lede {
        animation: e-blur 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.55s;
    }
    html[data-enter="a"] .sky {
        animation: e-fade 1.8s ease both 0.3s;
    }
    @keyframes e-blur {
        from {
            opacity: 0;
            filter: blur(14px);
            transform: scale(1.03);
        }
        to {
            opacity: 1;
            filter: none;
            transform: none;
        }
    }

    /* B: letter cascade. Each letter drifts up and fades in, one after another */
    html[data-enter="b"] .ch {
        animation: e-letter 0.9s var(--spring) both;
        animation-delay: calc(0.1s + var(--c) * 0.028s);
    }
    html[data-enter="b"] .lede {
        animation: e-up 1s var(--spring) both 1.1s;
    }
    html[data-enter="b"] .sky {
        animation: e-fade 1.6s ease both;
    }
    @keyframes e-letter {
        from {
            opacity: 0;
            transform: translateY(0.35em) rotate(4deg);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    /* C: line wipe. The headline is uncovered left to right, like ink drawn across */
    html[data-enter="c"] .headline {
        animation: e-wipe 1.3s cubic-bezier(0.65, 0, 0.35, 1) both 0.15s;
    }
    html[data-enter="c"] .lede {
        animation: e-wipe 1.1s cubic-bezier(0.65, 0, 0.35, 1) both 0.75s;
    }
    html[data-enter="c"] .sky {
        animation: e-fade 1.6s ease both;
    }
    @keyframes e-wipe {
        from {
            clip-path: inset(0 100% 0 0);
        }
        to {
            clip-path: inset(0 0 0 0);
        }
    }

    /* D: sky first. The clouds gather over plain paper, then the words settle on top */
    html[data-enter="d"] .sky {
        animation: e-sky 2s ease both;
    }
    html[data-enter="d"] .headline {
        animation: e-up 1.2s var(--spring) both 1s;
    }
    html[data-enter="d"] .lede {
        animation: e-up 1.2s var(--spring) both 1.25s;
    }
    html[data-enter="d"] .top-nav {
        animation: e-fade 1s ease both 1.6s;
    }
    @keyframes e-sky {
        from {
            opacity: 0;
            transform: scale(1.08);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes e-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes e-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    html[data-rec] .switch {
        display: none;
    }
</style>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    /* each word rises out of a mask */
    .word {
        display: inline-block;
        overflow: hidden;
        padding: 0 0.06em 0.12em;
        margin-bottom: -0.12em;
        vertical-align: top;
    }
    .word > span {
        display: inline-block;
        transform: translateY(105%);
        animation: rise 1.1s var(--spring) forwards;
        animation-delay: calc(0.15s + var(--i) * 0.07s);
    }
    @keyframes rise {
        to {
            transform: none;
        }
    }
    .lede {
        max-width: 38rem;
        font: 400 1.25rem/1.5 var(--sans);
        color: var(--body);
        opacity: 0;
        animation: fade 1s ease forwards 0.75s;
    }
    @keyframes fade {
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    .caption {
        display: flex;
        gap: 0.5rem;
        font: 400 0.9375rem/1.5 var(--sans);
        letter-spacing: 0.005em;
    }
    .name {
        color: var(--ink);
    }
    .slash,
    .meta {
        color: var(--label);
    }
    .card:hover .name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--border);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .word > span,
        .lede {
            animation: none;
            transform: none;
            opacity: 1;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1.125rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 1rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>
