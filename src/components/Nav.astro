---
import { links } from "../data/projects"

// Site nav: the logo, Work and About in a paper pill on the left, and a Resume pill on
// the right. Both pills float over the page with a light blur, so they sit well on
// paper, on the Home sky and on the case study heroes alike.
// `variant` is kept so pages can still pass one; "none" hides the nav.
interface Props {
    variant?: "default" | "case" | "sky" | "none"
}
---

<nav class="top-nav" aria-label="Main">
    <div class="pill main">
        <a class="logo" href="/" aria-label="Home"><img src="/images/logo-solid.png" alt="" width="30" height="24" /></a>
        <a class="link" href="/#selected-work">Work</a>
        <a class="link" href="/about">About</a>
    </div>
    <a class="pill cv" href={links.resume} target="_blank" rel="noopener noreferrer">
        Resume <span class="arr" aria-hidden="true">↗</span>
        <span class="sr">(opens in a new tab)</span>
    </a>
</nav>

<style>
    .top-nav {
        position: fixed;
        z-index: 50;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        /* lines up with the page edges (Home cards, case study side nav and text) */
        padding: 1.25rem var(--gutter);
        pointer-events: none;
        transition:
            transform 0.45s var(--spring),
            opacity 0.3s ease;
    }
    /* slides away while scrolling down, comes back on scroll up */
    .top-nav.hide {
        transform: translateY(-110%);
        opacity: 0;
    }
    .top-nav.hide .pill {
        pointer-events: none;
    }
    /* plain text links, no pill */
    .pill {
        pointer-events: auto;
        display: flex;
        align-items: center;
        height: 2.75rem;
        font: 400 0.8125rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--nav);
        transition: color 0.2s ease;
    }
    .main {
        gap: 1.75rem;
    }
    .link {
        color: var(--nav);
        transition: color 0.2s ease;
    }
    .link:hover {
        color: var(--ink);
    }
    .logo {
        margin-right: 0.25rem;
    }
    .logo img {
        width: 1.875rem;
        height: 1.5rem;
        transition: transform 0.7s var(--spring);
    }
    .logo:hover img {
        transform: rotate(360deg);
    }

    .arr {
        display: inline-block;
        margin-left: 0.25rem;
        transition: transform 0.4s var(--spring);
    }
    .cv:hover {
        color: var(--ink);
    }
    .cv:hover .arr {
        transform: translate(0.125rem, -0.125rem);
    }
    .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 809.98px) {
        .top-nav {
            padding: 1rem var(--gutter);
        }
        .pill {
            height: 2.5rem;
        }
        .main {
            gap: 1.25rem;
        }
        .logo img {
            width: 1.625rem;
            height: 1.3rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .top-nav {
            transition: opacity 0.2s ease;
        }
        .top-nav.hide {
            transform: none;
        }
    }
</style>

<script>
    // Hide on scroll down, show on scroll up (always shown near the top of the page,
    // and whenever something in the nav has keyboard focus).
    const nav = document.querySelector<HTMLElement>(".top-nav")
    if (nav) {
        let lastY = scrollY
        let frame = 0
        const update = () => {
            frame = 0
            const y = Math.max(0, scrollY)
            const dy = y - lastY
            if (Math.abs(dy) < 6) return
            const hide = dy > 0 && y > 120 && !nav.contains(document.activeElement)
            nav.classList.toggle("hide", hide)
            lastY = y
        }
        addEventListener("scroll", () => frame || (frame = requestAnimationFrame(update)), { passive: true })
        nav.addEventListener("focusin", () => nav.classList.remove("hide"))
    }
</script>
