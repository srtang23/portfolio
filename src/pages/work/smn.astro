---
import Base from "../../layouts/Base.astro"
import CaseNav from "../../components/CaseNav.astro"
import StoryPhone from "../../components/smn/StoryPhone.astro"
import RevealBand from "../../components/smn/RevealBand.astro"
import NeedsShift from "../../components/smn/NeedsShift.astro"

const sections = [
    { id: "overview", label: "Overview" },
    { id: "solution", label: "Solution" },
    { id: "problem", label: "Problem" },
    { id: "challenge", label: "Challenge" },
    { id: "research", label: "Research" },
    { id: "process", label: "Pivot" },
    { id: "my-role", label: "My role" },
    { id: "opportunity", label: "Opportunity" },
    { id: "results", label: "Results" },
    { id: "reflection", label: "Reflection" },
]

const info = [
    { h: "My Role", items: ["Design Research Lead", "Concept Development", "Design Strategy"] },
    { h: "Team", items: ["4 Designers"] },
    { h: "Timeline", items: ["Mar – June 2026", "(11 weeks)"] },
    { h: "Skills", items: ["User Research", "Prototyping"] },
]

const outcomes = [
    { label: "Steps to set availability", value: "10 → 6 steps", text: "A 40% reduction in steps, from start to saved." },
    { label: "Recurring availability setup", value: "~50% less time", text: "Estimated reduction in time spent setting up recurring availability." },
    { label: "Developer handoff", value: "Dev-ready", text: "Audited for usability, with type styles and reusable components, handed off in Figma Dev Mode." },
]

const steps = [
    {
        h: "A Central Starting Point for Everyone",
        p: "We brought key information and actions into one place, helping nannies move more seamlessly between managing availability, finding shifts, and taking on work.",
    },
    {
        h: "Making Time Easier to Manage",
        p: "We simplified the availability management process by reducing unnecessary steps and making schedule updates more intuitive, allowing nannies to easily adjust their availability and stay open to new shift opportunities with less effort.",
    },
    {
        h: "A Clearer View of What’s Ahead",
        p: "We transformed the mobile schedule into an easy-to-scan experience, helping nannies see their commitments and identify opportunities at a glance.",
    },
    {
        h: "Closing the Loop After Every Shift",
        p: "We introduced a post-session flow to reduce friction in documenting session notes and sharing feedback, helping nannies complete essential tasks more seamlessly.",
    },
]

const insights = [
    { img: "insight-1.png", h: "Availability ≠ Autonomy", p: "Being free doesn’t mean every job fits their life." },
    { img: "insight-2.png", h: "Confirmation ≠ Preparation", p: "A confirmed shift still leaves nannies unsure what to expect." },
    { img: "insight-3.png", h: "Digital Booking, Manual Coordination", p: "A last-minute cancel means texting the family, then emailing the coordinator." },
    { img: "insight-4.png", h: "Trust Grows Through Shared Knowledge", p: "Tips travel through group chats, and concerns through phone calls to coordinators." },
]

const needs = [
    {
        want: "A nanny community",
        wantNote: "Somewhere to connect and swap stories with other nannies.",
        need: "Shared knowledge about families",
        job: "I want a sustainable way to share and learn context about a family that complements their profile.",
    },
    {
        want: "More control over bookings",
        wantNote: "To choose which families book them, and when.",
        need: "Jobs that fit my life",
        job: "I want to take on jobs that align with my preferences, needs, and personal circumstances.",
    },
    {
        want: "Direct booking coordination",
        wantNote: "To arrange, change or cancel bookings with families directly, instead of going through a coordinator.",
        need: "Greater control and flexibility",
        job: "I want to manage booking changes efficiently, with minimal back-and-forth.",
    },
]

const quotes = [
    {
        who: "Nanny, usability testing",
        initials: "N",
        text: "I really love how this turned out! Everything feels so much more intuitive and easier to navigate. I really appreciate the post-session notes. It’s nice to finally have a place to share how a session went and leave helpful tips for other nannies.",
    },
    {
        who: "Spilt Milk Nannies stakeholder",
        initials: "SM",
        text: "This is so great! This part in the motivation section makes me reconsider a community group or board for nannies to share things.",
    },
]

const reflections = [
    {
        h: "Look beyond the interface",
        p: "What began as a platform redesign became a study of how nannies, families and coordinators work together across the whole service. A service design lens taught me to design for the relationships and processes around a product, not just its screens.",
    },
    {
        h: "Find focus in complexity",
        p: "Research surfaced more opportunities than we could pursue. Leading prioritization taught me to separate interesting findings from essential needs, and to turn a broad challenge into focused directions.",
    },
    {
        h: "Design within constraints",
        p: "Nannies wanted more control over bookings, but changing the booking model was out of scope. I learned to balance their needs with the client’s goals and improve the experience within what we could realistically change.",
    },
]

const img = (f: string) => `/images/smn/${f}`
---

<Base
    nav="case"
    title="Spilt Milk Nannies · Sophia Tang"
    description="Redesigning the nanny side of a childcare booking platform: availability, shifts and post-session notes for Spilt Milk Nannies."
>
    <CaseNav sections={sections} />

    <main class="case">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>Streamlining the Digital Caregiver Workflow</h1>
            </div>
            <div class="hero-window">
                <img
                    class="hero-phones"
                    data-parallax
                    src={img("hero-phones.png")}
                    alt="Spilt Milk Nannies app screens"
                    width="3914"
                    height="1714"
                    fetchpriority="high"
                />
            </div>
        </header>

        <div class="content first">
            <!-- Project info -->
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview -->
            <section id="overview" class="sec">
                <p class="tag">#overview</p>
                <h2 class="h">Reimagining the nanny side of Spilt Milk Nannies around caregivers’ core workflows, resulting in 40% fewer scheduling steps.</h2>
                <p class="body">
                    Spilt Milk Nannies connects families seeking flexible childcare with nannies looking for work. The platform had long prioritized parents, so as a team of 4 designers
                    over 11 weeks, we redesigned how nannies manage availability, find shifts and take on work.
                </p>
                <div class="outcomes">
                    {
                        outcomes.map((o, i) => (
                            <div class="card outcome reveal" style={`--delay:${i * 0.08}s`}>
                                <p class="tag">{o.label}</p>
                                <p class="value">{o.value}</p>
                                <p class="body">{o.text}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Solution -->
            <section id="solution" class="sec story">
                <div class="phone-col">
                    <p class="tag">#solution</p>
                    <StoryPhone count={steps.length} />
                </div>
                <div class="steps">
                    {
                        steps.map((s, i) => (
                            <div class="step" data-step={i}>
                                <h3>{s.h}</h3>
                                <p class="body">{s.p}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Problem -->
            <section id="problem" class="sec">
                <p class="tag">#problem</p>
                <h2 class="h">A two-sided service, one side had been overlooked.</h2>
                <p class="body">
                    Nannies had varying schedules and preferences for finding work, but the existing platform offered limited flexibility in how they managed availability and
                    discovered shifts.
                </p>
                <div class="panel flow">
                    <video
                        data-loop
                        poster={img("flow-poster.jpg")}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label="Animated booking flow: the nanny side and family side build up, the booking path is highlighted, then the nanny side grows to take over."
                    >
                        <source src="/video/smn/flow.mp4" type="video/mp4" />
                        <source src="/video/smn/flow.webm" type="video/webm" />
                    </video>
                </div>
            </section>
        </div>

        <RevealBand
            id="challenge"
            text="How might we **simplify this experience** and explore ways to **encourage greater engagement**, **shift participation**, and **long-term retention?**"
        />

        <div class="content">
            <!-- Research -->
            <section id="research" class="sec gap-16">
                <p class="tag">#research</p>
                <h2 class="h">What’s holding them back?</h2>
                <p class="body">
                    The client approached us with a broad challenge: increasing nanny engagement, shift participation, and long-term retention. To understand the underlying
                    barriers, we interviewed 10 nannies about their everyday experiences, from managing availability to coordinating with families. Our research revealed four key
                    insights:
                </p>
                <div class="panel insights">
                    {
                        insights.map((x) => (
                            <div class="insight">
                                <div class="preview">
                                    <img src={img(x.img)} alt="" loading="lazy" />
                                </div>
                                <div class="insight-text">
                                    <h3>{x.h}</h3>
                                    <p>{x.p}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Pivot -->
            <section id="process" class="sec">
                <p class="tag">#pivot</p>
                <h2 class="h">The biggest problem was hiding in the workflow.</h2>
                <p class="body">
                    Our research revealed a gap between getting booked and managing the work that followed. While the platform supported finding and accepting shifts, much of
                    the caregiving journey, from preparing for sessions to coordinating changes and following up, happened across disconnected channels. These small moments of
                    friction accumulated over time, adding effort to everyday participation and making it harder for nannies to stay engaged.
                </p>
                <div class="panel journey">
                    <picture>
                        <source media="(max-width: 809.98px)" srcset={img("journey-phone.png")} />
                        <img
                            src={img("journey.png")}
                            loading="lazy"
                            alt="Nanny journey: post availability, browse shifts, accept a booking and get booked happen on the platform; preparing, managing changes, the session itself and follow up are handled off the platform."
                        />
                    </picture>
                </div>
            </section>

            <!-- My role -->
            <section id="my-role" class="sec gap-16">
                <p class="tag">#my-role</p>
                <h2 class="h">What do nannies really need from this platform?</h2>
                <p class="body">
                    Our research uncovered diverse needs, from stronger peer connections to greater control over work opportunities. To move beyond individual feature requests, I
                    led the team to take a step back by asking: <em>What are nannies fundamentally trying to accomplish through this platform?</em>
                </p>
                <p class="body">
                    I guided the team in prioritizing pain points based on their relevance to core workflows and project feasibility, then translated them into Jobs to Be Done that
                    aligned the team around essential user needs and informed our design direction.
                </p>
                <div class="panel placeholder">
                    <p>[Placeholder: visual]</p>
                </div>
                <NeedsShift rows={needs} labels={["What nannies asked for", "The underlying need", "User goal"]} />
            </section>
        </div>

        <RevealBand
            id="opportunity"
            text="How might we create a **more connected and intuitive experience** that **supports nannies throughout their caregiving journey?**"
        />

        <div class="content last">
            <!-- Results -->
            <section id="results" class="sec gap-16">
                <p class="tag">#results</p>
                <h2 class="h">What we delivered</h2>
                <p class="body">
                    Beyond redesigning key nanny workflows, we systematically audited the platform against usability best practices and established a consistent design foundation
                    with typography styles and reusable UI components, preparing the final designs for developer handoff through Figma Dev Mode.
                </p>
                <div class="panel quotes">
                    {
                        quotes.map((q) => (
                            <figure class="quote">
                                <div class="avatar" aria-hidden="true">
                                    {q.initials}
                                </div>
                                <div class="quote-body">
                                    <figcaption class="tag">{q.who}</figcaption>
                                    <blockquote>
                                        <p>{q.text}</p>
                                    </blockquote>
                                </div>
                            </figure>
                        ))
                    }
                </div>
                <p class="body">Our work also encouraged the client to look beyond booking efficiency and rethink how the platform could better support and engage caregivers.</p>
            </section>

            <!-- Reflection -->
            <section id="reflection" class="sec reflection">
                <p class="tag">#reflection</p>
                <h2 class="h">Seeing the big picture and sweating the details.</h2>
                <ol class="reflections">
                    {
                        reflections.map((r, i) => (
                            <li>
                                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <h3>{r.h}</h3>
                                    <p class="body">{r.p}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </div>
    </main>
</Base>

<style>
    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        height: 90vh;
        padding-top: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        border-radius: 0 0 5rem 5rem;
        background: url("/images/smn/hero-bg.jpg") center / cover no-repeat;
    }
    .grain {
        position: absolute;
        inset: 0 0 -2px 0;
        background: url("/images/smn/grain.png") center / cover;
        pointer-events: none;
    }
    .title-area {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 1.5rem;
    }
    .hero h1 {
        max-width: 66.67%;
        font: 500 4.25rem/1.25 var(--serif);
        letter-spacing: -0.02em;
        color: #fff;
        text-align: center;
    }
    .hero-window {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 68.75rem;
        height: 18.75rem;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
    }
    .hero-phones {
        flex-shrink: 0;
        width: 141.36%;
        max-width: none;
        height: 42.5625rem;
        object-fit: cover;
        object-position: center top;
        will-change: transform;
    }

    /* ---------- Content columns ---------- */
    .content {
        display: flex;
        flex-direction: column;
        gap: 4.5rem;
        padding: 7.5rem 8.875rem 7.5rem 24.5rem;
    }
    .content.first {
        padding-top: 6rem;
    }
    .content.last {
        padding-bottom: 2.5rem;
    }

    .sec {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .sec.gap-16 {
        gap: 1rem;
    }
    .h {
        font: 500 1.1875rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .paras {
        display: flex;
        flex-direction: column;
        gap: 1.4em;
    }
    em {
        font-style: italic;
        font-synthesis: style;
    }

    /* Project info */
    .info {
        display: flex;
        justify-content: space-between;
        margin: 0;
    }
    .info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }
    .info dt {
        font: 500 1.1875rem/1.2 var(--serif);
        letter-spacing: -0.2px;
        color: var(--body);
    }
    .info dd {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font: 400 0.875rem/1.4 var(--sans);
        color: var(--ink-2);
    }

    /* Cards and panels */
    /* Borders are drawn inside the box (as in the Framer design), so they don't eat into the content width */
    .card,
    .insight,
    .quote blockquote {
        box-shadow: inset 0 0 0 1px var(--border);
    }
    .card {
        background: var(--white);
        border-radius: 1rem;
    }
    .outcomes {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        padding: 0.5rem 0;
    }
    .outcome {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
    }
    .outcome.reveal {
        transform: none;
        transition: opacity 0.5s ease;
    }
    .value {
        font: 500 1.75rem/1.15 var(--serif);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .panel {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid var(--border);
        border-radius: inherit;
        pointer-events: none;
    }

    /* Solution */
    .story {
        flex-direction: row;
        align-items: flex-start;
        gap: 4rem;
    }
    .phone-col {
        position: sticky;
        top: 6.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-shrink: 0;
    }
    .steps {
        flex: 1;
        min-width: 0;
    }
    .step {
        height: 33.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.875rem;
    }
    .step h3 {
        font: 500 1.1875rem/1.15 var(--serif);
        letter-spacing: -0.5px;
        color: var(--ink);
    }

    /* Problem */
    .flow video {
        display: block;
        width: 100%;
        aspect-ratio: 1.6;
        object-fit: cover;
    }

    /* Research */
    .insights {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 1fr;
        gap: 0.75rem;
        padding: 0.875rem;
    }
    .insight {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 0.375rem 0.375rem 0.875rem;
        background: var(--white);
        border-radius: 1rem;
    }
    .preview {
        border-radius: 0.625rem;
        background: #f0f0f0;
        overflow: hidden;
    }
    .preview img {
        width: 100%;
        height: auto;
    }
    .insight-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.5rem;
    }
    .insight h3 {
        font: 500 0.875rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--ink);
    }
    .insight p {
        font: 400 0.8125rem/1.5 var(--sans);
        letter-spacing: 0.01em;
        color: var(--body);
    }

    /* Pivot */
    .journey {
        padding: 2.25rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .journey picture,
    .journey img {
        width: 100%;
        height: auto;
    }

    /* My role */
    .placeholder {
        padding: 7.5rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .placeholder p {
        font: 400 0.8125rem/1.4 var(--sans);
        color: var(--label);
    }

    /* Results */
    .quotes {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 0.875rem 0.875rem 1.5rem;
    }
    .quote {
        margin: 0;
        display: flex;
        gap: 1rem;
        padding: 0 0.625rem;
    }
    .avatar {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        background: #ecebe7;
        display: grid;
        place-items: center;
        font: 500 0.75rem/1 var(--sans);
        color: var(--label);
    }
    .quote-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .quote blockquote {
        margin: 0;
        padding: 1.125rem 1.375rem;
        background: var(--white);
        border-radius: 4px 1rem 1rem 1rem;
    }
    .quote blockquote p {
        font: italic 400 1rem/1.5 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }

    /* Reflection */
    .reflection {
        padding-bottom: 3.75rem;
    }
    .reflections {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0 0;
    }
    .reflections li {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
    }
    .num {
        flex-shrink: 0;
        width: 1.75rem;
        font: 400 0.75rem/1.375rem var(--sans);
        color: var(--label);
    }
    .reflections li > div {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .reflections h3 {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .reflections::before {
        content: "";
        display: block;
        height: 1px;
        background: var(--border);
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .hero {
            padding-top: 6.25rem;
        }
        .hero h1 {
            max-width: 50%;
            font-size: 3rem;
            line-height: 1.05;
        }
        .content {
            padding: 6rem 3rem 6rem 11.5rem;
        }
        .content.first {
            padding-top: 4rem;
        }
        .content.last {
            padding-bottom: 10rem;
        }
        .info {
            gap: 2rem;
        }
        .info dd {
            white-space: nowrap;
        }
        .value {
            font-size: 1.625rem;
        }
        .story {
            gap: 2.5rem;
        }
        .step {
            height: 28.75rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding-top: 5.625rem;
        }
        .hero h1 {
            max-width: 66.67%;
            font-size: 2.25rem;
            line-height: 1.08;
        }
        .hero-window {
            height: 13.125rem;
        }
        .hero-phones {
            width: 170%;
            height: 18.1875rem;
        }
        .content {
            gap: 5rem;
            padding: 5rem 1.25rem;
        }
        .content.first {
            padding-top: 4rem;
        }
        .content.last {
            padding-bottom: 8.75rem;
        }
        .info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.75rem;
            padding-bottom: 1.5rem;
        }
        .outcomes {
            grid-template-columns: 1fr;
            grid-auto-rows: 1fr;
        }
        .value {
            font-size: 1.75rem;
        }
        .story {
            gap: 1.125rem;
        }
        .phone-col {
            gap: 0.625rem;
        }
        .step {
            height: 21.25rem;
            gap: 0.5rem;
        }
        .panel {
            border-radius: 0.75rem;
        }
        .insights {
            grid-template-columns: 1fr;
        }
        .journey {
            padding: 1.25rem 0.75rem;
        }
        .journey picture,
        .journey img {
            width: 86%;
        }
        .journey picture img {
            width: 100%;
        }
        .placeholder {
            padding: 4.5rem 1rem;
        }
        .quotes {
            padding: 0.625rem 0.625rem 1.125rem;
        }
        .quote {
            gap: 0.75rem;
            padding: 0 0.25rem;
        }
        .avatar {
            width: 2rem;
            height: 2rem;
        }
        .quote blockquote {
            padding: 0.875rem 1rem;
        }
        .quote blockquote p {
            font-size: 0.9375rem;
        }
        .reflections li {
            gap: 0.875rem;
            padding: 1.25rem 0;
        }
    }
</style>

<script>
    // Hero phones drift up as you scroll (capped so they never run out of the window).
    const phones = document.querySelector<HTMLElement>("[data-parallax]")
    if (phones && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let frame = 0
        const update = () => {
            frame = 0
            const k = parseFloat(getComputedStyle(document.documentElement).fontSize) / 16
            const max = 300 * k
            const y = Math.min(Math.max(scrollY, 0) * 0.2, max)
            phones.style.transform = `translate3d(0, ${-y}px, 0)`
        }
        const on = () => {
            if (!frame) frame = requestAnimationFrame(update)
        }
        update()
        addEventListener("scroll", on, { passive: true })
        addEventListener("resize", on)
        addEventListener("pageshow", update)
    }

    // Looping videos only play while they're on screen.
    const loops = document.querySelectorAll<HTMLVideoElement>("video[data-loop]")
    const vio = new IntersectionObserver(
        (entries) => {
            for (const e of entries) {
                const v = e.target as HTMLVideoElement
                if (e.isIntersecting) v.play().catch(() => {})
                else v.pause()
            }
        },
        { threshold: 0.25 },
    )
    loops.forEach((v) => vio.observe(v))
</script>

<style is:global>
    /* Case studies sit on a slightly cooler, greyer paper than the rest of the site */
    :root {
        --paper: #f8f8f7;
    }
</style>
