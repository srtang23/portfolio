---
// Unlisted: four options for the Scribble opportunity visual, to compare.
import Base from "../../layouts/Base.astro"

const heap = ["Change careers", "Learn to code", "Update resume", "Grow my network", "Get certified", "Ask for the raise", "Finish the degree"]
const rnd = (i: number, k: number) => {
    const v = Math.sin((i + 1) * 12.9898 + k * 78.233) * 43758.5453
    return v - Math.floor(v)
}
const steps = ["List three roles that interest you", "Message one person in that field", "Pick one skill to learn first"]
---

<Base nav="none" noindex title="Preview · Opportunity visuals">
    <main class="wrap">
        <header class="head">
            <p class="tag">#opportunity</p>
            <h2 class="h">What if… people could start making progress without knowing exactly where to begin?</h2>
        </header>

        <!-- 1 -->
        <section class="opt">
            <p class="ol">1 · From pile to plan</p>
            <div class="panel v1">
                <div class="mini-heap" aria-hidden="true">
                    {
                        heap.map((t, i) => (
                            <span class="chip" style={`left:${8 + (i % 3) * 20 + (rnd(i, 1) - 0.5) * 10}%;top:${12 + Math.floor(i / 3) * 26 + (rnd(i, 2) - 0.5) * 10}%;transform:rotate(${((rnd(i, 3) - 0.5) * 30).toFixed(1)}deg)`}>
                                <b />
                                {t}
                            </span>
                        ))
                    }
                </div>
                <div class="mid">
                    <span class="bubble">I want to change careers but don’t know where to start.</span>
                    <svg class="arrow" viewBox="0 0 60 12" aria-hidden="true"><path d="M2 6h54m-6-5 6 5-6 5" /></svg>
                </div>
                <div class="plan">
                    <p class="goal">Change careers</p>
                    <ol>
                        {
                            steps.map((s, i) => (
                                <li class:list={{ first: i === 0 }}>
                                    <b />
                                    <span>{s}</span>
                                    {i === 0 && <em>Start here</em>}
                                </li>
                            ))
                        }
                    </ol>
                </div>
            </div>
        </section>

        <!-- 2 -->
        <section class="opt">
            <p class="ol">2 · A thought becoming a plan</p>
            <div class="panel v2">
                <span class="bubble big">I keep saying I’ll get fit… maybe running? but work is busy and I never know where to start, and…</span>
                <svg class="down" viewBox="0 0 12 40" aria-hidden="true"><path d="M6 2v34m-5-6 5 6 5-6" /></svg>
                <div class="plan">
                    <p class="goal">Get fit</p>
                    <ol>
                        <li class="first"><b /><span>This week: two 20-minute walks</span><em>Start here</em></li>
                        <li><b /><span>Next week: try one short run</span></li>
                        <li><b /><span>Pick a 5K to aim for</span></li>
                    </ol>
                </div>
            </div>
        </section>

        <!-- 3 -->
        <section class="opt">
            <p class="ol">3 · “Where do I begin?” → “Start here”</p>
            <div class="panel v3">
                <p class="goal big">Change careers</p>
                <div class="ladder">
                    <span class="s s1">Explore what interests you</span>
                    <span class="s s2">Talk to someone in that field</span>
                    <span class="s s3">Learn one skill</span>
                    <span class="s s4 first">Message one person this week <em>Start here</em></span>
                </div>
            </div>
        </section>

        <!-- 4 -->
        <section class="opt">
            <p class="ol">4 · From 42 to 1</p>
            <div class="panel v4">
                <div class="stat">
                    <span class="lab">To-do</span>
                    <span class="n">42</span>
                </div>
                <svg class="arrow" viewBox="0 0 60 12" aria-hidden="true"><path d="M2 6h54m-6-5 6 5-6 5" /></svg>
                <div class="stat">
                    <span class="lab">Next step</span>
                    <span class="n dark">1</span>
                    <span class="one"><b />Message one person this week</span>
                </div>
            </div>
        </section>
    </main>
</Base>

<style>
    .wrap {
        max-width: 52rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 6rem;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }
    .head {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .h {
        font: 500 1.4rem/1.3 var(--serif);
        color: var(--ink);
    }
    .opt {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .ol {
        font: 400 14px/1.4 var(--sans);
        color: var(--label);
    }
    .panel {
        position: relative;
        overflow: hidden;
        aspect-ratio: 2;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: url("/images/smn/grid.png") center / cover;
        container-type: inline-size;
    }

    /* shared pieces */
    .chip {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.8cqw;
        padding: 0.8cqw 1.2cqw;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
        box-shadow: 0 0.3cqw 0.9cqw rgba(22, 21, 15, 0.06);
        font: 400 1.6cqw/1.2 var(--para);
        color: var(--ink);
        white-space: nowrap;
    }
    .chip b,
    .plan li b,
    .one b {
        flex: none;
        width: 1.3cqw;
        height: 1.3cqw;
        border-radius: 0.3cqw;
        box-shadow: inset 0 0 0 1.2px var(--ink);
    }
    .bubble {
        display: block;
        padding: 1.2cqw 1.6cqw;
        border-radius: 1.6cqw 1.6cqw 1.6cqw 0.3cqw;
        background: #fff;
        border: 1px solid var(--border);
        font: 400 1.7cqw/1.4 var(--para);
        color: var(--body);
    }
    .arrow,
    .down {
        fill: none;
        stroke: var(--ink);
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .plan {
        padding: 1.8cqw 2cqw;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
    }
    .goal {
        font: 500 2.2cqw/1.25 var(--serif);
        color: var(--ink);
        margin-bottom: 1.2cqw;
    }
    .plan ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1cqw;
    }
    .plan li {
        display: flex;
        align-items: center;
        gap: 1cqw;
        font: 400 1.6cqw/1.3 var(--para);
        color: var(--label);
    }
    .plan li.first {
        color: var(--ink);
    }
    em {
        margin-left: auto;
        padding: 0.4cqw 0.9cqw;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font: 500 1.2cqw/1 var(--sans);
        font-style: normal;
        white-space: nowrap;
    }

    /* 1 */
    .v1 {
        display: grid;
        grid-template-columns: 1fr 0.8fr 1.15fr;
        align-items: center;
        gap: 2cqw;
        padding: 0 3cqw;
    }
    .mini-heap {
        position: relative;
        height: 70%;
        align-self: center;
    }
    .mid {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.6cqw;
    }
    .mid .arrow {
        width: 6cqw;
    }

    /* 2 */
    .v2 {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.4cqw;
    }
    .v2 .bubble {
        max-width: 50cqw;
    }
    .v2 .down {
        width: 1.2cqw;
        height: 4cqw;
    }
    .v2 .plan {
        width: 50cqw;
    }

    /* 3 */
    .v3 {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1cqw;
    }
    .goal.big {
        font-size: 2.6cqw;
        margin-bottom: 1.4cqw;
    }
    .ladder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1cqw;
    }
    .s {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.2cqw;
        padding: 1.1cqw 1.6cqw;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
        font: 400 1.6cqw/1.2 var(--para);
        color: var(--label);
    }
    .s1 {
        width: 52cqw;
    }
    .s2 {
        width: 44cqw;
    }
    .s3 {
        width: 36cqw;
    }
    .s4 {
        width: 36cqw;
        color: var(--ink);
        border-color: var(--ink);
    }
    .s4 em {
        margin-left: 0;
    }

    /* 4 */
    .v4 {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6cqw;
    }
    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1cqw;
    }
    .lab {
        font: 400 1.7cqw/1 var(--sans);
        color: var(--label);
    }
    .n {
        font: 500 9cqw/1 var(--serif);
        color: var(--label);
    }
    .n.dark {
        color: var(--ink);
    }
    .v4 .arrow {
        width: 8cqw;
    }
    .one {
        display: flex;
        align-items: center;
        gap: 1cqw;
        padding: 0.9cqw 1.3cqw;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
        font: 400 1.6cqw/1.2 var(--para);
        color: var(--ink);
    }
    @media (max-width: 809.98px) {
        .panel {
            aspect-ratio: 1.3;
        }
        .v1 {
            grid-template-columns: 1fr;
            padding: 3cqw;
        }
        .mini-heap {
            display: none;
        }
    }
</style>
