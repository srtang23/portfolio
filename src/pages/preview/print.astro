---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"
import Nav from "../../components/Nav.astro"
import { links } from "../../data/projects"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Print feel" noindex nav="none">
    <script is:inline>
        const q = new URLSearchParams(location.search)
        document.documentElement.dataset.g = q.get("g") || "dots"
        document.documentElement.dataset.n = q.get("n") || "mast"
    </script>
    <div class="nv nv-pill"><Nav /></div>
    <header class="nv nv-mast">
        <a class="who" href="/">Sophia Tang</a>
        <nav class="links" aria-label="Main">
            <a href="#selected-work">Work</a><span>·</span><a href="/about">About</a><span>·</span><a href={links.resume} target="_blank" rel="noopener noreferrer">Resume ↗</a>
        </nav>
    </header>
    <header class="nv nv-tag">
        <a class="tg" href="/"><img src="/images/logo.png" alt="Home" width="30" height="24" /></a>
        <a class="tg" href="#selected-work">Work</a>
        <a class="tg" href="/about">About</a>
        <span class="sp"></span>
        <a class="tg" href={links.resume} target="_blank" rel="noopener noreferrer">Resume ↗</a>
    </header>
    <div class="edges" aria-hidden="true"></div>
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear>{headline.join(" ")}</h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <div class="caption">
                                            <h2 class="name">{p.descriptor}</h2>
                                            <p class="line">{p.blurb}</p>
                                        </div>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
    <div class="switch">
        <span>Paper</span>
        <a data-k="g" data-v="paper">Now</a><a data-k="g" data-v="dots">Dot grain</a><a data-k="g" data-v="edges">Dots + edges</a>
        <span>Nav</span>
        <a data-k="n" data-v="pill">Pills</a><a data-k="n" data-v="mast">Masthead</a><a data-k="n" data-v="rule">+ Rule</a><a data-k="n" data-v="caps">Small caps</a><a data-k="n" data-v="tag">Paper tags</a>
    </div>
</Base>

<style is:global>
    /* ---------- switcher ---------- */
    .switch{position:fixed;z-index:70;left:50%;bottom:1rem;transform:translateX(-50%);display:flex;align-items:center;gap:.2rem;padding:.25rem .5rem;border-radius:999px;background:rgba(17,17,17,.9);white-space:nowrap}
    .switch span{color:rgba(255,255,255,.45);font:500 .6875rem var(--sans);margin:0 .25rem 0 .5rem}
    .switch a{padding:.45rem .7rem;border-radius:999px;color:rgba(255,255,255,.75);font:500 .7rem/1 var(--sans);cursor:pointer}
    .switch a.on{background:#fff;color:#111}

    /* ---------- paper ---------- */
    html:not([data-g="paper"]) .paper::before{background-image:url("/images/preview/dot-grain.png");background-size:256px 256px;opacity:.55}
    .edges{position:fixed;inset:0;z-index:-1;pointer-events:none;display:none;background:url("/images/preview/stipple.png");background-size:256px 256px;
        -webkit-mask-image:radial-gradient(ellipse 75% 70% at 50% 50%,transparent 62%,#000 100%);mask-image:radial-gradient(ellipse 75% 70% at 50% 50%,transparent 62%,#000 100%);opacity:.5}
    html[data-g="edges"] .edges{display:block}

    /* ---------- navs ---------- */
    .nv{display:none}
    html[data-n="pill"] .nv-pill{display:block}
    html[data-n="mast"] .nv-mast,html[data-n="rule"] .nv-mast,html[data-n="caps"] .nv-mast{display:flex}
    html[data-n="tag"] .nv-tag{display:flex}
    .nv-mast,.nv-tag{position:fixed;z-index:50;top:0;left:0;right:0;align-items:center;justify-content:space-between;padding:1.375rem var(--gutter);background:linear-gradient(var(--paper) 55%,transparent)}
    .nv-mast .who{font:italic 400 1.375rem/1 var(--serif);letter-spacing:-.02em;color:var(--ink)}
    .nv-mast .links{display:flex;gap:.625rem;font:400 .8125rem/1 var(--sans);color:var(--body)}
    .nv-mast .links span{color:var(--border)}
    .nv-mast .links a:hover{color:var(--ink)}
    html[data-n="rule"] .nv-mast{background:var(--paper);padding-bottom:1rem}
    html[data-n="rule"] .nv-mast::after{content:"";position:absolute;left:var(--gutter);right:var(--gutter);bottom:0;border-bottom:1px solid var(--ink);opacity:.8}
    html[data-n="caps"] .nv-mast .links{font:500 .6875rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase}
    html[data-n="caps"] .nv-mast .who{font:400 .8125rem/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;font-style:normal}
    .nv-tag{gap:.5rem;justify-content:flex-start;background:none}
    .nv-tag .sp{flex:1}
    .nv-tag .tg{display:flex;align-items:center;height:2.25rem;padding:0 .875rem;background:var(--paper);font:400 .75rem/1 var(--sans);color:var(--body);
        box-shadow:1px 1px 0 rgba(17,17,17,.12),0 0 0 1px rgba(17,17,17,.08);
        -webkit-mask-image:url("/images/preview/stipple.png"),linear-gradient(#000,#000);-webkit-mask-size:64px 64px,calc(100% - 4px) calc(100% - 4px);-webkit-mask-position:0 0,center;-webkit-mask-repeat:repeat,no-repeat;
        mask-image:url("/images/preview/stipple.png"),linear-gradient(#000,#000);mask-size:64px 64px,calc(100% - 4px) calc(100% - 4px);mask-position:0 0,center;mask-repeat:repeat,no-repeat}
    .nv-tag .tg:nth-child(2){transform:rotate(-1deg)}.nv-tag .tg:nth-child(3){transform:rotate(.8deg)}.nv-tag .tg:last-child{transform:rotate(-.6deg)}
    .nv-tag .tg img{width:1.5rem;height:1.2rem}
    .nv-tag .tg:hover{color:var(--ink)}
    @media (max-width:809.98px){.switch{left:.5rem;right:.5rem;transform:none;overflow-x:auto}}
</style>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    .lede {
        max-width: 38rem;
        font: 400 1.0625rem/1.55 var(--sans);
        color: var(--body);
    }

    /* Entrance: the clouds gather over plain paper, then the words settle on top,
       and the nav arrives last */
    .headline {
        animation: enter-up 1.2s var(--spring) both 1s;
    }
    .lede {
        animation: enter-up 1.2s var(--spring) both 1.25s;
    }
    :global(.sky) {
        animation: enter-sky 2s ease both;
    }
    :global(.top-nav .pill) {
        animation: enter-fade 1s ease both 1.6s;
    }
    @keyframes enter-sky {
        from {
            opacity: 0;
            transform: scale(1.08);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    /* a descriptor, then a one-line summary */
    .caption {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.375rem;
    }
    .name {
        font: 400 1.25rem/1.3 var(--sans);
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .line {
        font: 400 0.9375rem/1.45 var(--sans);
        letter-spacing: 0.005em;
        color: var(--body);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .headline,
        .lede,
        :global(.sky),
        :global(.top-nav .pill) {
            animation: none;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 0.9375rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>

<script>
    const root = document.documentElement
    const mark = () => document.querySelectorAll<HTMLAnchorElement>(".switch a").forEach((a) => a.classList.toggle("on", root.dataset[a.dataset.k!] === a.dataset.v))
    document.querySelectorAll<HTMLAnchorElement>(".switch a").forEach((a) =>
        a.addEventListener("click", () => {
            root.dataset[a.dataset.k!] = a.dataset.v!
            const q = new URLSearchParams(location.search)
            q.set(a.dataset.k!, a.dataset.v!)
            history.replaceState(null, "", "?" + q)
            mark()
        }),
    )
    mark()
</script>
