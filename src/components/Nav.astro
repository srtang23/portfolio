---
import { links } from "../data/projects"

// Site nav: the logo, Work and About in a paper pill on the left, and a Resume pill on
// the right. Both pills float over the page with a light blur, so they sit well on
// paper, on the Home sky and on the case study heroes alike.
// `variant` is kept so pages can still pass one; "none" hides the nav.
interface Props {
    variant?: "default" | "case" | "sky" | "none"
}
---

<!-- The logo keeps its own colour, so it sits in its own layer above the blended text links. -->
<div class="logo-layer">
    <a class="logo" href="/" aria-label="Home"><img src="/images/logo.svg" alt="" width="30" height="24" /></a>
</div>
<nav class="top-nav" aria-label="Main">
    <div class="pill main">
        <span class="logo-space" aria-hidden="true"></span>
        <a class="link" href="/#selected-work">Work</a>
        <a class="link" href="/about">About</a>
    </div>
    <a class="pill cv" href={links.resume} target="_blank" rel="noopener noreferrer">
        Resume
        <span class="sr">(opens in a new tab)</span>
    </a>
</nav>

<style>
    /* Like kaachow.xyz: the nav stays put and its white text uses a difference blend, so it
       inverts against whatever scrolls underneath (dark over light, light over dark images). */
    .top-nav,
    .logo-layer {
        position: fixed;
        z-index: 50;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        /* lines up with the page edges (Home cards, case study side nav and text) */
        padding: 1.25rem var(--gutter);
        pointer-events: none;
        transition:
            transform 0.45s var(--spring),
            opacity 0.3s ease;
    }
    /* slides away while scrolling down, comes back on scroll up */
    .top-nav {
        mix-blend-mode: difference;
    }
    .logo-layer {
        z-index: 51;
        display: flex;
        align-items: center;
        padding: 1.25rem var(--gutter);
        pointer-events: none;
    }
    .logo-layer .logo {
        pointer-events: auto;
        display: flex;
        align-items: center;
        height: 2.75rem;
    }
    .logo-space {
        display: block;
        margin-right: 0.25rem;
        width: 1.875rem;
        height: 1.5rem;
    }
    /* plain text links, no pill */
    .pill {
        pointer-events: auto;
        display: flex;
        align-items: center;
        height: 2.75rem;
        font: 400 15px/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: #fff;
        transition: opacity 0.2s ease;
    }
    .main {
        gap: 1.75rem;
    }
    .link {
        color: #fff;
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }
    .link:hover {
        opacity: 1;
    }
    .logo {
        margin-right: 0.25rem;
    }
    .logo img {
        width: 1.875rem;
        height: 1.5rem;
        transition: transform 0.7s var(--spring);
    }
    .logo:hover img {
        transform: rotate(360deg);
    }

    .cv {
        opacity: 0.75;
    }
    .cv:hover {
        opacity: 1;
    }
    .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 809.98px) {
        .top-nav,
        .logo-layer {
            padding: 1rem var(--gutter);
        }
        .logo-layer .logo {
            height: 2.5rem;
        }
        .logo-space {
            width: 1.625rem;
            height: 1.3rem;
        }
        .pill {
            height: 2.5rem;
        }
        .main {
            gap: 1.25rem;
        }
        .logo img {
            width: 1.625rem;
            height: 1.3rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .top-nav {
            transition: opacity 0.2s ease;
        }
    }
</style>
