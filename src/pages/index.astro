---
import Base from "../layouts/Base.astro"
import { projects } from "../data/projects"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

---

<Base title="Sophia Tang · Product Designer">
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <p class="hello">Hello <img src="/images/avatar.jpg" alt="" width="32" height="32" /> <span>I’m <b>Sophia Tang</b></span></p>
            <h1 class="statement">
                I create experiences grounded in <b>research and systems thinking</b>, bringing curiosity to everyday interactions and a <b>strategic lens</b> to complex
                challenges.
            </h1>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <div class="caption">
                                            <h2 class="name">{p.descriptor}</h2>
                                            <p class="line">{p.blurb}</p>
                                        </div>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Base>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    /* shorter than the screen, so the first project cards peek in below */
    .hero {
        min-height: 79vh;
        min-height: 79svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 8rem var(--gutter) 2rem;
        text-align: center;
    }
    .hello {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font: 400 1.0625rem/1 var(--sans);
        color: var(--body);
    }
    .hello img {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        object-fit: cover;
    }
    .hello b {
        font-weight: 400;
    }
    /* light grey sentence, with the key phrases in a darker grey */
    .statement {
        max-width: 60rem;
        font: 400 2.375rem/1.2 var(--sans);
        letter-spacing: -0.035em;
        color: #a8a8a8;
        text-wrap: balance;
    }
    .statement b {
        font-weight: inherit;
        color: var(--ink);
    }

    /* Entrance: the Hello line fades in whole, then the statement builds phrase by phrase
       (each highlighted phrase as one piece), then the cards rise in. */
    :global(.ww) {
        opacity: 0;
        filter: blur(6px);
        animation: enter-word 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
        animation-delay: calc(0.15s + var(--i) * 140ms);
    }
    .hello:global(.ww) {
        display: flex;
    }
    .work .grid {
        animation: enter-up 1.1s var(--spring) both 1.6s;
    }
    :global(.top-nav .pill) {
        animation: enter-fade 0.8s ease both 0.1s;
    }
    @keyframes enter-word {
        to {
            opacity: 1;
            filter: blur(0);
        }
    }
    @keyframes enter-up {
        from {
            opacity: 0;
            transform: translateY(2.5rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    /* a descriptor, then a one-line summary */
    .caption {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.375rem;
    }
    .name {
        font: 400 1.0625rem/1.35 var(--sans);
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .line {
        font: 400 0.9375rem/1.45 var(--sans);
        letter-spacing: 0.005em;
        color: var(--body);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.ww),
        .work .grid,
        :global(.top-nav .pill) {
            animation: none;
            opacity: 1;
            filter: none;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .statement {
            font-size: 2.125rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            min-height: 73svh;
            padding: 7rem var(--gutter) 2rem;
            gap: 1.25rem;
        }
        .statement {
            font-size: 1.5rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0 },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>

<script>
    // Split the statement into short phrases for the entrance: grey text in groups of three
    // words, each highlighted phrase as one piece. The Hello line is a single piece.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let i = 0
        const piece = (el: HTMLElement) => {
            el.classList.add("ww")
            el.style.setProperty("--i", String(i++))
        }
        const hello = document.querySelector<HTMLElement>(".hello")
        const st = document.querySelector<HTMLElement>(".statement")
        if (hello) piece(hello)
        if (st) {
            for (const node of [...st.childNodes]) {
                if (node instanceof HTMLElement) piece(node)
                else if (node.nodeType === Node.TEXT_NODE) {
                    const text = node.textContent!.replace(/\s+/g, " ")
                    const words = text.trim().split(" ").filter(Boolean)
                    if (!words.length) continue
                    const frag = document.createDocumentFragment()
                    if (text.startsWith(" ")) frag.append(" ")
                    for (let k = 0; k < words.length; k += 3) {
                        if (k) frag.append(" ")
                        const s = document.createElement("span")
                        s.textContent = words.slice(k, k + 3).join(" ")
                        piece(s)
                        frag.append(s)
                    }
                    if (text.endsWith(" ")) frag.append(" ")
                    node.replaceWith(frag)
                }
            }
        }
    }
</script>
