---
import { links } from "../data/projects"

// Site nav: the logo, Work and About in a paper pill on the left, and a Resume pill on
// the right. Both pills float over the page with a light blur, so they sit well on
// paper, on the Home sky and on the case study heroes alike.
// `variant` is kept so pages can still pass one; "none" hides the nav.
interface Props {
    variant?: "default" | "case" | "sky" | "none"
}
---

<nav class="top-nav" aria-label="Main">
    <div class="pill main">
        <a class="logo" href="/" aria-label="Home"><img src="/images/logo.png" alt="" width="30" height="24" /></a>
        <a class="link" href="/#selected-work">Work</a>
        <a class="link" href="/about">About</a>
    </div>
    <a class="pill cv" href={links.resume} target="_blank" rel="noopener noreferrer">
        Resume <span class="arr" aria-hidden="true">↗</span>
        <span class="sr">(opens in a new tab)</span>
    </a>
</nav>

<style>
    .top-nav {
        position: fixed;
        z-index: 50;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        /* lines up with the page edges (Home cards, case study side nav and text) */
        padding: 1.25rem var(--gutter);
        pointer-events: none;
    }
    .pill {
        pointer-events: auto;
        display: flex;
        align-items: center;
        height: 2.75rem;
        border-radius: 999px;
        background: rgba(251, 250, 247, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: inset 0 0 0 1px var(--border);
        font: 400 0.75rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--nav);
        transition:
            color 0.2s ease,
            background-color 0.25s ease,
            box-shadow 0.25s ease;
    }
    .main {
        gap: 1.75rem;
        padding: 0 1.5rem 0 1.125rem;
    }
    .link {
        color: var(--nav);
        transition: color 0.2s ease;
    }
    .link:hover {
        color: var(--ink);
    }
    .logo {
        margin-right: 0.25rem;
    }
    .logo img {
        width: 1.875rem;
        height: 1.5rem;
        transition: transform 0.7s var(--spring);
    }
    .logo:hover img {
        transform: rotate(360deg);
    }
    .cv {
        padding: 0 1.375rem;
    }
    .arr {
        display: inline-block;
        margin-left: 0.25rem;
        transition: transform 0.4s var(--spring);
    }
    .cv:hover {
        background: var(--ink);
        color: var(--paper);
        box-shadow: inset 0 0 0 1px var(--ink);
    }
    .cv:hover .arr {
        transform: translate(0.125rem, -0.125rem);
    }
    .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 809.98px) {
        .top-nav {
            padding: 1rem var(--gutter);
        }
        .pill {
            height: 2.5rem;
        }
        .main {
            gap: 1.125rem;
            padding: 0 1.125rem 0 0.875rem;
        }
        .logo img {
            width: 1.625rem;
            height: 1.3rem;
        }
        .cv {
            padding: 0 1rem;
        }
    }
</style>
