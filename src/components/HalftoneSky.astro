---
// Paper-cut sky for the top of Home, drawn by a WebGL shader: a blue halftone sky with
// solid paper-coloured clouds (soft shading, thin white rim) drifting over it. Clouds
// thicken towards the bottom so the sky melts into the page's paper, and gather behind
// elements marked [data-sky-clear] so text always sits on paper.
// Still frame for reduced motion; plain paper if WebGL isn't available.
---

<div class="sky" aria-hidden="true">
    <canvas data-sky></canvas>
    <div class="grain"></div>
</div>

<style>
    .sky {
        position: absolute;
        z-index: -1;
        top: 0;
        left: 0;
        right: 0;
        height: var(--sky-h, 115vh);
        pointer-events: none;
        overflow: hidden;
    }
    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
    /* the site's paper texture over the whole scene, so the clouds read as paper */
    .grain {
        position: absolute;
        inset: 0;
        background: url("/images/paper-tile.png") repeat;
        background-size: 32rem 32rem;
        opacity: 0.3;
    }
</style>

<script>
    const MAX_RECTS = 24

    const VERT = `
attribute vec2 a;
void main() { gl_Position = vec4(a, 0.0, 1.0); }`

    const FRAG = `
#extension GL_OES_standard_derivatives : enable
precision highp float;
uniform vec2 uRes;      // CSS px
uniform float uDpr;
uniform float uTime;    // ms
uniform float uCell;    // halftone cell, CSS px
uniform vec4 uRects[${MAX_RECTS}];
uniform int uCount;

const float T = 0.5;    // cloud edge

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = hash(i), b = hash(i + vec2(1.0, 0.0)), c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p) {
    float s = 0.0, amp = 0.5, n = 0.0;
    for (int o = 0; o < 5; o++) { s += amp * noise(p); n += amp; p *= 2.07; amp *= 0.5; }
    return s / n;
}
float gather(vec2 p) {
    float m = 0.0;
    for (int k = 0; k < ${MAX_RECTS}; k++) {
        if (k >= uCount) break;
        vec4 r = uRects[k];
        vec2 d = max(max(r.xy - p, p - r.zw), 0.0);
        m = max(m, 1.0 - length(d) / 70.0);
    }
    m = clamp(m, 0.0, 1.0);
    return m * m * (3.0 - 2.0 * m);
}
float field(vec2 p) {
    vec2 q = p / 260.0;
    float n = fbm(vec2(q.x + uTime * 0.000016, q.y * 1.15 - uTime * 0.000004));
    float base = (n - 0.5) * 1.9 + 0.24;
    float bottom = smoothstep(0.55, 0.95, p.y / uRes.y) * 0.85;
    return base + bottom + gather(p) * 0.6;
}
float dotAt(vec2 p, float row) {
    float y = row * uCell;
    float off = mod(row, 2.0) * 0.5 * uCell;
    float i = floor((p.x - off) / uCell + 0.5);
    vec2 c = vec2(i * uCell + off, y);
    float light = 1.0 - c.y / uRes.y;
    float s = 0.55 * light + 0.45 * noise(c / 90.0 + vec2(uTime * 0.00003, 0.0));
    float r = uCell * (0.16 + 0.26 * s);
    float aa = 0.75 / uDpr;
    return 1.0 - smoothstep(r - aa, r + aa, length(p - c));
}
void main() {
    vec2 p = vec2(gl_FragCoord.x, uRes.y * uDpr - gl_FragCoord.y) / uDpr;

    // sky: light at the top, deeper blue lower down
    float k = clamp(p.y / uRes.y * 0.9 + p.x / uRes.x * 0.12, 0.0, 1.0);
    vec3 sky = k < 0.45 ? mix(vec3(0.62, 0.72, 0.86), vec3(0.36, 0.50, 0.73), k / 0.45)
                        : mix(vec3(0.36, 0.50, 0.73), vec3(0.24, 0.37, 0.60), (k - 0.45) / 0.55);
    float row = floor(p.y / uCell);
    float dots = max(dotAt(p, row), dotAt(p, row + 1.0));
    sky = mix(sky, vec3(0.86, 0.91, 0.98), dots * 0.9);

    // clouds
    float v = field(p);
    float w = max(fwidth(v), 1e-4);
    float cloud = smoothstep(T - w, T + w, v);
    // soft billows: light from the upper left, with smaller puffs of shade inside
    float lit = smoothstep(T + 0.03, T + 0.16, v + dFdx(v) * 6.0 + dFdy(v) * 8.0);
    float puff = fbm(p / 70.0 + vec2(uTime * 0.00002, 0.0));
    float shade = clamp(lit * 0.75 + (puff - 0.35) * 0.9, 0.0, 1.0);
    vec3 col = mix(vec3(0.80, 0.83, 0.87), vec3(0.984, 0.980, 0.969), shade);
    float rim = 1.0 - smoothstep(T + w * 1.6, T + w * 3.2, v);
    col = mix(col, vec3(1.0), rim * 0.95);

    gl_FragColor = vec4(mix(sky, col, cloud), 1.0);
}`

    const canvas = document.querySelector<HTMLCanvasElement>("[data-sky]")
    const gl = canvas?.getContext("webgl", { antialias: false, premultipliedAlpha: false })
    if (canvas && gl && gl.getExtension("OES_standard_derivatives")) {
        const sh = (type: number, src: string) => {
            const s = gl.createShader(type)!
            gl.shaderSource(s, src)
            gl.compileShader(s)
            return s
        }
        const prog = gl.createProgram()!
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT))
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG))
        gl.linkProgram(prog)
        if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
            gl.useProgram(prog)
            const buf = gl.createBuffer()
            gl.bindBuffer(gl.ARRAY_BUFFER, buf)
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW)
            const loc = gl.getAttribLocation(prog, "a")
            gl.enableVertexAttribArray(loc)
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)
            const U = (n: string) => gl.getUniformLocation(prog, n)
            const uRes = U("uRes"),
                uDpr = U("uDpr"),
                uTime = U("uTime"),
                uCell = U("uCell"),
                uRects = U("uRects"),
                uCount = U("uCount")
            const rects = new Float32Array(MAX_RECTS * 4)

            let W = 0,
                H = 0,
                dpr = 1
            const resize = () => {
                dpr = Math.min(window.devicePixelRatio || 1, 1.5)
                W = canvas.clientWidth
                H = canvas.clientHeight
                canvas.width = Math.round(W * dpr)
                canvas.height = Math.round(H * dpr)
                gl.viewport(0, 0, canvas.width, canvas.height)
            }
            // Text the clouds gather behind: one box per rendered line, relative to the canvas.
            const range = document.createRange()
            const measure = () => {
                const top = canvas.getBoundingClientRect().top
                let n = 0
                for (const el of document.querySelectorAll<HTMLElement>("[data-sky-clear]")) {
                    range.selectNodeContents(el)
                    for (const r of range.getClientRects()) {
                        if (r.width <= 0 || n >= MAX_RECTS) continue
                        rects.set([r.left, r.top - top, r.right, r.bottom - top], n * 4)
                        n++
                    }
                }
                return n
            }
            const draw = (t: number) => {
                const n = measure()
                const rem = parseFloat(getComputedStyle(document.documentElement).fontSize)
                gl.uniform2f(uRes, W, H)
                gl.uniform1f(uDpr, dpr)
                gl.uniform1f(uTime, t)
                gl.uniform1f(uCell, Math.max(6, rem * 0.5))
                gl.uniform4fv(uRects, rects)
                gl.uniform1i(uCount, n)
                gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4)
            }

            resize()
            const still = matchMedia("(prefers-reduced-motion: reduce)").matches
            const start = performance.now() - 60000
            const now = () => (still ? 60000 : performance.now() - start)
            let visible = true
            new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas)
            if (still) draw(now())
            else {
                let last = 0
                const loop = (ts: number) => {
                    if (visible && ts - last > 33) {
                        last = ts
                        draw(now())
                    }
                    requestAnimationFrame(loop)
                }
                requestAnimationFrame(loop)
            }
            addEventListener("resize", () => {
                resize()
                draw(now())
            })
            document.fonts?.ready.then(() => draw(now()))
        }
    }
</script>
