---
// How Spilt Milk Nannies works: families on one side, vetted nannies on the other, and the two
// ways a booking happens between them through the platform. Line-art bottles stand in for each
// side; only their caps keep the brand colours.
const bottle = "M15 9 H25 V15 L30.5 24 V64 Q30.5 69 26 69 H14 Q9.5 69 9.5 64 V24 L15 15 Z"
const sides = {
    family: { cap: "#2f6f80", level: 30, h: "Families", p: "Need flexible, occasional childcare" },
    nanny: { cap: "#e8c766", level: 30, h: "Nannies", p: "Vetted local caregivers looking for work" },
}
---

<div class="how" role="img" aria-label="How Spilt Milk Nannies works. Families and vetted nannies meet through the platform in two ways: nannies post their availability and families book a time, or families post an open request and a nanny accepts it. Either way, the booking is confirmed for both.">
    {
        (["family", "nanny"] as const).map((k, i) => (
            <div class:list={["side", k]} aria-hidden="true">
                <svg class="bottle" viewBox="0 0 40 72">
                    <defs>
                        <clipPath id={`hw-clip-${i}`}>
                            <path d={bottle} />
                        </clipPath>
                    </defs>
                    <rect class="air" x="0" y="0" width="40" height="72" clip-path={`url(#hw-clip-${i})`} />
                    <rect class="milk" x="0" y={sides[k].level} width="40" height={72 - sides[k].level} clip-path={`url(#hw-clip-${i})`} />
                    <path class="glass" d={bottle} />
                    <rect x="14" y="3.5" width="12" height="5" rx="1.6" fill={sides[k].cap} />
                </svg>
                <p class="sh">{sides[k].h}</p>
                <p class="sp">{sides[k].p}</p>
            </div>
        ))
    }

    <div class="routes" aria-hidden="true">
        <p class="platform">Spilt Milk Nannies</p>
        <div class="route">
            <p class="rl"><span class="n">1</span> Nannies post availability</p>
            <svg class="arrow" viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M196 6 H4 M10 1 4 6 10 11"></path></svg>
            <p class="rs">Families book a time</p>
        </div>
        <div class="route">
            <p class="rl"><span class="n">2</span> Families post an open request</p>
            <svg class="arrow" viewBox="0 0 200 12" preserveAspectRatio="none"><path d="M4 6 H196 M190 1 196 6 190 11"></path></svg>
            <p class="rs">A nanny accepts it</p>
        </div>
        <p class="booked">Either way, the booking is confirmed for both</p>
    </div>
</div>

<style>
    .how {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 9rem 1fr 9rem;
        grid-template-areas: "family routes nanny";
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 2rem 1.75rem;
    }
    .side {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    .side.family {
        grid-area: family;
    }
    .side.nanny {
        grid-area: nanny;
    }
    .bottle {
        width: 1.75rem;
        height: auto;
        margin-bottom: 0.875rem;
    }
    .glass {
        fill: none;
        stroke: #3a3a3a;
        stroke-width: 1.1;
        stroke-linejoin: round;
    }
    .air {
        fill: #ececec;
    }
    .milk {
        fill: #fff;
    }
    .sh {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .sp {
        margin-top: 0.25rem;
        font: 400 13px/1.45 var(--para);
        color: var(--label);
        text-wrap: balance;
    }
    .routes {
        grid-area: routes;
        display: flex;
        flex-direction: column;
        gap: 1.125rem;
        text-align: center;
    }
    .platform {
        align-self: center;
        padding: 0.3125rem 0.875rem;
        border: 1px solid #d5d5d5;
        border-radius: 999px;
        background: #fff;
        font: 500 13px/1.2 var(--sans);
        color: var(--ink);
    }
    .route {
        display: flex;
        flex-direction: column;
        gap: 0.3125rem;
    }
    .rl {
        font: 400 14px/1.35 var(--para);
        color: var(--ink);
    }
    .rs {
        font: 400 13px/1.35 var(--para);
        color: var(--label);
    }
    .n {
        display: inline-grid;
        place-items: center;
        width: 1.125rem;
        height: 1.125rem;
        margin-right: 0.25rem;
        border-radius: 50%;
        background: #3a3a3a;
        color: #fff;
        font: 500 11px/1 var(--sans);
        vertical-align: 1px;
    }
    .arrow {
        width: 100%;
        height: 0.75rem;
    }
    .arrow path {
        fill: none;
        stroke: #3a3a3a;
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }
    .booked {
        font: 400 13px/1.3 var(--para);
        color: var(--label);
    }
    @media (max-width: 809.98px) {
        .how {
            grid-template-columns: 1fr 1fr;
            grid-template-areas:
                "family nanny"
                "routes routes";
            padding: 1.5rem 1.25rem;
        }
    }
</style>
