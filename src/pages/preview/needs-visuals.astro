---
// Unlisted: the #my-role section rethought in rachelchen.tech's structure. Each beat gets a
// small label, a question or statement headline, one sentence, then one simple visual:
// 1) three principle-style cards for the core flows, 2) a single statement panel for the
//    calendar insight, 3) a spectrum ("scale of change") with the two decisions placed on it.
import Base from "../../layouts/Base.astro"

const ic = {
    cal: `<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4"/>`,
    search: `<circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/>`,
    clip: `<rect x="5.5" y="5" width="13" height="15.5" rx="2"/><path d="M9.5 3.5h5v3h-5zM9 13.3l2 2 4-4"/>`,
}
const piles = [
    {
        name: ["Posting", "availability"],
        count: 27,
        at: [24, 24],
        label: "below",
        notes: ["Can’t cross midnight", "One block per day on mobile", "Desktop delete is hidden", "Repeat option is buried", "Presets can’t be saved", "Defaults don’t match my schedule", "Wants to type times", "Two-hour minimum blocks edits", "Cancelled slots aren’t restored", "Every edit sends an email", "Must post 2 months ahead", "Did my update save?"],
    },
    {
        name: ["Finding or", "receiving bookings"],
        count: 34,
        at: [74, 27],
        label: "belowr",
        notes: ["Open shifts by email only", "First come, first served", "Checks the app all day", "No approve or decline", "Uses soft blocking", "Feels a lack of control", "Wants to star families", "Regulars go through Erin", "Can’t self-schedule regulars", "No family search", "Texts miss details", "“New to you” is wrong"],
    },
    {
        name: ["Preparing for", "appointments"],
        count: 37,
        at: [46, 63],
        label: "right",
        notes: ["Family’s note disappears", "Re-enters bookings in my calendar", "Cross-checks Apple Calendar", "Confirms allergies first", "Checks the address in Maps", "No notes for the next nanny", "Kids’ interests missing", "Reads parking instructions", "No way to flag a concern", "Texts to cancel last minute", "No policy search", "Questions come up on the job"],
    },
]
const flows = [
    { chip: "Post availability", c: "#2f6f80", i: ic.cal, p: "Posting availability that reflects when nannies can actually work." },
    { chip: "Find bookings", c: "#d9a93a", i: ic.search, p: "Finding or receiving bookings that fit." },
    { chip: "Prepare", c: "#d9706b", i: ic.clip, p: "Preparing for confirmed appointments." },
]
---

<Base nav="none" noindex title="Preview · My role, rethought">
    <main class="wrap">
        <!-- 1. the mapping -->
        <section class="beat">
            <p class="lab">Core flows</p>
            <h2 class="h">What were nannies actually trying to do?</h2>
            <p class="body">I led the team in mapping each interview pain point to what the nanny was trying to do at that moment. Three core flows emerged.</p>
            <div class="panel board" aria-label="Interview pain points grouped into three core flows: posting availability, finding or receiving bookings, and preparing for appointments.">
                {
                    piles.map((p) => (
                        <>
                            {Array.from({ length: p.count }, (_, i) => {
                                // sunflower spiral: an even, organic round cluster; small seeded jitter and tilt
                                const rnd = (k: number) => {
                                    const v = Math.sin((i + 1) * 12.9898 + k * 78.233 + p.count) * 43758.5453
                                    return v - Math.floor(v)
                                }
                                const R = Math.sqrt(p.count) * 2.65
                                const r = R * Math.sqrt((i + 0.5) / p.count)
                                const a = i * 2.39996
                                const x = p.at[0] + r * Math.cos(a) * 1.25 + (rnd(1) - 0.5) * 1.2 - 3
                                const y = p.at[1] + r * Math.sin(a) + (rnd(2) - 0.5) * 1.2 - 3
                                const tilt = (rnd(3) - 0.5) * 9
                                return (
                                    <span
                                        class:list={["st", { alt: rnd(4) > 0.6 }]}
                                        style={`left:${x.toFixed(2)}cqw;top:${y.toFixed(2)}cqw;transform:rotate(${tilt.toFixed(1)}deg);z-index:${Math.round(rnd(5) * 50)}`}
                                        aria-hidden="true"
                                    >
                                        {p.notes[i % p.notes.length]}
                                    </span>
                                )
                            })}
                            <p class:list={["pl", p.label]} style={`--x:${p.at[0]}cqw;--y:${p.at[1]}cqw`} aria-hidden="true">
                                {p.name[0]}
                                <br />
                                {p.name[1]}
                            </p>
                        </>
                    ))
                }
            </div>
        </section>

        <!-- 2. the insight -->
        <section class="beat">
            <p class="lab">The bigger problem</p>
            <h2 class="h">A confirmed booking was only part of the job.</h2>
            <p class="body">The calendar workaround made it tangible. Even with a booking confirmed, nannies still had to piece together the details they needed to plan for it.</p>
            <div class="panel statement">
                <p class="mono">The workaround</p>
                <p class="big">4 of 4 nannies re-entered every booking into their own calendar.</p>
                <p class="small">One also copied the family’s note before accepting, because it disappeared afterward.</p>
            </div>
        </section>

        <!-- 3. the prioritising -->
        <section class="beat">
            <p class="lab">Prioritizing</p>
            <h2 class="h">What could we change from the nanny side?</h2>
            <p class="body">I guided the team in prioritizing issues by how much they disrupted those flows and what we could feasibly change.</p>
            <div class="panel scale">
                <p class="mono center">Scale of change</p>
                <div class="track">
                    <div class="end">
                        <span class="sq dark"><svg viewBox="0 0 24 24"><path d="m6 12.5 4 4 8-9" /></svg></span>
                        <p class="en">Nanny side</p>
                        <span class="tag">We can change</span>
                    </div>
                    <span class="line"></span>
                    <div class="end">
                        <span class="sq light"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7 7 17" /></svg></span>
                        <p class="en">Family side</p>
                        <span class="tag muted">Out of scope</span>
                    </div>
                </div>
                <div class="ex">
                    <div class="exc">
                        <p class="ek">Addressed</p>
                        <p>Keep the family’s note after accepting</p>
                    </div>
                    <div class="exc muted">
                        <p class="ek">Deferred</p>
                        <p>An approve-or-decline step, since it would change how families book</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Base>

<style>
    .wrap {
        max-width: 50rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 6rem;
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }
    .beat {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .lab {
        font: 400 14px/1.3 var(--sans);
        color: var(--label);
    }
    .h {
        font: 500 1.4rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .beat > .body {
        margin-bottom: 0.5rem;
    }
    .panel {
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .mono {
        font: 400 11px/1.2 ui-monospace, "SF Mono", Menlo, monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8a8a8a;
    }
    .center {
        text-align: center;
    }

    /* 1: principle cards */
    .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }
    /* cards in the portfolio style: grid panel, neutral greys, outlined icon */
    .art {
        position: relative;
        aspect-ratio: 1.5;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .chip {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        padding: 0.3125rem 0.625rem;
        font: 400 12px/1 var(--sans);
        color: var(--ink);
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 999px;
    }
    .ico {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 1.2px #3a3a3a;
    }
    .ico svg {
        width: 1.375rem;
        height: 1.375rem;
        fill: none;
        stroke: #3a3a3a;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .cp {
        font: 400 13px/1.45 var(--para);
        color: var(--label);
    }

    /* 1: affinity board, piles of yellow stickies per core flow on the grid panel */
    .board {
        position: relative;
        container-type: inline-size;
        height: 0;
        padding-bottom: 84%;
        overflow: hidden;
    }
    .bt {
        position: absolute;
        left: 2.5cqw;
        top: 2.5cqw;
    }
    .st {
        position: absolute;
        overflow: hidden;
        font: 400 0.5cqw/1.35 var(--sans);
        color: rgba(58, 58, 58, 0.42);
        width: 6cqw;
        height: 6cqw;
        padding: 0.75cqw;
        background: #ffe299;
        border-radius: 0.15cqw;
        box-shadow:
            0 0.05cqw 0.1cqw rgba(0, 0, 0, 0.08),
            0 0.3cqw 0.8cqw rgba(120, 90, 20, 0.12);
    }
    .st.alt {
        background: #ffdb85;
    }
    /* real note text, kept tiny and faint so it reads as writing rather than something to read */
    .pl {
        position: absolute;
        font: 400 2.2cqw/1.15 var(--sans);
        color: #a3a3a3;
        white-space: nowrap;
    }
    .pl {
        z-index: 60;
    }
    .pl.below {
        left: calc(var(--x) - 20cqw);
        top: calc(var(--y) + 15cqw);
    }
    .pl.belowr {
        left: calc(var(--x) + 22cqw);
        top: calc(var(--y) + 16cqw);
        transform: translateX(-100%);
        text-align: right;
    }
    .pl.right {
        left: calc(var(--x) + 23cqw);
        top: calc(var(--y) + 9cqw);
    }
    /* 2: statement */
    .statement {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        padding: 3rem 2rem;
        text-align: center;
    }
    .big {
        max-width: 28rem;
        font: 400 1.25rem/1.35 var(--sans);
        color: var(--ink);
        text-wrap: balance;
    }
    .small {
        max-width: 26rem;
        font: 400 13px/1.45 var(--para);
        color: var(--label);
    }

    /* 3: scale of change */
    .scale {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.75rem 2rem 2rem;
    }
    .track {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 0;
    }
    .end {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: 9rem;
    }
    .line {
        flex: 1;
        max-width: 14rem;
        margin-top: 1.75rem;
        border-top: 1.5px solid #3a3a3a;
    }
    .sq {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 50%;
        background: var(--c);
    }
    .sq svg {
        width: 1.375rem;
        height: 1.375rem;
        fill: none;
        stroke: #fff;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .sq.dark {
        --c: #3a3a3a;
    }
    .sq.light {
        --c: #c9c9c9;
    }
    .en {
        font: 500 14px/1.2 var(--sans);
        color: var(--ink);
    }
    .tag {
        padding: 0.25rem 0.5rem;
        font: 400 11px/1 ui-monospace, "SF Mono", Menlo, monospace;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: #e8f0c8;
        color: #3a3a3a;
    }
    .tag.muted {
        background: #ececec;
        color: #8a8a8a;
    }
    .ex {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        max-width: 32rem;
        margin: 0 auto;
        width: 100%;
    }
    .exc {
        padding: 0.875rem 1rem;
        background: #fff;
        border: 1px solid #3a3a3a;
        font: 400 13px/1.4 var(--para);
        color: var(--ink);
    }
    .exc.muted {
        background: rgba(255, 255, 255, 0.55);
        border: 1px dashed #c3c3c3;
        color: var(--label);
    }
    .ek {
        margin-bottom: 0.25rem;
        font: 400 11px/1 ui-monospace, "SF Mono", Menlo, monospace;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #8a8a8a;
    }
    @media (max-width: 809.98px) {
        .cards,
        .ex {
            grid-template-columns: 1fr;
        }
    }
</style>
