---
// Three columns (what nannies asked for → the underlying need → user goal) that step
// across as you scroll. The table pins while it plays, then releases. Two columns show
// at a time on wider screens, one on phones.
interface Row {
    want: string
    wantNote?: string
    need: string
    needNote?: string
    job: string
}
interface Props {
    rows: Row[]
    labels: [string, string, string]
}
const { rows, labels } = Astro.props
const cols = [
    rows.map((r) => ({ t: r.want, d: r.wantNote })),
    rows.map((r) => ({ t: r.need, d: r.needNote })),
    rows.map((r) => ({ t: "", d: r.job })),
]
---

<div class="needs" data-needs>
    <div class="pin">
        <div class="track">
            {
                labels.map((l, ci) => (
                    <div class:list={["lab", { accent: ci === 2 }]} data-col={ci} style={`grid-column:${ci + 1};grid-row:1`}>
                        {l}
                    </div>
                ))
            }
            {
                cols.map((cells, ci) =>
                    cells.map((c, ri) => (
                        <div class={`cell c${ci}`} data-col={ci} data-row={ri} style={`grid-column:${ci + 1};grid-row:${ri + 2}`}>
                            {c.t && <div class="t">{c.t}</div>}
                            {c.d && <div class="d">{c.d}</div>}
                        </div>
                    )),
                )
            }
        </div>
    </div>
</div>

<style>
    .needs {
        position: relative;
        width: 100%;
        padding-top: 2.5rem;
    }
    .pin {
        position: sticky;
        top: 22vh;
        width: 100%;
        overflow: hidden;
    }
    .track {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: 2.5rem;
        row-gap: 2.25rem;
        will-change: transform;
    }
    .lab {
        font: 400 0.8125rem/1.4 var(--sans);
        color: var(--label);
        margin-bottom: -0.875rem;
    }
    .lab.accent {
        color: var(--accent);
    }
    .cell {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .t {
        font: 500 0.9375rem/1.3 var(--sans);
        color: var(--ink);
    }
    .c1 .t {
        font: 500 1.3125rem/1.3 var(--serif);
        letter-spacing: -0.01em;
    }
    .d {
        font: 400 0.875rem/1.6 var(--sans);
        color: var(--body);
    }
    @media (max-width: 809.98px) {
        .track {
            row-gap: 1.75rem;
        }
        .lab {
            margin-bottom: -0.625rem;
        }
    }
</style>

<script>
    const SCROLL_VH = 200
    const PIN_TOP_VH = 22
    const seg = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)))
    const ease = (t: number) => t * t * (3 - 2 * t)

    for (const root of document.querySelectorAll<HTMLElement>("[data-needs]")) {
        const pin = root.querySelector<HTMLElement>(".pin")!
        const track = root.querySelector<HTMLElement>(".track")!
        const labs = [...root.querySelectorAll<HTMLElement>(".lab")]
        const cells = [...root.querySelectorAll<HTMLElement>(".cell")]
        let frame = 0

        const layout = () => {
            const k = parseFloat(getComputedStyle(document.documentElement).fontSize) / 16
            const w = root.offsetWidth
            const narrow = w < 560 * k
            const gap = narrow ? 0 : 40 * k
            const colW = narrow ? w : (w - gap) / 2
            track.style.gridTemplateColumns = `repeat(3, ${colW}px)`
            track.style.columnGap = `${gap}px`
            track.style.width = `${3 * colW + 2 * gap}px`
            root.style.height = `calc(${pin.offsetHeight}px + 2.5rem + ${SCROLL_VH}vh)`
            return { narrow, step: colW + gap }
        }
        let dims = layout()

        const update = () => {
            frame = 0
            const r = root.getBoundingClientRect()
            const run = r.height - pin.offsetHeight
            const top = (innerHeight * PIN_TOP_VH) / 100
            const p = run > 0 ? Math.min(1, Math.max(0, (top - r.top) / run)) : 0

            let shift: number, op: number[]
            if (dims.narrow) {
                shift = ease(seg(p, 0.32, 0.52)) + ease(seg(p, 0.66, 0.86))
                op = [0, 1, 2].map((i) => Math.max(0, 1 - Math.abs(shift - i) * 1.6))
            } else {
                const revealB = ease(seg(p, 0.3, 0.48))
                const s = ease(seg(p, 0.6, 0.84))
                shift = s
                op = [(1 - 0.65 * revealB) * Math.max(0, 1 - s * 3), revealB, Math.max(0, (s - 0.45) / 0.55)]
            }
            // Rows of the first column come in one at a time before anything else moves.
            const rowIn = (ri: number) => ease(seg(p, 0.04 + ri * 0.07, 0.12 + ri * 0.07))

            track.style.transform = `translate3d(${-shift * dims.step}px,0,0)`
            labs.forEach((l) => (l.style.opacity = String(op[Number(l.dataset.col)])))
            cells.forEach((c) => {
                const ci = Number(c.dataset.col)
                const o = ci === 0 ? op[0] * rowIn(Number(c.dataset.row)) : op[ci]
                c.style.opacity = String(o)
                c.style.transform = `translate3d(0, ${(1 - Math.min(1, o * 1.5)) * 10}px, 0)`
            })
        }
        const on = () => {
            if (!frame) frame = requestAnimationFrame(update)
        }
        const onResize = () => {
            dims = layout()
            on()
        }
        update()
        addEventListener("scroll", on, { passive: true })
        addEventListener("resize", onResize)
        new ResizeObserver(onResize).observe(pin)
    }
</script>
