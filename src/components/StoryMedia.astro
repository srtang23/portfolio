---
// Sticky screen that swaps to the looping recording for whichever [data-step] is in the
// middle of the screen. Used beside a list of solution steps (like the SMN story phone,
// but for recordings that already include their own device frame).
interface Item {
    mp4: string
    webm?: string
    poster?: string
    label: string
}
interface Props {
    items: Item[]
    width?: string // CSS width of the media card
    ratio?: string // aspect ratio of the recordings
    bg?: string // card colour, matched to the recordings' background
}
const { items, width = "15.75rem", ratio = "480 / 940", bg = "#fdfdfd" } = Astro.props
---

<div class="story-media" data-story-media style={`--w:${width};--ratio:${ratio};--bg:${bg}`}>
    {
        items.map((it, i) => (
            <video class:list={[{ on: i === 0 }]} poster={it.poster} muted loop playsinline preload={i === 0 ? "auto" : "metadata"} aria-label={it.label}>
                {it.webm && <source src={it.webm} type="video/webm" />}
                <source src={it.mp4} type="video/mp4" />
            </video>
        ))
    }
</div>

<style>
    .story-media {
        position: relative;
        width: var(--w);
        aspect-ratio: var(--ratio);
        border-radius: 1.25rem;
        overflow: hidden;
        background: var(--bg);
        box-shadow: inset 0 0 0 1px var(--border);
    }
    video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    video.on {
        opacity: 1;
    }
    @media (max-width: 1199.98px) {
        .story-media {
            width: calc(var(--w) * 0.84);
        }
    }
    @media (max-width: 809.98px) {
        .story-media {
            width: calc(var(--w) * 0.53);
            border-radius: 0.75rem;
        }
    }
</style>

<script>
    for (const root of document.querySelectorAll<HTMLElement>("[data-story-media]")) {
        const videos = [...root.querySelectorAll("video")]
        const steps = [...(root.closest("section")?.querySelectorAll<HTMLElement>("[data-step]") ?? [])]
        let active = 0
        let visible = false
        const sync = () =>
            videos.forEach((v, i) => {
                v.classList.toggle("on", i === active)
                if (i === active && visible) v.play().catch(() => {})
                else v.pause()
            })
        new IntersectionObserver(
            ([e]) => {
                visible = e.isIntersecting
                sync()
            },
            { threshold: 0.3 },
        ).observe(root)
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries)
                    if (e.isIntersecting) {
                        const i = Number((e.target as HTMLElement).dataset.step)
                        if (i !== active) {
                            active = i
                            videos[i].currentTime = 0
                            sync()
                        }
                    }
            },
            { rootMargin: "-50% 0px -50% 0px" },
        )
        steps.forEach((s) => io.observe(s))
    }
</script>
