---
import Base from "../../layouts/Base.astro"
import "../../styles/case-mobile.css"
import "../../styles/case-enter.css"
import CaseNav from "../../components/CaseNav.astro"
import StoryPhone from "../../components/smn/StoryPhone.astro"
import NeedsShift from "../../components/smn/NeedsShift.astro"
import Journey from "../../components/smn/Journey.astro"

const sections = [
    { id: "overview", label: "Overview" },
    { id: "outcomes", label: "Outcomes" },
    { id: "problem", label: "Problem" },
    { id: "opportunity", label: "Opportunity" },
    { id: "solution", label: "Solution" },
    { id: "research", label: "Research" },
    { id: "process", label: "Pivot" },
    { id: "needs", label: "What nannies need" },
    { id: "results", label: "Results" },
    { id: "reflection", label: "Reflection" },
]

const info = [
    { h: "My Role", items: ["Design Research Lead", "Concept Development", "Design Strategy"] },
    { h: "Team", items: ["4 Designers"] },
    { h: "Timeline", items: ["Mar – June 2026", "(11 weeks)"] },
    { h: "Skills", items: ["User Research", "Prototyping"] },
]

const outcomes = [
    { value: "10 → 6", text: "steps to set availability, a 40% reduction" },
    { value: "50%", text: "less time to set recurring availability" },
]

const steps = [
    {
        h: "A Central Starting Point for Everyone",
        p: "We brought key information and actions into one place, helping nannies move more seamlessly between managing availability, finding shifts, and taking on work.",
    },
    {
        h: "Making Time Easier to Manage",
        p: "We simplified the availability management process by reducing unnecessary steps and making schedule updates more intuitive, allowing nannies to easily adjust their availability and stay open to new shift opportunities with less effort.",
    },
    {
        h: "A Clearer View of What’s Ahead",
        p: "We transformed the mobile schedule into an easy-to-scan experience, helping nannies see their commitments and identify opportunities at a glance.",
    },
    {
        h: "Closing the Loop After Every Shift",
        p: "We introduced a post-session flow to reduce friction in documenting session notes and sharing feedback, helping nannies complete essential tasks more seamlessly.",
    },
]

const insights = [
    { img: "insight-1.png", h: "Availability ≠ Autonomy", p: "Being free doesn’t mean every job fits their life." },
    { img: "insight-2.png", h: "Confirmation ≠ Preparation", p: "A confirmed shift still leaves nannies unsure what to expect." },
    { img: "insight-3.png", h: "Digital Booking, Manual Coordination", p: "A last-minute cancel means texting the family, then emailing the coordinator." },
    { img: "insight-4.png", h: "Trust Grows Through Shared Knowledge", p: "Tips travel through group chats, and concerns through phone calls to coordinators." },
]

const needs = [
    {
        want: "A nanny community",
        wantNote: "Somewhere to connect and swap stories with other nannies.",
        need: "Shared knowledge about families",
        job: "I want a sustainable way to share and learn context about a family that complements their profile.",
    },
    {
        want: "More control over bookings",
        wantNote: "To choose which families book them, and when.",
        need: "Jobs that fit my life",
        job: "I want to take on jobs that align with my preferences, needs, and personal circumstances.",
    },
    {
        want: "Direct booking coordination",
        wantNote: "To arrange, change or cancel bookings with families directly, instead of going through a coordinator.",
        need: "Greater control and flexibility",
        job: "I want to manage booking changes efficiently, with minimal back-and-forth.",
    },
]

const quotes = [
    {
        who: "Nanny, usability testing",
        initials: "N",
        text: "I really love how this turned out! Everything feels so much more intuitive and easier to navigate. I really appreciate the post-session notes. It’s nice to finally have a place to share how a session went and leave helpful tips for other nannies.",
    },
    {
        who: "Spilt Milk Nannies stakeholder",
        initials: "SM",
        text: "This is so great! This part in the motivation section makes me reconsider a community group or board for nannies to share things.",
    },
]

const reflections = [
    {
        h: "Look beyond the interface",
        p: "What began as a platform redesign became a study of how nannies, families and coordinators work together across the whole service. A service design lens taught me to design for the relationships and processes around a product, not just its screens.",
    },
    {
        h: "Find focus in complexity",
        p: "Research surfaced more opportunities than we could pursue. Leading prioritization taught me to separate interesting findings from essential needs, and to turn a broad challenge into focused directions.",
    },
    {
        h: "Design within constraints",
        p: "Nannies wanted more control over bookings, but changing the booking model was out of scope. I learned to balance their needs with the client’s goals and improve the experience within what we could realistically change.",
    },
]

const img = (f: string) => `/images/smn/${f}`
---

<Base nav="case" noindex title="Preview · Spilt Milk Nannies, story first">
    <CaseNav sections={sections} />

    <main class="case">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>Streamlining the Digital Caregiver Workflow</h1>
            </div>
            <div class="hero-window">
                <img
                    class="hero-phones"
                    data-parallax
                    src={img("hero-phones.png")}
                    alt="Spilt Milk Nannies app screens"
                    width="3914"
                    height="1714"
                    fetchpriority="high"
                />
            </div>
        </header>

        <div class="content first">
            <!-- Project info -->
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview: what we did and why it mattered, my role -->
            <section id="overview" class="sec">
                <p class="tag">#overview</p>
                <h2 class="h">Redesigning the overlooked half of Spilt Milk Nannies: the nannies who do the work.</h2>
                <p class="body">
                    Spilt Milk Nannies connects families with nannies for flexible childcare, but the platform had long been built around the families who book. As a team of 4
                    designers over 11 weeks, we redesigned the nanny side: managing availability, finding shifts and taking on work.
                </p>
                <p class="body"><span class="role-label">My role</span> I led research and design strategy, guiding the team from scattered feature requests to the Jobs to Be Done that shaped our direction.</p>
                <!-- Showcase day -->
                <div class="panel showcase">
                    <p class="sc-h">HCDE Capstone Showcase Day!</p>
                    <div class="sc-row">
                        <figure class="sc sc-wide">
                            <img src={img("showcase-booth-2.jpg")} loading="lazy" alt="Sophia and three teammates at their Spilt Milk Nannies booth, with the project poster and live demos on screens." />
                            <figcaption>Presenting our work to students, faculty, and industry professionals.</figcaption>
                        </figure>
                        <figure class="sc">
                            <img src={img("showcase-team.jpg")} loading="lazy" alt="The four designers standing with their sponsor from Spilt Milk Nannies." />
                            <figcaption>Our team with the project sponsor!</figcaption>
                        </figure>
                    </div>
                </div>
            </section>

            <!-- Outcomes -->
            <section id="outcomes" class="sec">
                <p class="tag">#outcomes</p>
                <div class="outcomes reveal">
                    <div class="outs-row">
                        {
                            outcomes.map((o) => (
                                <div class="out">
                                    <p class="ov">{o.value}</p>
                                    <p class="ot">{o.text}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- Problem -->
            <section id="problem" class="sec">
                <p class="tag">#problem</p>
                <h2 class="h">Nannies were managing much of their work off the platform…</h2>
                <p class="body">
                    The platform handled bookings, but preparing for sessions, handling changes and following up happened over texts and calls. That’s a problem for Spilt Milk
                    Nannies, who wanted nannies more engaged and staying longer, but it’s also a problem for nannies, who carried the extra effort.
                </p>
                <h2 class="h cont">…but we couldn’t change how families book.</h2>
                <p class="body">
                    Our redesign was limited to the nanny-facing experience. The family booking flow remained unchanged, so any improvements had to work within the existing booking
                    system.
                </p>
                <div class="panel flow">
                    <video
                        data-loop
                        poster={img("flow-poster.jpg")}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label="Animated booking flow: the nanny side and family side build up, the booking path is highlighted, then the nanny side grows to take over."
                    >
                        <source src="/video/smn/flow.mp4" type="video/mp4" />
                        <source src="/video/smn/flow.webm" type="video/webm" />
                    </video>
                </div>
            </section>
        </div>

        <!-- Opportunity -->
        <div class="content opp-wrap">
            <section id="opportunity" class="opp-all">
                <!-- The opportunity question, with the nanny journey under it -->
                <div class="o o1">
                    <p class="tag">#opportunity</p>
                    <p class="oq">How might we create a more connected, intuitive experience for nannies throughout their caregiving journey?</p>
                    <div class="panel jwrap"><Journey /></div>
                </div>
            </section>
        </div>

        <div class="content">
            <!-- Solution: one headline and one line, then the four features -->
            <section id="solution" class="sec">
                <p class="tag">#solution</p>
                <h2 class="h">One home for the work around every booking.</h2>
                <p class="body">
                    We brought availability, shifts, schedules and post-session notes into one place, so nannies could manage their work as easily as families book them.
                </p>
            </section>
            <!-- Solution features -->
            <section class="sec story features">
                <div class="phone-col">
                    <StoryPhone count={steps.length} />
                </div>
                <div class="steps">
                    {
                        steps.map((s, i) => (
                            <div class="step" data-step={i}>
                                <h3>{s.h}</h3>
                                <p class="body">{s.p}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <p class="divider tag">The deep dive</p>
            <!-- Research -->
            <section id="research" class="sec gap-16">
                <p class="tag">#research</p>
                <h2 class="h">What’s holding them back?</h2>
                <p class="body">
                    The client approached us with a broad challenge: increasing nanny engagement, shift participation, and long-term retention. To understand the underlying
                    barriers, we interviewed 10 nannies about their everyday experiences, from managing availability to coordinating with families. Our research revealed four key
                    insights:
                </p>
                <div class="panel insights">
                    {
                        insights.map((x) => (
                            <div class="insight">
                                <div class="preview">
                                    <img src={img(x.img)} alt="" loading="lazy" />
                                </div>
                                <div class="insight-text">
                                    <h3>{x.h}</h3>
                                    <p>{x.p}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Pivot -->
            <section id="process" class="sec">
                <p class="tag">#pivot</p>
                <h2 class="h pv-h">From “keep nannies engaged” to “make the work easier.”</h2>
                <!-- narrowing visual, two ways (?z=zoom|reframe|but) -->
                <script is:inline>
                    document.documentElement.dataset.z = new URLSearchParams(location.search).get("z") || "zoom"
                </script>
                <div class="narrow z-but">
                    <p class="but-a">The client wanted nannies more engaged and staying longer…</p>
                    <p class="but-b">…but the real problem was the work around every booking.</p>
                    <div class="panel arrow">
                        <div class="ar-box">
                            <p class="zl">The ask</p>
                            <p class="zt">Engagement &amp; retention</p>
                        </div>
                        <svg class="ar" viewBox="0 0 40 12" aria-hidden="true"><path d="M0 6h37m-5-5 5 5-5 5" /></svg>
                        <div class="ar-box ar-end">
                            <p class="zl">The real problem</p>
                            <p class="zt">The work around every booking</p>
                        </div>
                    </div>
                    <p class="but-role">So my role was to bring that work onto the platform.</p>
                </div>
                <div class="panel narrow z-zoom">
                    <div class="zm zm1">
                        <p class="zl">The ask</p>
                        <p class="zt">More engagement, longer retention.</p>
                        <div class="zm zm2">
                            <p class="zl">Our question</p>
                            <p class="zt">What makes it hard for nannies to engage?</p>
                            <div class="zm zm3">
                                <p class="zl">What we found</p>
                                <p class="zt">Bookings were supported. The work around them wasn’t.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel narrow z-reframe">
                    <ol class="rf">
                        <li>
                            <p class="zl">The ask</p>
                            <p class="zt muted">More engagement, longer retention.</p>
                        </li>
                        <li>
                            <p class="zl">Our question</p>
                            <p class="zt">What makes it hard for nannies to engage?</p>
                        </li>
                        <li class="rf-end">
                            <p class="zl">What we found</p>
                            <p class="zt">Bookings were supported. The work around them wasn’t.</p>
                        </li>
                    </ol>
                </div>
            </section>

            <!-- My role -->
            <section id="needs" class="sec gap-16">
                <p class="tag">#what-nannies-need</p>
                <h2 class="h">What do nannies really need from this platform?</h2>
                <p class="body">
                    Our research uncovered diverse needs, from stronger peer connections to greater control over work opportunities. To move beyond individual feature requests, I
                    led the team to take a step back by asking: <em>What are nannies fundamentally trying to accomplish through this platform?</em>
                </p>
                <p class="body">
                    I guided the team in prioritizing pain points based on their relevance to core workflows and project feasibility, then translated them into Jobs to Be Done that
                    aligned the team around essential user needs and informed our design direction.
                </p>
                <div class="panel placeholder">
                    <p>[Placeholder: visual]</p>
                </div>
                <NeedsShift rows={needs} labels={["What nannies asked for", "The underlying need", "User goal"]} />
            </section>
        </div>

        <div class="content last">
            <!-- Results -->
            <section id="results" class="sec gap-16">
                <p class="tag">#results</p>
                <h2 class="h">What we delivered</h2>
                <p class="body">
                    Beyond redesigning key nanny workflows, we systematically audited the platform against usability best practices and established a consistent design foundation
                    with typography styles and reusable UI components, preparing the final designs for developer handoff through Figma Dev Mode.
                </p>
                <div class="panel quotes">
                    {
                        quotes.map((q) => (
                            <figure class="quote">
                                <div class="avatar" aria-hidden="true">
                                    {q.initials}
                                </div>
                                <div class="quote-body">
                                    <figcaption class="tag">{q.who}</figcaption>
                                    <blockquote>
                                        <p>{q.text}</p>
                                    </blockquote>
                                </div>
                            </figure>
                        ))
                    }
                </div>
                <p class="body">Our work also encouraged the client to look beyond booking efficiency and rethink how the platform could better support and engage caregivers.</p>
            </section>

            <!-- Reflection -->
            <section id="reflection" class="sec reflection">
                <p class="tag">#reflection</p>
                <h2 class="h">Seeing the big picture and sweating the details.</h2>
                <ol class="reflections">
                    {
                        reflections.map((r, i) => (
                            <li>
                                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <h3>{r.h}</h3>
                                    <p class="body">{r.p}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>

        </div>
    </main>
</Base>

<style>
    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        height: 90vh;
        padding-top: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        border-radius: 0 0 5rem 5rem;
        background: url("/images/smn/hero-bg.jpg") center / cover no-repeat;
    }
    .grain {
        position: absolute;
        inset: 0 0 -2px 0;
        background: url("/images/smn/grain.png") center / cover;
        pointer-events: none;
    }
    .title-area {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 1.5rem;
    }
    .hero h1 {
        max-width: 66.67%;
        font: 500 4.25rem/1.25 var(--serif);
        letter-spacing: -0.02em;
        color: #fff;
        text-align: center;
    }
    .hero-window {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 68.75rem;
        height: 18.75rem;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
    }
    .hero-phones {
        flex-shrink: 0;
        width: 141.36%;
        max-width: none;
        height: 42.5625rem;
        object-fit: cover;
        object-position: center top;
        will-change: transform;
    }

    /* ---------- Content columns ---------- */
    /* spacing follows rachelchen.tech: ~16px between blocks, ~20px label → headline → text,
       ~40px before a follow-on headline, ~96px between sections */
    .content {
        display: flex;
        flex-direction: column;
        gap: 5rem;
        padding: 2.5rem var(--gutter) 2.5rem 24.5rem;
    }
    .content.first {
        padding-top: 6rem;
    }
    .content.last {
        padding-bottom: 2.5rem;
    }

    .sec,
    .sec.gap-16 {
        display: flex;
        flex-direction: column;
        gap: 0.8333rem;
    }
    .sec > .tag + .h,
    .sec > .h + .body {
        margin-top: 0.2083rem;
    }
    .h {
        font: 500 1.1875rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .paras {
        display: flex;
        flex-direction: column;
        gap: 1.4em;
    }
    em {
        font-style: italic;
        font-synthesis: style;
    }

    /* Project info */
    .info {
        display: flex;
        justify-content: space-between;
        margin: 0;
    }
    .info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }
    /* label and items share one size and font; the label is just lighter */
    .info dt {
        font: 500 0.875rem/1.4 var(--para);
        color: var(--label);
    }
    .info dd {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font: 400 0.875rem/1.4 var(--para);
        color: var(--ink);
    }

    /* Cards and panels */
    /* Borders are drawn inside the box (as in the Framer design), so they don't eat into the content width */
    .card,
    .insight,
    .quote blockquote {
        box-shadow: inset 0 0 0 1px var(--border);
    }
    .card {
        background: var(--white);
        border-radius: 1rem;
    }
    /* outcomes: plain numbers, no cards */
    .outcomes {
        padding: 0;
    }
    .ot {
        font: 400 0.875rem/1.5 var(--sans);
        color: var(--label);
    }
    .outs-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }
    .ov {
        font: 500 1.0625rem/1.3 var(--sans);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .ot {
        margin-top: 0.25rem;
        max-width: 15rem;
    }
    .panel {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid var(--border);
        border-radius: inherit;
        pointer-events: none;
    }

    /* Solution */
    .story {
        flex-direction: row;
        align-items: flex-start;
        gap: 4rem;
    }
    .phone-col {
        position: sticky;
        top: 6.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-shrink: 0;
    }
    .steps {
        flex: 1;
        min-width: 0;
    }
    .step {
        height: 33.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.875rem;
    }
    .step h3 {
        font: 500 1.1875rem/1.15 var(--serif);
        letter-spacing: -0.5px;
        color: var(--ink);
    }

    /* Problem */
    .flow video {
        display: block;
        width: 100%;
        aspect-ratio: 1.6;
        object-fit: cover;
    }

    /* Research */
    .insights {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 1fr;
        gap: 0.75rem;
        padding: 0.875rem;
    }
    .insight {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 0.375rem 0.375rem 0.875rem;
        background: var(--white);
        border-radius: 1rem;
    }
    .preview {
        border-radius: 0.625rem;
        background: #f0f0f0;
        overflow: hidden;
    }
    .preview img {
        width: 100%;
        height: auto;
    }
    .insight-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.5rem;
    }
    .insight h3 {
        font: 500 0.875rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--ink);
    }
    .insight p {
        font: 400 0.8125rem/1.5 var(--sans);
        letter-spacing: 0.01em;
        color: var(--body);
    }

    /* Pivot */
    .journey {
        padding: 2.25rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .journey picture,
    .journey img {
        width: 100%;
        height: auto;
    }

    /* My role */
    .placeholder {
        padding: 7.5rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .placeholder p {
        font: 400 0.8125rem/1.4 var(--sans);
        color: var(--label);
    }

    /* Results */
    .quotes {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 0.875rem 0.875rem 1.5rem;
    }
    .quote {
        margin: 0;
        display: flex;
        gap: 1rem;
        padding: 0 0.625rem;
    }
    .avatar {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        background: #ecebe7;
        display: grid;
        place-items: center;
        font: 500 0.75rem/1 var(--sans);
        color: var(--label);
    }
    .quote-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .quote blockquote {
        margin: 0;
        padding: 1.125rem 1.375rem;
        background: var(--white);
        border-radius: 4px 1rem 1rem 1rem;
    }
    .quote blockquote p {
        font: italic 400 1rem/1.5 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }

    /* Reflection */
    .reflection {
        padding-bottom: 3.75rem;
    }
    .reflections {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0 0;
    }
    .reflections li {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
    }
    .num {
        flex-shrink: 0;
        width: 1.75rem;
        font: 400 0.75rem/1.375rem var(--sans);
        color: var(--label);
    }
    .reflections li > div {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .reflections h3 {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
