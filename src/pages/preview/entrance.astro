---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Home entrance" noindex>
    <script is:inline>
        const q = new URLSearchParams(location.search)
        document.documentElement.dataset.e = q.get("e") || "a"
        if (q.has("rec")) document.documentElement.dataset.rec = ""
    </script>
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear>{headline.join(" ")}</h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <div class="caption">
                                            <h2 class="name">{p.descriptor}</h2>
                                            <p class="line">{p.blurb}</p>
                                        </div>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
    <nav class="switch" aria-label="Entrance">
        <a href="?e=now">Current</a>
        <a href="?e=a">A · Soft rise</a>
        <a href="?e=b">B · Focus</a>
        <a href="?e=c">C · Curtain</a>
        <a href="?e=d">D · Cards first</a>
    </nav>
</Base>

<style is:global>
    .switch{position:fixed;z-index:60;left:50%;bottom:1.25rem;transform:translateX(-50%);display:flex;gap:.25rem;padding:.25rem;border-radius:999px;background:rgba(17,17,17,.88)}
    .switch a{padding:.5rem .875rem;border-radius:999px;color:rgba(255,255,255,.72);font:500 .75rem/1 var(--sans);white-space:nowrap}
    html[data-e="now"] .switch a[href="?e=now"],html[data-e="a"] .switch a[href="?e=a"],html[data-e="b"] .switch a[href="?e=b"],html[data-e="c"] .switch a[href="?e=c"],html[data-e="d"] .switch a[href="?e=d"]{background:#fff;color:#111}
    html[data-rec] .switch{display:none}

    /* shared keyframes */
    @keyframes x-up{from{opacity:0;transform:translateY(2.5rem)}to{opacity:1;transform:none}}
    @keyframes x-fade{from{opacity:0}to{opacity:1}}
    @keyframes x-blur{from{opacity:0;filter:blur(16px);transform:scale(1.04)}to{opacity:1;filter:none;transform:none}}
    @keyframes x-curtain{from{transform:translateY(0)}to{transform:translateY(-100%)}}
    @keyframes x-cards{from{opacity:0;transform:translateY(40vh)}to{opacity:1;transform:none}}

    /* new variants take over: the cards in the first screen animate with the page instead of on scroll */
    html:not([data-e="now"]) .hero .headline,html:not([data-e="now"]) .hero .lede,html:not([data-e="now"]) .sky,html:not([data-e="now"]) .top-nav .pill{animation:none}
    html:not([data-e="now"]) .work .grid{opacity:1}

    /* A: soft rise. Nav, headline, intro and the first cards rise in one after another */
    html[data-e="a"] .top-nav .pill{animation:x-fade .8s ease both .1s}
    html[data-e="a"] .sky{animation:x-fade 1.4s ease both}
    html[data-e="a"] .hero .headline{animation:x-up 1s var(--spring) both .2s}
    html[data-e="a"] .hero .lede{animation:x-up 1s var(--spring) both .35s}
    html[data-e="a"] .work .grid{animation:x-up 1.1s var(--spring) both .55s}

    /* B: focus. Headline and intro sharpen from a blur, then the cards rise */
    html[data-e="b"] .top-nav .pill{animation:x-fade .8s ease both .6s}
    html[data-e="b"] .sky{animation:x-fade 1.6s ease both}
    html[data-e="b"] .hero .headline{animation:x-blur 1.3s cubic-bezier(.2,.7,.2,1) both .1s}
    html[data-e="b"] .hero .lede{animation:x-blur 1.1s cubic-bezier(.2,.7,.2,1) both .45s}
    html[data-e="b"] .work .grid{animation:x-up 1.1s var(--spring) both .8s}

    /* C: curtain. A sheet of paper lifts off the page to reveal it */
    html[data-e="c"] body::after{content:"";position:fixed;inset:0;z-index:100;background:var(--paper);animation:x-curtain 1s cubic-bezier(.76,0,.24,1) both .15s;pointer-events:none}
    html[data-e="c"] .hero .headline{animation:x-up 1.1s var(--spring) both .55s}
    html[data-e="c"] .hero .lede{animation:x-up 1.1s var(--spring) both .7s}
    html[data-e="c"] .work .grid{animation:x-up 1.1s var(--spring) both .85s}

    /* D: cards first. The project cards glide up into place, then the words settle in above them */
    html[data-e="d"] .sky{animation:x-fade 1.4s ease both}
    html[data-e="d"] .work .grid{animation:x-cards 1.2s var(--spring) both .1s}
    html[data-e="d"] .hero .headline{animation:x-up 1s var(--spring) both .75s}
    html[data-e="d"] .hero .lede{animation:x-up 1s var(--spring) both .9s}
    html[data-e="d"] .top-nav .pill{animation:x-fade .8s ease both 1.1s}
    html:not([data-e="now"]) .rise{opacity:1;transform:none}
</style>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    /* shorter than the screen, so the first project cards peek in below */
    .hero {
        min-height: 80vh;
        min-height: 80svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 3rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    .lede {
        max-width: 47rem;
        text-wrap: balance;
        font: 400 1.0625rem/1.55 var(--sans);
        color: var(--body);
    }

    /* Entrance: the clouds gather over plain paper, then the words settle on top,
       and the nav arrives last */
    .headline {
        animation: enter-up 1.2s var(--spring) both 1s;
    }
    .lede {
        animation: enter-up 1.2s var(--spring) both 1.25s;
    }
    :global(.sky) {
        animation: enter-sky 2s ease both;
    }
    :global(.top-nav .pill) {
        animation: enter-fade 0.8s ease both 0.5s;
    }
    @keyframes enter-sky {
        from {
            opacity: 0;
            transform: scale(1.08);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    /* a descriptor, then a one-line summary */
    .caption {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.375rem;
    }
    .name {
        font: 400 1.0625rem/1.35 var(--sans);
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .line {
        font: 400 0.9375rem/1.45 var(--sans);
        letter-spacing: 0.005em;
        color: var(--body);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .headline,
        .lede,
        :global(.sky),
        :global(.top-nav .pill) {
            animation: none;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 0.9375rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0 },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>
