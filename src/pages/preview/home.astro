---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Home hero" noindex>
    <script is:inline>
        const q = new URLSearchParams(location.search)
        document.documentElement.dataset.v = q.get("v") || "now"
        document.documentElement.dataset.e = q.get("e") || "now"
        if (q.has("rec")) document.documentElement.dataset.rec = ""
    </script>
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <p class="hello">Hello <img src="/images/avatar.jpg" alt="" width="24" height="24" /> <span>I’m <b>Sophia Tang</b></span></p>
            <p class="statement">I create experiences grounded in <b>research and systems thinking</b>, bringing curiosity to everyday interactions and a <b>strategic lens</b> to complex challenges.</p>
            <h1 class="headline" data-sky-clear>{headline.join(" ")}</h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <div class="caption">
                                            <h2 class="name">{p.descriptor}</h2>
                                            <p class="line">{p.blurb}</p>
                                        </div>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
    <nav class="switch eswitch" aria-label="Entrance">
        <a href="?v=4&e=now">Entrance: current</a>
        <a href="?v=4&e=a">A · Soft rise</a>
        <a href="?v=4&e=b">B · Focus</a>
        <a href="?v=4&e=c">C · Curtain</a>
        <a href="?v=4&e=d">D · Cards first</a>
    </nav>
    <nav class="switch" aria-label="Hero option">
        <a href="?v=now">Current</a>
        <a href="?v=1">1 · No sky</a>
        <a href="?v=2">2 · Smaller hero</a>
        <a href="?v=3">3 · No headline</a>
        <a href="?v=2u">2 · Upright</a>
        <a href="?v=4">4 · Statement</a>
    </nav>
</Base>

<style is:global>
    .eswitch{bottom:4.5rem!important}
    html:not([data-v="4"]) .eswitch{display:none}
    html[data-rec] .switch{display:none}
    html[data-e="now"] .eswitch a[href$="e=now"],html[data-e="a"] .eswitch a[href$="e=a"],html[data-e="b"] .eswitch a[href$="e=b"],html[data-e="c"] .eswitch a[href$="e=c"],html[data-e="d"] .eswitch a[href$="e=d"]{background:#fff;color:#111}

    @keyframes x-up{from{opacity:0;transform:translateY(2.5rem)}to{opacity:1;transform:none}}
    @keyframes x-fade{from{opacity:0}to{opacity:1}}
    @keyframes x-blur{from{opacity:0;filter:blur(16px);transform:scale(1.03)}to{opacity:1;filter:none;transform:none}}
    @keyframes x-curtain{from{transform:translateY(0)}to{transform:translateY(-100%)}}
    @keyframes x-cards{from{opacity:0;transform:translateY(40vh)}to{opacity:1;transform:none}}

    html[data-v="4"]:not([data-e="now"]) .rise{opacity:1;transform:none}

    html[data-v="4"][data-e="a"] .top-nav .pill{animation:x-fade .8s ease both .1s}
    html[data-v="4"][data-e="a"] .hello{animation:x-up 1s var(--spring) both .15s}
    html[data-v="4"][data-e="a"] .statement{animation:x-up 1s var(--spring) both .3s}
    html[data-v="4"][data-e="a"] .work .grid{animation:x-up 1.1s var(--spring) both .5s}

    html[data-v="4"][data-e="b"] .top-nav .pill{animation:x-fade .8s ease both .6s}
    html[data-v="4"][data-e="b"] .hello{animation:x-blur 1.1s cubic-bezier(.2,.7,.2,1) both .05s}
    html[data-v="4"][data-e="b"] .statement{animation:x-blur 1.3s cubic-bezier(.2,.7,.2,1) both .2s}
    html[data-v="4"][data-e="b"] .work .grid{animation:x-up 1.1s var(--spring) both .75s}

    html[data-v="4"][data-e="c"] body::after{content:"";position:fixed;inset:0;z-index:100;background:var(--paper);animation:x-curtain 1s cubic-bezier(.76,0,.24,1) both .15s;pointer-events:none}
    html[data-v="4"][data-e="c"] .hello{animation:x-up 1.1s var(--spring) both .55s}
    html[data-v="4"][data-e="c"] .statement{animation:x-up 1.1s var(--spring) both .7s}
    html[data-v="4"][data-e="c"] .work .grid{animation:x-up 1.1s var(--spring) both .85s}

    html[data-v="4"][data-e="d"] .work .grid{animation:x-cards 1.2s var(--spring) both .1s}
    html[data-v="4"][data-e="d"] .hello{animation:x-up 1s var(--spring) both .75s}
    html[data-v="4"][data-e="d"] .statement{animation:x-up 1s var(--spring) both .9s}
    html[data-v="4"][data-e="d"] .top-nav .pill{animation:x-fade .8s ease both 1.1s}
</style>

<style is:global>
    .switch{position:fixed;z-index:60;left:50%;bottom:1.25rem;transform:translateX(-50%);display:flex;gap:.25rem;padding:.25rem;border-radius:999px;background:rgba(17,17,17,.88)}
    .switch a{padding:.5rem .875rem;border-radius:999px;color:rgba(255,255,255,.72);font:500 .75rem/1 var(--sans);white-space:nowrap}
    html[data-v="now"] .switch a[href="?v=now"],html[data-v="1"] .switch a[href="?v=1"],html[data-v="2"] .switch a[href="?v=2"],html[data-v="3"] .switch a[href="?v=3"]{background:#fff;color:#111}

    .hello,.statement{display:none}
    html[data-v="4"] .switch a[href="?v=4"]{background:#fff;color:#111}
    /* 4: paper only; a small "Hello, I'm Sophia Tang" line over one big statement */
    html[data-v="4"] .sky,html[data-v="4"] .headline,html[data-v="4"] .lede{display:none}
    html[data-v="4"] .hero{min-height:79vh;min-height:79svh;padding:8rem var(--gutter) 2rem;gap:1.5rem}
    html[data-v="4"] .hello{display:flex;align-items:center;gap:.625rem;font:400 1.0625rem/1 var(--sans);color:var(--body);animation:enter-up 1s var(--spring) both .1s}
    html[data-v="4"] .hello img{width:2rem;height:2rem;border-radius:50%;object-fit:cover}
    html[data-v="4"] .hello b{font-weight:400;color:var(--body)}
    html[data-v="4"] .statement b{font-weight:inherit;color:#3a3a3a}
    html[data-v="4"] .statement{display:block;max-width:60rem;font:400 2.375rem/1.2 var(--sans);letter-spacing:-.035em;color:#a8a8a8;text-wrap:balance;animation:enter-up 1.1s var(--spring) both .3s}

    /* 1: no sky, plain paper */
    html[data-v="1"] .sky{display:none}

    /* 2: smaller, left-aligned hero; cards start higher */
    html[data-v="2u"] .switch a[href="?v=2u"]{background:#fff;color:#111}
    html[data-v="2"] .hero,html[data-v="2u"] .hero{min-height:0;align-items:flex-start;text-align:left;padding:10rem var(--gutter) 4rem;gap:1.25rem}
    html[data-v="2"] .headline,html[data-v="2u"] .headline{font-size:3rem;max-width:36rem}
    html[data-v="2"] .lede,html[data-v="2u"] .lede{max-width:34rem;text-wrap:pretty}
    html[data-v="2"] .sky,html[data-v="2u"] .sky{--sky-h:70vh}
    /* 2u: same as 2, upright serif headline */
    html[data-v="2u"] .headline{font-style:normal;font-weight:400;letter-spacing:-.025em;font-size:2.875rem;line-height:1.08}

    /* 3: no headline, just the intro line above the cards */
    html[data-v="3"] .headline{display:none}
    html[data-v="3"] .hero{min-height:0;padding:11rem var(--gutter) 4.5rem}
    html[data-v="3"] .lede{font-size:1.5rem;line-height:1.45;color:var(--ink);max-width:46rem}
    html[data-v="3"] .sky{--sky-h:70vh}

    @media (max-width:809.98px){
        html[data-v="2"] .headline,html[data-v="2u"] .headline{font-size:2.125rem}
        html[data-v="2"] .hero,html[data-v="2u"] .hero,html[data-v="3"] .hero{padding-top:7rem}
        html[data-v="3"] .lede{font-size:1.1875rem}
        html[data-v="4"] .hero{min-height:73svh;padding:7rem var(--gutter) 2rem;gap:1.25rem}
        html[data-v="4"] .statement{font-size:1.5rem}
        .switch{left:.5rem;right:.5rem;transform:none;overflow-x:auto}
    }
</style>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    /* shorter than the screen, so the first project cards peek in below */
    .hero {
        min-height: 80vh;
        min-height: 80svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 3rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    .lede {
        max-width: 47rem;
        text-wrap: balance;
        font: 400 1.0625rem/1.55 var(--sans);
        color: var(--body);
    }

    /* Entrance: the clouds gather over plain paper, then the words settle on top,
       and the nav arrives last */
    .headline {
        animation: enter-up 1.2s var(--spring) both 1s;
    }
    .lede {
        animation: enter-up 1.2s var(--spring) both 1.25s;
    }
    :global(.sky) {
        animation: enter-sky 2s ease both;
    }
    :global(.top-nav .pill) {
        animation: enter-fade 0.8s ease both 0.5s;
    }
    @keyframes enter-sky {
        from {
            opacity: 0;
            transform: scale(1.08);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    /* a descriptor, then a one-line summary */
    .caption {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.375rem;
    }
    .name {
        font: 400 1.0625rem/1.35 var(--sans);
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .line {
        font: 400 0.9375rem/1.45 var(--sans);
        letter-spacing: 0.005em;
        color: var(--body);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .headline,
        .lede,
        :global(.sky),
        :global(.top-nav .pill) {
            animation: none;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 0.9375rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0 },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>
