---
// The booking flow between the nanny side and the family side, redrawn from the original
// diagram in the site font and the portfolio's neutral greys (no pure black).
// Coordinates follow the original artwork, so the layout matches it.
---

<svg
    class="flowmap"
    viewBox="-55 120 1450 725"
    role="img"
    aria-label="Booking flow. Nanny side: set availability, then availability is posted and shown to families. Family side, out of scope: families browse nannies; if the time is covered and they book the nanny, the booking is confirmed and an email notice makes it show up for the nanny. If the time isn't covered, the family requests an open shift, which is shown to nannies, who can accept it."
>
    <defs>
        <marker id="fm-a-ink" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M1 1 7 4 1 7" fill="none" stroke="#3a3a3a" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
        <marker id="fm-a-grey" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M1 1 7 4 1 7" fill="none" stroke="#a3a7ad" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
        <pattern id="fm-hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="14" height="14" fill="#efefef"></rect>
            <line x1="0" y1="0" x2="0" y2="14" stroke="#e6e6e6" stroke-width="5"></line>
        </pattern>
    </defs>

    <!-- nanny side -->
    <rect class="area-nanny" x="115" y="128" width="1267" height="256" rx="18"></rect>
    <text class="area-label" x="-45" y="153">Nanny side</text>

    <!-- family side, out of scope -->
    <rect x="115" y="497" width="1267" height="338" rx="18" fill="url(#fm-hatch)"></rect>
    <text class="area-label muted" x="-45" y="522">Family side</text>
    <rect class="pill" x="-45" y="536" width="124" height="31" rx="15.5"></rect>
    <text class="tiny" x="17" y="558" text-anchor="middle">Out of scope</text>

    <!-- connectors -->
    <path class="ln ink" d="M326 185 H398" marker-end="url(#fm-a-ink)"></path>
    <path class="ln grey" d="M499 220 V538" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="489" y="447" text-anchor="end">shown to families</text>

    <path class="ln grey" d="M594 579 H667" marker-end="url(#fm-a-grey)"></path>
    <path class="ln grey" d="M823 579 H936" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="880" y="567" text-anchor="middle">yes</text>
    <path class="ln grey" d="M1092 579 H1166" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="1130" y="567" text-anchor="middle">yes</text>

    <path class="ln grey" d="M748 639 V692" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="760" y="670">no</text>
    <path class="ln grey" d="M654 733 H633 V329 H666" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="643" y="447">shown to nannies</text>
    <path class="ln grey" d="M1017 639 V813 H499 V622" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="1030" y="727">no</text>

    <path class="ln grey" d="M1267 544 V372" marker-end="url(#fm-a-grey)"></path>
    <text class="tiny" x="1277" y="447">email notice</text>

    <path class="ln ink" d="M864 329 H934" marker-end="url(#fm-a-ink)"></path>
    <path class="ln ink" d="M1095 329 H1166" marker-end="url(#fm-a-ink)"></path>
    <text class="tiny" x="1132" y="317" text-anchor="middle">yes</text>

    <!-- nanny-side steps -->
    <rect class="node" x="135" y="150" width="190" height="70" rx="12"></rect>
    <text class="t" x="230" y="191" text-anchor="middle">Set availability</text>
    <rect class="node" x="404" y="150" width="190" height="70" rx="12"></rect>
    <text class="t" x="499" y="191" text-anchor="middle">Availability posted</text>
    <rect class="node" x="672" y="294" width="191" height="70" rx="12"></rect>
    <text class="t" x="767" y="324" text-anchor="middle">See open shift</text>
    <text class="t" x="767" y="347" text-anchor="middle">request</text>
    <path class="dia strong" d="M1017 267 L1095 329 L1017 391 L939 329 Z"></path>
    <text class="t d on-strong" x="1017" y="335" text-anchor="middle">Accept shift?</text>
    <rect class="node" x="1172" y="294" width="190" height="70" rx="12"></rect>
    <text class="t" x="1267" y="335" text-anchor="middle">Booking shows up</text>

    <!-- family-side steps -->
    <rect class="node dash" x="404" y="544" width="190" height="70" rx="12"></rect>
    <text class="t muted" x="499" y="585" text-anchor="middle">Browse nannies</text>
    <path class="dia soft" d="M748 519 L823 579 L748 639 L673 579 Z"></path>
    <text class="t d" x="748" y="575" text-anchor="middle">Time</text>
    <text class="t d" x="748" y="596" text-anchor="middle">covered?</text>
    <path class="dia soft" d="M1017 519 L1092 579 L1017 639 L942 579 Z"></path>
    <text class="t d" x="1017" y="575" text-anchor="middle">Book this</text>
    <text class="t d" x="1017" y="596" text-anchor="middle">nanny?</text>
    <rect class="node dash" x="1172" y="544" width="190" height="70" rx="12"></rect>
    <text class="t muted" x="1267" y="585" text-anchor="middle">Booking confirmed</text>
    <rect class="node dash" x="654" y="698" width="190" height="70" rx="12"></rect>
    <text class="t muted" x="749" y="728" text-anchor="middle">Request an open</text>
    <text class="t muted" x="749" y="751" text-anchor="middle">shift</text>
</svg>

<style>
    .flowmap {
        display: block;
        width: 100%;
        height: auto;
        font-family: var(--sans);
    }
    .area-nanny {
        fill: #fff;
        stroke: #3a3a3a;
        stroke-width: 1.5;
    }
    .area-label {
        font-size: 24px;
        font-weight: 500;
        fill: #3a3a3a;
    }
    .area-label.muted {
        fill: #8a8a8a;
    }
    .pill {
        fill: #fff;
        stroke: #dcdcdc;
    }
    .tiny {
        font-size: 19px;
        fill: #8f949a;
    }
    .t {
        font-size: 19px;
        fill: #3a3a3a;
    }
    .t.d {
        font-size: 16.5px;
        font-weight: 500;
    }
    .t.muted {
        fill: #8a8a8a;
    }
    .t.on-strong {
        fill: #fff;
    }
    .ln {
        fill: none;
        stroke-width: 1.3;
        stroke-linejoin: round;
    }
    .ln.ink {
        stroke: #3a3a3a;
    }
    .ln.grey {
        stroke: #a3a7ad;
    }
    .node {
        fill: #fff;
        stroke: #3a3a3a;
        stroke-width: 1.5;
    }
    .node.dash {
        fill: rgba(255, 255, 255, 0.55);
        stroke: #cfcfcf;
        stroke-dasharray: 5 4;
    }
    .dia.soft {
        fill: #e3e3e3;
    }
    .dia.strong {
        fill: #3a3a3a;
    }
</style>
