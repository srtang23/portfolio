---
// Full-page halftone sky: a grid of white dots whose size follows a drifting cloud
// noise field, drawn on a canvas over a blue gradient. Slowly drifts and reshapes.
// Clouds thin out around elements marked [data-sky-clear] so text stays readable.
// Respects reduced motion (draws one still frame) and pauses when the tab is hidden.
---

<div class="sky" aria-hidden="true">
    <canvas data-sky></canvas>
</div>

<style>
    .sky {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: linear-gradient(180deg, #0c55b3 0%, #1f6fc6 45%, #4b93d8 100%);
    }
    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    const canvas = document.querySelector<HTMLCanvasElement>("[data-sky]")
    if (canvas) {
        const ctx = canvas.getContext("2d")!

        // --- value noise + fbm ---
        const P = new Uint8Array(512)
        {
            const p = Array.from({ length: 256 }, (_, i) => i)
            let s = 1337
            for (let i = 255; i > 0; i--) {
                s = (s * 16807) % 2147483647
                const j = s % (i + 1)
                ;[p[i], p[j]] = [p[j], p[i]]
            }
            for (let i = 0; i < 512; i++) P[i] = p[i & 255]
        }
        const V = new Float32Array(256).map((_, i) => P[i] / 255)
        const fade = (t: number) => t * t * (3 - 2 * t)
        const noise = (x: number, y: number) => {
            const xi = Math.floor(x),
                yi = Math.floor(y)
            const xf = x - xi,
                yf = y - yi
            const X = xi & 255,
                Y = yi & 255
            const a = V[P[P[X] + Y]],
                b = V[P[P[X + 1] + Y]],
                c = V[P[P[X] + Y + 1]],
                d = V[P[P[X + 1] + Y + 1]]
            const u = fade(xf),
                v = fade(yf)
            return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v
        }
        const fbm = (x: number, y: number) => {
            let s = 0,
                amp = 0.5,
                f = 1
            for (let o = 0; o < 4; o++) {
                s += amp * noise(x * f, y * f)
                f *= 2.03
                amp *= 0.5
            }
            return s / 0.9375
        }
        const smooth = (a: number, b: number, x: number) => {
            const t = Math.min(1, Math.max(0, (x - a) / (b - a)))
            return t * t * (3 - 2 * t)
        }

        let W = 0,
            H = 0,
            dpr = 1,
            cell = 10,
            cols = 0,
            rows = 0
        const resize = () => {
            dpr = Math.min(window.devicePixelRatio || 1, 2)
            W = canvas.clientWidth
            H = canvas.clientHeight
            canvas.width = Math.round(W * dpr)
            canvas.height = Math.round(H * dpr)
            const rem = parseFloat(getComputedStyle(document.documentElement).fontSize)
            cell = Math.max(7, rem * 0.62)
            cols = Math.ceil(W / cell) + 1
            rows = Math.ceil(H / cell) + 1
        }

        // Text areas the clouds part around, in viewport coordinates.
        let clear: { l: number; t: number; r: number; b: number }[] = []
        const measure = () => {
            // one box per rendered line of text, so the gap hugs the words
            const range = document.createRange()
            clear = []
            for (const el of document.querySelectorAll<HTMLElement>("[data-sky-clear]")) {
                const box = el.getBoundingClientRect()
                if (box.bottom < -100 || box.top > H + 100) continue
                range.selectNodeContents(el)
                for (const r of range.getClientRects()) if (r.width > 0) clear.push({ l: r.left, t: r.top, r: r.right, b: r.bottom })
            }
        }
        const PAD = 28
        const keep = (x: number, y: number) => {
            let m = 1
            for (const c of clear) {
                const dx = Math.max(c.l - x, 0, x - c.r)
                const dy = Math.max(c.t - y, 0, y - c.b)
                const dist = Math.hypot(dx, dy)
                if (dist < PAD) m = Math.min(m, dist / PAD)
            }
            return 0.12 + 0.88 * m * m
        }

        const BUCKETS = 5
        const paths: Path2D[] = []
        const draw = (t: number) => {
            measure()
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
            ctx.clearRect(0, 0, W, H)
            for (let k = 0; k < BUCKETS; k++) paths[k] = new Path2D()
            const scale = 1 / (cell * 22) // noise units per pixel
            const drift = t * 0.000034 // slow sideways drift
            const morph = t * 0.000009 // slower change of shape
            for (let j = 0; j < rows; j++) {
                const y = j * cell
                // a little more cloud lower down, like the reference
                const bias = 0.06 * (y / H) - 0.03
                for (let i = 0; i < cols; i++) {
                    const x = i * cell + (j & 1 ? cell / 2 : 0)
                    const nx = x * scale,
                        ny = y * scale * 1.6
                    let n = fbm(nx + drift, ny - morph * 0.4)
                    n += 0.35 * (fbm(nx * 0.5 - morph, ny * 0.5 + morph) - 0.5)
                    const d = smooth(0.42, 0.78, n + bias) * (clear.length ? keep(x, y) : 1)
                    if (d < 0.04) continue
                    const r = cell * 0.5 * Math.pow(d, 0.75)
                    const k = Math.min(BUCKETS - 1, Math.floor(d * BUCKETS))
                    paths[k].moveTo(x + r, y)
                    paths[k].arc(x, y, r, 0, Math.PI * 2)
                }
            }
            for (let k = 0; k < BUCKETS; k++) {
                ctx.fillStyle = `rgba(255,255,255,${0.35 + 0.6 * ((k + 1) / BUCKETS)})`
                ctx.fill(paths[k])
            }
        }

        resize()
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches
        const start = performance.now() - 40000
        if (still) draw(40000)
        else {
            let last = 0
            const loop = (now: number) => {
                if (now - last > 33) {
                    // ~30fps is plenty for slow clouds
                    last = now
                    draw(now - start)
                }
                requestAnimationFrame(loop)
            }
            requestAnimationFrame(loop)
        }
        addEventListener("resize", () => {
            resize()
            if (still) draw(40000)
        })
    }
</script>
