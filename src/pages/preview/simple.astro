---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
const intro = "I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges."
---

<Base title="Preview · Simple home" noindex>
    <script is:inline>
        document.documentElement.dataset.s = new URLSearchParams(location.search).get("s") || "a"
    </script>

    <!-- A: index list -->
    <main class="v va">
        <header class="intro">
            <h1>Sophia Tang</h1>
            <p>Product designer. {intro}</p>
        </header>
        <ol class="list">
            {
                projects.map((p, i) => (
                    <li>
                        <a href={p.href}>
                            <span class="n">{String(i + 1).padStart(2, "0")}</span>
                            <span class="t">{p.descriptor}</span>
                            <span class="m">{p.meta}</span>
                            <img src={p.image} alt="" loading="lazy" />
                        </a>
                    </li>
                ))
            }
        </ol>
    </main>

    <!-- B: one column -->
    <main class="v vb">
        <header class="intro">
            <h1>Sophia Tang is a product designer.</h1>
            <p>{intro}</p>
        </header>
        {
            projects.map((p) => (
                <a class="card" href={p.href}>
                    <img src={p.image} alt={p.alt} loading="lazy" />
                    <div class="cap">
                        <span class="t">{p.descriptor}</span>
                        <span class="m">{p.meta}</span>
                    </div>
                </a>
            ))
        }
    </main>

    <!-- C: split -->
    <main class="v vc">
        <aside class="intro">
            <h1>Sophia Tang</h1>
            <p class="role">Product designer</p>
            <p>{intro}</p>
        </aside>
        <div class="feed">
            {
                projects.map((p) => (
                    <a class="card" href={p.href}>
                        <img src={p.image} alt={p.alt} loading="lazy" />
                        <span class="t">{p.descriptor}</span>
                        <span class="l">{p.blurb}</span>
                    </a>
                ))
            }
        </div>
    </main>
</Base>

<style is:global>
    .v { display: none; }
    html[data-s="a"] .va, html[data-s="b"] .vb { display: block; }
    html[data-s="c"] .vc { display: grid; }

    /* A: index list */
    .va { max-width: 44rem; transform: translateX(-6rem); margin: 0 auto; padding: 11rem var(--gutter) 8rem; }
    .va .intro { margin-bottom: 5rem; }
    .va h1 { font: 400 1.75rem/1.2 var(--serif); letter-spacing: -0.02em; color: var(--ink); margin-bottom: 1rem; }
    .va .intro p { max-width: 34rem; font: 400 1rem/1.6 var(--sans); color: var(--body); }
    .va .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .va .list li { border-bottom: 1px solid var(--border); }
    .va .list a { position: relative; display: grid; grid-template-columns: 3rem 1fr auto; align-items: baseline; gap: 1rem; padding: 1.25rem 0; }
    .va .n, .va .m { font: 400 0.8125rem/1.4 var(--sans); color: var(--label); }
    .va .t { font: 400 1.125rem/1.4 var(--sans); color: var(--ink); }
    .va .list img { position: absolute; left: calc(100% + 2rem); top: 50%; width: 14rem; aspect-ratio: 1.6; object-fit: cover; border-radius: 0.375rem; transform: translateY(-50%) scale(0.96); opacity: 0; pointer-events: none; transition: opacity 0.25s ease, transform 0.4s var(--spring); z-index: 2; }
    .va .list a:hover img { opacity: 1; transform: translateY(-50%); }

    /* B: one column */
    .vb { max-width: 46rem; margin: 0 auto; padding: 11rem var(--gutter) 8rem; }
    .vb .intro { margin-bottom: 5rem; }
    .vb h1 { font: 400 2.25rem/1.15 var(--serif); letter-spacing: -0.02em; color: var(--ink); margin-bottom: 1rem; }
    .vb .intro p { font: 400 1.0625rem/1.6 var(--sans); color: var(--body); }
    .vb .card { display: block; margin-bottom: 3.5rem; }
    .vb .card img { width: 100%; aspect-ratio: 1.6; object-fit: cover; border-radius: 0.375rem; }
    .vb .cap { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.75rem; }
    .vb .t { font: 400 1rem/1.4 var(--sans); color: var(--ink); }
    .vb .m { font: 400 0.875rem/1.4 var(--sans); color: var(--label); }

    /* C: split */
    .vc { grid-template-columns: 1fr 2fr; gap: 4rem; padding: 9rem var(--gutter) 8rem; }
    .vc .intro { position: sticky; top: 9rem; align-self: start; }
    .vc h1 { font: 400 1.75rem/1.2 var(--serif); letter-spacing: -0.02em; color: var(--ink); }
    .vc .role { font: 400 1rem/1.5 var(--sans); color: var(--label); margin: 0.25rem 0 1.5rem; }
    .vc .intro p:last-child { font: 400 0.9375rem/1.6 var(--sans); color: var(--body); }
    .vc .feed { display: flex; flex-direction: column; gap: 3rem; }
    .vc .card { display: flex; flex-direction: column; gap: 0.375rem; }
    .vc .card img { width: 100%; aspect-ratio: 1.6; object-fit: cover; border-radius: 0.375rem; margin-bottom: 0.5rem; }
    .vc .t { font: 400 1.0625rem/1.4 var(--sans); color: var(--ink); }
    .vc .l { font: 400 0.9375rem/1.5 var(--sans); color: var(--body); }

    @media (max-width: 809.98px) {
        .va, .vb { padding-top: 7rem; }
        .va { transform: none; }
        .va .list a { grid-template-columns: 2rem 1fr; }
        .va .m, .va .list img { display: none; }
        html[data-s="c"] .vc { display: block; padding-top: 7rem; }
        .vc .intro { position: static; margin-bottom: 3rem; }
    }
</style>
