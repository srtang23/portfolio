---
// Opportunity: how planning works today (create tasks, then follow them) against what it could be
// (talk it through, see the goal take shape, start the first step).
const ic = {
    plus: `<path d="M12 5v14M5 12h14"/>`,
    check: `<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8 12.5 3 3 5-6"/>`,
    chat: `<path d="M5 5.5h14v10H10l-4 3.5v-3.5H5z"/>`,
    shape: `<rect x="4" y="4" width="16" height="6" rx="2"/><path d="M7 14h10M7 18h6"/>`,
    go: `<path d="M5 12h12m-4-5 5 5-5 5"/>`,
}
const rows = [
    {
        k: "Today",
        note: "Assumes you already know what to do",
        muted: true,
        steps: [
            { i: ic.plus, t: "Create tasks" },
            { i: ic.check, t: "Follow them" },
        ],
    },
    {
        k: "The opportunity",
        note: "Start from wherever your thinking is",
        muted: false,
        steps: [
            { i: ic.chat, t: "Talk it through" },
            { i: ic.shape, t: "See the goal take shape" },
            { i: ic.go, t: "Start the first step" },
        ],
    },
]
---

<div class="ptp" role="img" aria-label="Today, planning means creating tasks and following them, which assumes you already know what to do. The opportunity: talk it through, see the goal take shape, and start the first step, starting from wherever your thinking is.">
    {
        rows.map((r) => (
            <div class:list={["line", { muted: r.muted }]} aria-hidden="true">
                <div class="label">
                    <p class="k">{r.k}</p>
                    <p class="note">{r.note}</p>
                </div>
                <div class="flow">
                    {r.steps.map((s, i) => (
                        <>
                            {i > 0 && (
                                <svg class="arr" viewBox="0 0 60 12">
                                    <path d="M2 6h54m-6-5 6 5-6 5" />
                                </svg>
                            )}
                            <div class="ostep">
                                <span class="ico">
                                    <svg viewBox="0 0 24 24" set:html={s.i} />
                                </span>
                                <span class="t">{s.t}</span>
                            </div>
                        </>
                    ))}
                </div>
            </div>
        ))
    }
</div>

<style>
    .ptp {
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        gap: 2.4cqw;
        padding: 4cqw;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: url("/images/smn/grid.png") center / cover;
    }
    .line {
        display: grid;
        grid-template-columns: 22cqw 1fr;
        align-items: center;
        gap: 3cqw;
    }
    .line + .line {
        padding-top: 2.4cqw;
        border-top: 1px dashed var(--border);
    }
    .k {
        font: 500 2cqw/1.25 var(--serif);
        color: var(--ink);
    }
    .note {
        margin-top: 0.5cqw;
        font: 400 1.45cqw/1.35 var(--sans);
        color: var(--label);
    }
    .flow {
        display: flex;
        align-items: center;
        gap: 1.6cqw;
    }
    .ostep {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 1.4cqw;
        min-width: 0;
        padding: 1.6cqw 1.8cqw;
        border-radius: 4px;
        background: #fff;
        box-shadow:
            0 0 0 0.45cqw #fff,
            0 0 0 calc(0.45cqw + 1px) var(--border);
    }
    .ico {
        flex: none;
        display: grid;
        place-items: center;
        width: 3.6cqw;
        height: 3.6cqw;
        border-radius: 50%;
        box-shadow: inset 0 0 0 1.2px var(--ink);
    }
    .ico svg {
        width: 1.8cqw;
        height: 1.8cqw;
        fill: none;
        stroke: var(--ink);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .t {
        font: 400 1.6cqw/1.3 var(--para);
        color: var(--ink);
    }
    .arr {
        flex: none;
        width: 3cqw;
        fill: none;
        stroke: #a3a7ad;
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    /* today's model reads quieter; the opportunity is in full ink */
    .muted .k,
    .muted .t {
        color: var(--label);
    }
    .muted .ostep {
        background: #f4f3ef;
        box-shadow:
            0 0 0 0.45cqw #f4f3ef,
            0 0 0 calc(0.45cqw + 1px) var(--border);
    }
    .muted .ico {
        box-shadow: inset 0 0 0 1.2px var(--label);
    }
    .muted .ico svg {
        stroke: var(--label);
    }
    .muted .flow {
        width: 66%;
    }
    @media (max-width: 809.98px) {
        .line {
            grid-template-columns: 1fr;
            gap: 2.6cqw;
        }
        .muted .flow {
            width: 66%;
        }
        .k {
            font-size: 3.6cqw;
        }
        .note {
            font-size: 2.8cqw;
        }
        .ostep {
            flex-direction: column;
            text-align: center;
            gap: 1.6cqw;
            padding: 2.4cqw 1.4cqw;
        }
        .ico {
            width: 6cqw;
            height: 6cqw;
        }
        .ico svg {
            width: 3cqw;
            height: 3cqw;
        }
        .t {
            font-size: 2.8cqw;
        }
        .arr {
            width: 4cqw;
        }
    }
</style>
