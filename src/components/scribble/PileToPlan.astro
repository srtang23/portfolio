---
// Opportunity: three stages left to right, each with a title and a grey caption above a framed
// tile, joined by thin arrows: a pile of goals → a conversation → a clear plan.
const heap = ["Change careers", "Learn to code", "Update resume", "Grow my network", "Get certified", "Ask for the raise", "Finish the degree"]
const rnd = (i: number, k: number) => {
    const v = Math.sin((i + 1) * 12.9898 + k * 78.233) * 43758.5453
    return v - Math.floor(v)
}
const steps = ["List three roles that interest you", "Message one person in that field", "Pick one skill to learn first"]
---

<div class="ptp" role="img" aria-label="From pile to plan: scattered goals, a conversation that clarifies one of them, and a short plan with a suggested first step.">
    <div class="stage">
        <p class="st">Scattered goals</p>
        <p class="sc">Everything feels urgent</p>
        <div class="tile heap" aria-hidden="true">
            {
                heap.map((t, i) => (
                    <span class="chip" style={`left:${4 + (i % 2) * 30 + (rnd(i, 1) - 0.5) * 14}%;top:${8 + i * 12 + (rnd(i, 2) - 0.5) * 4}%;transform:rotate(${((rnd(i, 3) - 0.5) * 26).toFixed(1)}deg)`}>
                        <b />
                        {t}
                    </span>
                ))
            }
        </div>
    </div>
    <svg class="arr" viewBox="0 0 60 12" aria-hidden="true"><path d="M2 6h54m-6-5 6 5-6 5" /></svg>
    <div class="stage">
        <p class="st">Conversation</p>
        <p class="sc">Talk it through</p>
        <div class="tile chat" aria-hidden="true">
            <span class="bubble me">I want to change careers but don’t know where to start.</span>
            <span class="bubble ai">What kind of work keeps catching your interest?</span>
            <span class="bubble me">Something more creative, maybe design.</span>
        </div>
    </div>
    <svg class="arr" viewBox="0 0 60 12" aria-hidden="true"><path d="M2 6h54m-6-5 6 5-6 5" /></svg>
    <div class="stage">
        <p class="st">Clear plan</p>
        <p class="sc">With a place to start</p>
        <div class="tile plan" aria-hidden="true">
            <p class="goal">Change careers</p>
            <ol>
                {
                    steps.map((s, i) => (
                        <li class:list={{ first: i === 0 }}>
                            <b />
                            <span>{s}</span>
                        </li>
                    ))
                }
            </ol>
            <span class="start">Start here</span>
        </div>
    </div>
</div>

<style>
    .ptp {
        position: relative;
        container-type: inline-size;
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 2cqw;
        padding: 4cqw 3cqw 4.5cqw;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: url("/images/smn/grid.png") center / cover;
    }
    .stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-width: 0;
    }
    .st {
        font: 500 2cqw/1.25 var(--serif);
        color: var(--ink);
    }
    .sc {
        margin: 0.4cqw 0 2.4cqw;
        font: 400 1.5cqw/1.3 var(--sans);
        color: var(--label);
    }
    .arr {
        width: 4.5cqw;
        margin-top: 5cqw;
        fill: none;
        stroke: #a3a7ad;
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    /* each stage sits in a white framed tile, like the reference's thick white cards */
    .tile {
        position: relative;
        width: 100%;
        aspect-ratio: 0.95;
        border-radius: 4px;
        background: #fff;
        box-shadow:
            0 0 0 0.6cqw #fff,
            0 0 0 calc(0.6cqw + 1px) var(--border),
            0 1cqw 2.5cqw rgba(22, 21, 15, 0.06);
        overflow: hidden;
        text-align: left;
    }
    /* stage 1 */
    .heap {
        background: #f4f3ef;
    }
    .chip {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.7cqw;
        padding: 0.7cqw 1cqw;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
        box-shadow: 0 0.2cqw 0.6cqw rgba(22, 21, 15, 0.06);
        font: 400 1.3cqw/1.2 var(--para);
        color: var(--ink);
        white-space: nowrap;
    }
    .chip b,
    .plan li b {
        flex: none;
        width: 1.1cqw;
        height: 1.1cqw;
        border-radius: 0.25cqw;
        box-shadow: inset 0 0 0 1.1px var(--ink);
    }
    /* stage 2 */
    .chat {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1cqw;
        padding: 2cqw;
        background: #f4f3ef;
    }
    .bubble {
        max-width: 85%;
        padding: 1cqw 1.3cqw;
        font: 400 1.3cqw/1.35 var(--para);
        border-radius: 1.4cqw;
    }
    .bubble.me {
        align-self: flex-end;
        background: var(--ink);
        color: #fff;
        border-bottom-right-radius: 0.3cqw;
    }
    .bubble.ai {
        align-self: flex-start;
        background: #fff;
        color: var(--ink);
        border: 1px solid var(--border);
        border-bottom-left-radius: 0.3cqw;
    }
    /* stage 3 */
    .plan {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2.4cqw;
    }
    .goal {
        font: 500 1.8cqw/1.25 var(--serif);
        color: var(--ink);
        margin-bottom: 1.4cqw;
    }
    .plan ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1.1cqw;
    }
    .plan li {
        display: flex;
        align-items: flex-start;
        gap: 0.9cqw;
        font: 400 1.35cqw/1.3 var(--para);
        color: var(--label);
    }
    .plan li b {
        margin-top: 0.15cqw;
    }
    .plan li.first {
        color: var(--ink);
    }
    .start {
        align-self: flex-start;
        margin-top: 1.6cqw;
        padding: 0.5cqw 1cqw;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font: normal 500 1.15cqw/1 var(--sans);
    }
    /* phones: keep the three stages in a row, with slightly larger type */
    @media (max-width: 809.98px) {
        .ptp {
            gap: 1.2cqw;
            padding: 5cqw 2.5cqw 5.5cqw;
        }
        .st {
            font-size: 3.2cqw;
        }
        .sc {
            font-size: 2.4cqw;
            margin-bottom: 3cqw;
        }
        .arr {
            width: 3.5cqw;
        }
        .tile {
            aspect-ratio: 0.72;
        }
        .chip {
            font-size: 1.9cqw;
            padding: 0.6cqw 0.8cqw;
        }
        .bubble,
        .plan li {
            font-size: 1.9cqw;
        }
        .goal {
            font-size: 2.5cqw;
        }
        .start {
            font-size: 1.8cqw;
        }
    }
</style>
