---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Card hover" noindex>
    <script is:inline>
        document.documentElement.dataset.h = new URLSearchParams(location.search).get("h") || "a"
    </script>
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear>{headline.join(" ")}</h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                            <span class="hv-pill" aria-hidden="true">View case study <span>→</span></span>
                                        </div>
                                        <div class="caption">
                                            <h2 class="name">{p.descriptor}<span class="hv-arrow" aria-hidden="true"> →</span></h2>
                                            <p class="line">{p.blurb}</p>
                                        </div>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
    <nav class="switch" aria-label="Hover style">
        <a href="?h=a">A · Lift</a>
        <a href="?h=b">B · Tilt</a>
        <a href="?h=c">C · Label</a>
        <a href="?h=d">D · Arrow</a>
        <a href="?h=now">Current</a>
    </nav>
</Base>

<style is:global>
    .switch{position:fixed;z-index:60;left:50%;bottom:1.25rem;transform:translateX(-50%);display:flex;gap:.25rem;padding:.25rem;border-radius:999px;background:rgba(17,17,17,.88)}
    .switch a{padding:.5rem .875rem;border-radius:999px;color:rgba(255,255,255,.72);font:500 .75rem/1 var(--sans);white-space:nowrap}
    html[data-h="a"] .switch a[href="?h=a"],html[data-h="b"] .switch a[href="?h=b"],html[data-h="c"] .switch a[href="?h=c"],html[data-h="d"] .switch a[href="?h=d"],html[data-h="now"] .switch a[href="?h=now"]{background:#fff;color:#111}

    .hv-pill,.hv-arrow{display:none}
    /* turn off the current hover for the new variants */
    html:not([data-h="now"]) .card:hover .thumb img{transform:scale(1.001)}
    html:not([data-h="now"]) .card:hover .name{text-decoration:none}

    /* A: lift. The card rises and a soft shadow appears under the image */
    html[data-h="a"] .card .thumb{transition:transform .6s var(--spring),box-shadow .6s var(--spring)}
    html[data-h="a"] .card:hover .thumb{transform:translateY(-.375rem);box-shadow:0 1.5rem 2.5rem -1.5rem rgba(17,30,60,.35)}

    /* B: tilt. The image tilts gently toward the cursor */
    html[data-h="b"] .grid{perspective:1200px}
    html[data-h="b"] .card .thumb{transition:transform .5s var(--spring);transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transform-style:preserve-3d}
    html[data-h="b"] .card:hover .thumb{transition:transform .12s linear}

    /* C: label. The image dims a touch and a frosted pill slides up */
    html[data-h="c"] .thumb{position:relative}
    html[data-h="c"] .thumb img{transition:filter .5s ease,transform .9s var(--spring)}
    html[data-h="c"] .card:hover .thumb img{filter:brightness(.92)}
    html[data-h="c"] .hv-pill{display:flex;gap:.375rem;align-items:center;position:absolute;left:.875rem;bottom:.875rem;height:2.25rem;padding:0 1rem;border-radius:999px;background:rgba(247,249,252,.78);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font:400 .8125rem/1 var(--sans);color:var(--ink);opacity:0;transform:translateY(.5rem);transition:opacity .35s ease,transform .5s var(--spring)}
    html[data-h="c"] .card:hover .hv-pill{opacity:1;transform:none}

    /* D: arrow. An arrow slides in after the title, and the corners soften */
    html[data-h="d"] .thumb{transition:border-radius .5s var(--spring)}
    html[data-h="d"] .card:hover .thumb{border-radius:1.25rem}
    html[data-h="d"] .hv-arrow{display:inline-block;opacity:0;transform:translateX(-.375rem);transition:opacity .3s ease,transform .5s var(--spring);color:var(--accent)}
    html[data-h="d"] .card:hover .hv-arrow{opacity:1;transform:none}
</style>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    .lede {
        max-width: 44rem;
        font: 400 1.25rem/1.5 var(--sans);
        color: var(--body);
    }

    /* Entrance: the clouds gather over plain paper, then the words settle on top,
       and the nav arrives last */
    .headline {
        animation: enter-up 1.2s var(--spring) both 1s;
    }
    .lede {
        animation: enter-up 1.2s var(--spring) both 1.25s;
    }
    :global(.sky) {
        animation: enter-sky 2s ease both;
    }
    :global(.top-nav .pill) {
        animation: enter-fade 1s ease both 1.6s;
    }
    @keyframes enter-sky {
        from {
            opacity: 0;
            transform: scale(1.08);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
    @keyframes enter-fade {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* Same edges as the nav and the case studies (--gutter) */
    .work {
        padding: 1rem var(--gutter) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    /* a descriptor, then a one-line summary */
    .caption {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 0.375rem;
    }
    .name {
        font: 400 1.25rem/1.3 var(--sans);
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .line {
        font: 400 0.9375rem/1.45 var(--sans);
        letter-spacing: 0.005em;
        color: var(--body);
    }
    .card:hover .name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--border);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .headline,
        .lede,
        :global(.sky),
        :global(.top-nav .pill) {
            animation: none;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1.125rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 1rem;
        }
        .work {
            padding: 0 var(--gutter) 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>

<script>
    // B: tilt toward the cursor
    if (document.documentElement.dataset.h === "b") {
        for (const card of document.querySelectorAll<HTMLElement>(".card")) {
            const t = card.querySelector<HTMLElement>(".thumb")!
            card.addEventListener("pointermove", (e) => {
                const r = t.getBoundingClientRect()
                const x = (e.clientX - r.left) / r.width - 0.5
                const y = (e.clientY - r.top) / r.height - 0.5
                t.style.setProperty("--ry", `${x * 8}deg`)
                t.style.setProperty("--rx", `${-y * 8}deg`)
            })
            card.addEventListener("pointerleave", () => {
                t.style.setProperty("--ry", "0deg")
                t.style.setProperty("--rx", "0deg")
            })
        }
    }
</script>
