---
/*
 * Triple-diamond process diagram on the grid-paper panel.
 * Dark milestones sit where the diamonds meet; each diamond is split into two halves;
 * hovering (or tapping) a milestone or half lights up its column and reveals a dashed
 * line down to a short line of text. Drawn in a 1000-wide coordinate space; the small
 * text and the hover targets are HTML so they stay crisp and focusable.
 */
const CY = 185 // vertical centre of the diamonds
const H = 156 // half-size of a big diamond
const M = 53 // half-size of a milestone diamond
const DOT = 385 // where the drop-lines end
const centers = [188, 500, 812]
const phases = ["Research", "Experiment", "Strategy"]
const halves = [
    ["Investigate", "Synthesize"],
    ["Explore", "Evaluate"],
    ["Refine", "Prioritize"],
]
const milestones = ["Brief", "Hypotheses", "P.O.C.", "Pitch"]

// Ten evenly spaced columns: milestone, left half, right half, milestone, ...
const cols = [
    { x: 32, kind: "m", t: "Align on goals" },
    { x: 136, kind: "h", t: "8 in-home interviews" },
    { x: 240, kind: "h", t: "Uncover behavioral tensions" },
    { x: 344, kind: "m", t: "Form opportunity hypotheses" },
    { x: 448, kind: "h", t: "Explore design directions" },
    { x: 552, kind: "h", t: "Challenge assumptions with consumers" },
    { x: 656, kind: "m", t: "Identify promising concepts" },
    { x: 760, kind: "h", t: "Refine through feedback" },
    { x: 864, kind: "h", t: "Define strategic opportunities" },
    { x: 968, kind: "m", t: "Present proposed directions to P&G" },
]
const mx = [32, 344, 656, 968]
const labels = [milestones[0], ...halves[0], milestones[1], ...halves[1], milestones[2], ...halves[2], milestones[3]]
const VB_X = -50
const VB_W = 1100
const pct = (x: number) => ((x - VB_X) / VB_W) * 100
---

<div class="process">
    <div class="canvas" data-process>
        <div class="stage">
        <svg viewBox={`${VB_X} -12 ${VB_W} ${DOT + 22}`} role="img" aria-labelledby="process-desc">
            <desc id="process-desc">
                Process in three phases. Research: investigate and synthesize, from the brief to hypotheses. Experiment: explore and evaluate, from hypotheses to a proof of concept.
                Strategy: refine and prioritize, from the proof of concept to the pitch to P&amp;G.
            </desc>

            <!-- drop-lines (drawn first, so the diamonds sit on top) -->
            {
                cols.map((c, i) => (
                    <g class="drop" data-i={i}>
                        <line x1={c.x} y1={c.kind === "m" ? CY + M + 6 : CY + 24} x2={c.x} y2={DOT} />
                        <circle cx={c.x} cy={DOT} r="3.5" />
                    </g>
                ))
            }

            {
                centers.map((cx, i) => (
                    <g>
                        <text class="phase-n" x={cx} y="5">{`0${i + 1}`}</text>
                        <text class="phase-t" x={cx} y="20">
                            {phases[i]}
                        </text>
                        <polygon class="big" points={`${cx - H},${CY} ${cx},${CY - H} ${cx + H},${CY} ${cx},${CY + H}`} />
                        <line class="mid" x1={cx} y1={CY - H} x2={cx} y2={CY + H} />
                        <line class="arr" x1={cx - 48} y1={CY - 66} x2={cx + 48} y2={CY - 66} />
                        <polyline class="arr" points={`${cx + 40},${CY - 71} ${cx + 48},${CY - 66} ${cx + 40},${CY - 61}`} />
                        <circle class="arr-dot" cx={cx - 48} cy={CY - 66} r="3" />
                        <line class="arr" x1={cx + 48} y1={CY + 66} x2={cx - 48} y2={CY + 66} />
                        <polyline class="arr" points={`${cx - 40},${CY + 61} ${cx - 48},${CY + 66} ${cx - 40},${CY + 71}`} />
                        <circle class="arr-dot" cx={cx + 48} cy={CY + 66} r="3" />
                        <text class="half" data-i={i * 3 + 1} x={cx - 52} y={CY + 6}>
                            {halves[i][0]}
                        </text>
                        <text class="half" data-i={i * 3 + 2} x={cx + 52} y={CY + 6}>
                            {halves[i][1]}
                        </text>
                    </g>
                ))
            }

            {
                mx.map((x, i) => (
                    <g class="ms-g" data-i={i * 3}>
                        <polygon class="ms" points={`${x - M},${CY} ${x},${CY - M} ${x + M},${CY} ${x},${CY + M}`} />
                        <text class="ms-t" x={x} y={CY + 4}>
                            {milestones[i]}
                        </text>
                    </g>
                ))
            }
        </svg>

        <div class="steps" aria-hidden="true">
            {
                cols.map((c, i) => (
                    <p data-i={i} style={`left:${pct(c.x)}%`}>
                        {c.t}
                    </p>
                ))
            }
            <p class="hint"><span class="mouse">Hover over</span><span class="touch">Tap</span> a step to see what we did</p>
        </div>

        <!-- one invisible hover/focus target per column -->
        <div class="hits">
            {
                cols.map((c, i) => (
                    <button type="button" data-i={i} style={`left:${pct(c.x - 52)}%`} aria-label={`${labels[i]}: ${c.t}`} />
                ))
            }
        </div>
        </div>
    </div>
</div>

<style>
    .process {
        position: relative;
        width: 100%;
        overflow-x: auto;
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
        box-shadow: inset 0 0 0 1px var(--border);
    }
    .canvas {
        min-width: 42rem;
        padding: 2.75rem 1.5rem 2.5rem;
    }
    svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }
    .big {
        fill: #fff;
        stroke: #cfcfcf;
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    .mid {
        stroke: #d9d9d9;
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    .arr {
        fill: none;
        stroke: #cdcdcd;
        stroke-width: 1.25;
        vector-effect: non-scaling-stroke;
    }
    .arr-dot {
        fill: #cdcdcd;
    }
    .drop line {
        stroke: rgba(17, 17, 17, 0.22);
        stroke-width: 1;
        stroke-dasharray: 3 4;
        vector-effect: non-scaling-stroke;
    }
    .drop circle {
        fill: rgba(17, 17, 17, 0.35);
    }
    .half {
        font: 500 19px var(--serif);
        letter-spacing: -0.01em;
        fill: var(--ink);
        text-anchor: middle;
    }
    .phase-t {
        font: 500 17px var(--serif);
        fill: var(--ink);
        text-anchor: middle;
    }
    .phase-n {
        font: 400 12px var(--sans);
        fill: var(--label);
        text-anchor: middle;
    }
    .ms {
        fill: var(--ink);
    }
    .ms-t {
        font: 400 11px var(--serif);
        fill: #fff;
        text-anchor: middle;
    }

    .steps {
        position: relative;
        height: 4.25rem;
        margin-top: 0.625rem;
    }
    .steps p {
        position: absolute;
        top: 0;
        width: 9%;
        transform: translateX(-50%);
        font: 400 0.6875rem/1.35 var(--sans);
        letter-spacing: 0.01em;
        color: var(--body);
        text-align: center;
    }


    /* Hover reveal */
    .stage {
        position: relative;
    }
    .drop {
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .steps p:not(.hint) {
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .hint {
        left: 50% !important;
        width: auto !important;
        white-space: nowrap;
        color: var(--label) !important;
        transition: opacity 0.25s ease;
    }
    .half,
    .ms {
        transition: fill 0.2s ease;
    }
    .hits button {
        position: absolute;
        top: 0;
        bottom: 0;
        width: calc(104 / 1100 * 100%);
        padding: 0;
        border: 0;
        background: transparent;
        cursor: default;
        transition: background-color 0.25s ease;
    }
    .hits button:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: -1px;
    }
    .hits button.on {
        background: rgba(92, 122, 242, 0.06);
    }
    .drop.on,
    .steps p.on {
        opacity: 1;
    }
    .half.on {
        fill: var(--accent);
    }
    .ms-g.on .ms {
        fill: var(--accent);
    }
    [data-active] .hint {
        opacity: 0;
    }
    .hint .touch {
        display: none;
    }
    @media (hover: none) {
        .hint .mouse {
            display: none;
        }
        .hint .touch {
            display: inline;
        }
    }

</style>

<script>
    for (const canvas of document.querySelectorAll<HTMLElement>("[data-process]")) {
        const parts = [...canvas.querySelectorAll<Element>("[data-i]")]
        const set = (i: string | null) => {
            if (i === null) delete canvas.dataset.active
            else canvas.dataset.active = i
            parts.forEach((el) => el.classList.toggle("on", el.getAttribute("data-i") === i))
        }
        for (const b of canvas.querySelectorAll<HTMLButtonElement>(".hits button")) {
            b.addEventListener("pointerenter", () => set(b.dataset.i!))
            b.addEventListener("focus", () => set(b.dataset.i!))
            b.addEventListener("click", () => set(b.dataset.i!)) // tap on touch screens
            b.addEventListener("blur", () => set(null))
        }
        canvas.addEventListener("pointerleave", () => {
            if (!canvas.contains(document.activeElement)) set(null)
        })
    }
</script>
