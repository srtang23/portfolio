---
// The nanny journey: steps handled on the platform, then steps handled off it.
// `look` picks the visual style (for comparing on the preview).
interface Props {
    look?: "outline" | "tint" | "dots" | "accent"
}
const { look = "outline" } = Astro.props
const I = {
    cal: `<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01"/>`,
    search: `<circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/>`,
    users: `<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19c.6-3 2.8-4.6 5.5-4.6s4.9 1.6 5.5 4.6M15.5 5.6a3 3 0 0 1 0 5.8M17.5 14.6c1.6.6 2.6 2 3 4.4"/>`,
    check: `<circle cx="12" cy="12" r="8.5"/><path d="m8.3 12.2 2.5 2.5 5-5"/>`,
    doc: `<path d="M7 3.5h6.5L18 8v12.5H7z"/><path d="M13.5 3.5V8H18M9.5 12.5h6M9.5 16h6"/>`,
    swap: `<path d="M5 9h13m0 0-3.5-3.5M18 9l-3.5 3.5M19 15H6m0 0 3.5-3.5M6 15l3.5 3.5"/>`,
    chat: `<path d="M5 5.5h14v10H10l-4 3.5v-3.5H5z"/>`,
    clip: `<rect x="5.5" y="5" width="13" height="15.5" rx="2"/><path d="M9.5 3.5h5v3h-5zM9 13.3l2 2 4-4"/>`,
}
const on = [
    { i: I.cal, t: "Post availability" },
    { i: I.search, t: "Browse shifts" },
    { i: I.users, t: "Accept a booking" },
    { i: I.check, t: "Get booked" },
]
const off = [
    { i: I.doc, t: "Prepare" },
    { i: I.swap, t: "Manage changes" },
    { i: I.chat, t: "During the session" },
    { i: I.clip, t: "Follow up" },
]
---

<div class:list={["journey-g", look]} role="img" aria-label="Nanny journey: posting availability, browsing shifts, accepting a booking and getting booked happen on the platform; preparing, managing changes, the session itself and following up are handled off the platform.">
    <div class="labels" aria-hidden="true">
        <span class="l-on">On the platform</span>
        <span class="l-off">Handled off the platform</span>
    </div>
    <ol class="row" aria-hidden="true">
        {
            on.map((s) => (
                <li class="step on">
                    <span class="node"><svg viewBox="0 0 24 24" set:html={s.i} /></span>
                    <span class="t">{s.t}</span>
                </li>
            ))
        }
        <li class="split" />
        {
            off.map((s) => (
                <li class="step off">
                    <span class="node"><svg viewBox="0 0 24 24" set:html={s.i} /></span>
                    <span class="t">{s.t}</span>
                </li>
            ))
        }
    </ol>
</div>

<style>
    .journey-g {
        --teal: #3bb3b8;
        --line-on: var(--ink);
        --line-off: #c3c7cc;
        position: relative;
        padding: 0.5rem 0.5rem 0;
    }
    .labels {
        display: grid;
        grid-template-columns: 4fr 0 4fr;
        margin-bottom: 1.25rem;
        font: 400 0.75rem/1.2 var(--sans);
    }
    .l-on {
        justify-self: end;
        padding-right: 0.75rem;
        color: var(--ink);
    }
    .l-off {
        grid-column: 3;
        padding-left: 0.75rem;
        color: var(--label);
    }
    .row {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr) 0 repeat(4, 1fr);
    }
    .step {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.625rem;
        text-align: center;
    }
    /* connecting line through the middle of each node */
    .step::before {
        content: "";
        position: absolute;
        top: 1.375rem;
        left: 0;
        right: 0;
        z-index: 0;
    }
    .step.on::before {
        border-top: 1.5px solid var(--line-on);
    }
    .step.off::before {
        border-top: 1.5px dashed var(--line-off);
    }
    .step.on:first-child::before {
        left: 50%;
    }
    .step.off:last-child::before {
        right: 50%;
    }
    .split {
        position: relative;
    }
    .split::before {
        content: "";
        position: absolute;
        top: -2.25rem;
        bottom: 0.25rem;
        left: 0;
        border-left: 1px dashed var(--accent);
    }
    .split::after {
        content: "";
        position: absolute;
        top: 1.375rem;
        left: 0;
        width: 0.5rem;
        height: 0.5rem;
        margin: -0.25rem 0 0 -0.25rem;
        border-radius: 50%;
        background: var(--accent);
    }
    .node {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
    }
    .node svg {
        width: 1.125rem;
        height: 1.125rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .t {
        max-width: 6rem;
        font: 400 0.75rem/1.3 var(--sans);
    }
    .on .t {
        color: var(--ink);
    }
    .off .t {
        color: var(--label);
    }
    .off .node {
        background: var(--paper);
        box-shadow: inset 0 0 0 1px var(--line-off);
        color: #a3a7ad;
    }

    /* outline: thin grey rings, nothing filled */
    .outline .on .node {
        background: var(--paper);
        box-shadow: inset 0 0 0 1.5px var(--ink);
        color: var(--ink);
    }
    /* tint: soft teal fills, the project colour */
    .tint {
        --line-on: var(--teal);
    }
    .tint .on .node {
        background: #e3f4f4;
        box-shadow: inset 0 0 0 1px #b9e2e3;
        color: #237f83;
    }
    /* dots: no icons, just small dots on the line */
    .dots .node {
        width: 0.75rem;
        height: 0.75rem;
        margin: 1rem 0;
    }
    .dots .node svg {
        display: none;
    }
    .dots .on .node {
        background: var(--ink);
        box-shadow: none;
    }
    .dots .step::before {
        top: 1.375rem;
    }
    /* accent: soft blue fills, the site accent */
    .accent {
        --line-on: var(--accent);
    }
    .accent .on .node {
        background: #eef1fe;
        box-shadow: inset 0 0 0 1px #c9d3fb;
        color: var(--accent);
    }

    @media (max-width: 809.98px) {
        .labels {
            display: none;
        }
        .row {
            grid-template-columns: 1fr;
            row-gap: 0.25rem;
        }
        .step {
            flex-direction: row;
            gap: 0.875rem;
            text-align: left;
            padding: 0.25rem 0;
        }
        .step::before {
            top: 0;
            bottom: 0;
            left: 1.375rem;
            right: auto;
            border-top: 0 !important;
        }
        .step.on::before {
            border-left: 1.5px solid var(--line-on);
        }
        .step.off::before {
            border-left: 1.5px dashed var(--line-off);
        }
        .step.on:first-child::before {
            left: 1.375rem;
            top: 50%;
        }
        .step.off:last-child::before {
            right: auto;
            bottom: 50%;
        }
        .dots .step::before {
            left: 0.375rem;
        }
        .dots .node {
            margin: 0;
        }
        .split {
            height: 1.25rem;
        }
        .split::before {
            top: 50%;
            bottom: auto;
            left: 0;
            right: 0;
            border-left: 0;
            border-top: 1px dashed var(--accent);
        }
        .split::after {
            top: 50%;
            left: 1.375rem;
        }
        .t {
            max-width: none;
            font-size: 0.875rem;
        }
    }
</style>
