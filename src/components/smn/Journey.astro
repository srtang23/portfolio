---
// The nanny journey: steps handled on the platform, then steps handled off it.
interface Props {
    fill?: boolean // the opportunity version: the off-platform half fills in when scrolled into view
}
const { fill = false } = Astro.props
const I = {
    cal: `<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01"/>`,
    search: `<circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/>`,
    users: `<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19c.6-3 2.8-4.6 5.5-4.6s4.9 1.6 5.5 4.6M15.5 5.6a3 3 0 0 1 0 5.8M17.5 14.6c1.6.6 2.6 2 3 4.4"/>`,
    check: `<circle cx="12" cy="12" r="8.5"/><path d="m8.3 12.2 2.5 2.5 5-5"/>`,
    doc: `<path d="M7 3.5h6.5L18 8v12.5H7z"/><path d="M13.5 3.5V8H18M9.5 12.5h6M9.5 16h6"/>`,
    swap: `<path d="M5 9h13m0 0-3.5-3.5M18 9l-3.5 3.5M19 15H6m0 0 3.5-3.5M6 15l3.5 3.5"/>`,
    chat: `<path d="M5 5.5h14v10H10l-4 3.5v-3.5H5z"/>`,
    clip: `<rect x="5.5" y="5" width="13" height="15.5" rx="2"/><path d="M9.5 3.5h5v3h-5zM9 13.3l2 2 4-4"/>`,
}
const on = [
    { i: I.cal, t: "Post availability" },
    { i: I.search, t: "Browse shifts" },
    { i: I.users, t: "Accept a booking" },
    { i: I.check, t: "Get booked" },
]
const off = [
    { i: I.doc, t: "Prepare" },
    { i: I.swap, t: "Manage changes" },
    { i: I.chat, t: "During the session" },
    { i: I.clip, t: "Follow up" },
]
---

<div
    class:list={["journey-g", { fill }]}
    data-journey-fill={fill ? "" : undefined}
    role="img"
    aria-label={fill
        ? "The opportunity: every step of the nanny journey, from posting availability to following up after a session, connected on one platform."
        : "Nanny journey: posting availability, browsing shifts, accepting a booking and getting booked happen on the platform; preparing, managing changes, the session itself and following up are handled off the platform."}
>
    <div class="labels" aria-hidden="true">
        <span class="l-on">On the platform</span>
        <span class="l-off">Handled off the platform</span>
        {fill && <span class="l-all">All in one place</span>}
    </div>
    <ol class="row" aria-hidden="true">
        {
            on.map((s) => (
                <li class="step on">
                    <span class="node"><svg viewBox="0 0 24 24" set:html={s.i} /></span>
                    <span class="t">{s.t}</span>
                </li>
            ))
        }
        <li class="split" />
        {
            off.map((s, i) => (
                <li class="step off" style={`--i:${i}`}>
                    <span class="node"><svg viewBox="0 0 24 24" set:html={s.i} /></span>
                    <span class="t">{s.t}</span>
                </li>
            ))
        }
    </ol>
</div>

<style>
    /* everything in the SMN teal: solid and filled on the platform, pale and dashed off it */
    .journey-g {
        --teal: #3bb3b8;
        --teal-ink: #237f83;
        --teal-fill: #e3f4f4;
        --teal-ring: #b9e2e3;
        --teal-pale: #8fcbcd;
        position: relative;
        max-width: 36rem;
        margin: 0 auto;
        padding: 0.5rem 0 0;
    }
    .labels {
        display: grid;
        grid-template-columns: 4fr 0 4fr;
        margin-bottom: 0.875rem;
        font: 400 12px/1.2 var(--sans);
        letter-spacing: 0.01em;
    }
    .l-on {
        justify-self: end;
        padding-right: 0.75rem;
        color: var(--teal-ink);
    }
    .l-off {
        grid-column: 3;
        padding-left: 0.75rem;
        color: var(--teal-pale);
    }
    .row {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr) 0 repeat(4, 1fr);
    }
    .step {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-align: center;
        min-width: 0;
    }
    /* connecting line through the middle of each node */
    .step::before {
        content: "";
        position: absolute;
        top: 0.9375rem;
        left: 0;
        right: 0;
        z-index: 0;
    }
    .step.on::before {
        border-top: 1.5px solid var(--teal);
    }
    .step.off::before {
        border-top: 1.5px dashed var(--teal-ring);
    }
    .step.on:first-child::before {
        left: 50%;
    }
    .step.off:last-child::before {
        right: 50%;
    }
    .split {
        position: relative;
    }
    .split::before {
        content: "";
        position: absolute;
        top: -2.25rem;
        bottom: 0.25rem;
        left: 0;
        border-left: 1px dashed var(--teal);
    }
    .split::after {
        content: "";
        position: absolute;
        top: 0.9375rem;
        left: 0;
        width: 0.5rem;
        height: 0.5rem;
        margin: -0.25rem 0 0 -0.25rem;
        border-radius: 50%;
        background: var(--teal);
    }
    .node {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 1.875rem;
        height: 1.875rem;
        border-radius: 50%;
    }
    .node svg {
        width: 0.875rem;
        height: 0.875rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .on .node {
        background: var(--teal-fill);
        box-shadow: inset 0 0 0 1px var(--teal-ring);
        color: var(--teal-ink);
    }
    .off .node {
        background: var(--paper);
        box-shadow: inset 0 0 0 1px var(--teal-ring);
        color: var(--teal-pale);
    }
    .t {
        padding: 0 0.25rem;
        font: 400 12px/1.35 var(--sans);
        text-wrap: balance;
    }
    .on .t {
        color: var(--teal-ink);
    }
    .off .t {
        color: var(--teal-pale);
    }

    @media (max-width: 809.98px) {
        .labels {
            display: none;
        }
        .row {
            grid-template-columns: 1fr;
            row-gap: 0; /* spacing comes from step padding, so the line runs unbroken */
        }
        .step {
            flex-direction: row;
            gap: 0.875rem;
            text-align: left;
            padding: 0.375rem 0;
        }
        .step::before {
            top: 0;
            bottom: 0;
            left: 0.9375rem;
            right: auto;
            border-top: 0 !important;
        }
        .step.on::before {
            border-left: 1.5px solid var(--teal);
        }
        .step.off::before {
            border-left: 1.5px dashed var(--teal-ring);
        }
        .step.on:first-child::before {
            top: 50%;
            left: 0.9375rem;
        }
        .step.off:last-child::before {
            right: auto;
            bottom: 50%;
        }
        .split {
            height: 1.25rem;
        }
        .split::before {
            top: 50%;
            bottom: auto;
            left: 0;
            right: 0;
            border-left: 0;
            border-top: 1px dashed var(--teal);
        }
        .split::after {
            top: 50%;
            left: 0.9375rem;
        }
        /* the line also runs through the gap between the two halves */
        .split {
            border-left: 1.5px dashed var(--teal-ring);
            margin-left: 0.9375rem;
            width: 0;
        }
        .split::before {
            left: -0.9375rem;
            width: 18rem;
        }
        .split::after {
            left: 0;
        }
        .fill.filled .split {
            border-left-style: solid;
            border-left-color: var(--teal);
            transition: border-color 0.3s ease 0.3s;
        }
        .t {
            padding: 0;
            font-size: 0.875rem;
        }
    }
    /* ---- fill: the off-platform half joins the line, step by step ---- */
    .labels {
        position: relative;
    }
    .l-all {
        position: absolute;
        left: 0;
        right: 0;
        text-align: center;
        color: var(--teal-ink);
        opacity: 0;
    }
    .fill .step.off::after {
        content: "";
        position: absolute;
        top: 0.9375rem;
        left: 0;
        right: 0;
        z-index: 0;
        border-top: 1.5px solid var(--teal);
        transform: scaleX(0);
        transform-origin: left;
    }
    .fill .step.off:last-child::after {
        right: 50%;
    }
    .fill.filled .step.off::after {
        transform: scaleX(1);
        transition: transform 0.35s ease calc(0.4s + var(--i) * 0.35s);
    }
    .fill.filled .step.off::before {
        opacity: 0;
        transition: opacity 0.2s ease calc(0.55s + var(--i) * 0.35s);
    }
    .fill.filled .step.off .node {
        background: var(--teal-fill);
        color: var(--teal-ink);
        transition:
            background 0.3s ease calc(0.55s + var(--i) * 0.35s),
            color 0.3s ease calc(0.55s + var(--i) * 0.35s);
    }
    .fill.filled .step.off .t {
        color: var(--teal-ink);
        transition: color 0.3s ease calc(0.55s + var(--i) * 0.35s);
    }
    .fill .split::before,
    .fill .l-on,
    .fill .l-off {
        transition: opacity 0.4s ease;
    }
    .fill.filled .split::before,
    .fill.filled .split::after,
    .fill.filled .l-on,
    .fill.filled .l-off {
        opacity: 0;
        transition: opacity 0.4s ease 0.1s;
    }
    .fill.filled .l-all {
        opacity: 1;
        transition: opacity 0.5s ease 1.9s;
    }
    @media (prefers-reduced-motion: reduce) {
        .fill.filled *,
        .fill.filled *::before,
        .fill.filled *::after {
            transition: none !important;
        }
    }
    @media (max-width: 809.98px) {
        .fill .step.off::after {
            top: 0;
            bottom: 0;
            left: 0.9375rem;
            right: auto;
            border-top: 0;
            border-left: 1.5px solid var(--teal);
            transform: scaleY(0);
            transform-origin: top;
        }
        .fill .step.off:last-child::after {
            bottom: 50%;
        }
        .fill.filled .step.off::after {
            transform: scaleY(1);
        }
    }
</style>

<script>
    // The opportunity journey fills in once, when it is mostly in view.
    const io = new IntersectionObserver(
        (entries) => {
            for (const e of entries) {
                if (e.isIntersecting) {
                    e.target.classList.add("filled")
                    io.unobserve(e.target)
                }
            }
        },
        { threshold: 0.6 },
    )
    document.querySelectorAll("[data-journey-fill]").forEach((el) => io.observe(el))
</script>

