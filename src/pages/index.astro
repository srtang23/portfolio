---
import Base from "../layouts/Base.astro"
import { projects } from "../data/projects"
import HalftoneSky from "../components/HalftoneSky.astro"

// Big card, small card, small card, big card: a 2/3 + 1/3 grid that alternates by row.
const wide = [true, false, false, true]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Sophia Tang · Product Designer">
    <HalftoneSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear aria-label={headline.join(" ")}>
                {
                    headline.map((w, i) => (
                        <span class="word" aria-hidden="true" style={`--i:${i}`}>
                            <span>{w}</span>
                        </span>
                    ))
                }
            </h1>
            <p class="lede" data-sky-clear>
                I’m Sophia, designing experiences grounded in research and systems thinking, from first insight to a shipped, considered product.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-labelledby="work-h">
            <h2 id="work-h" class="work-h reveal">Selected work</h2>
            <div class="grid">
                {
                    projects.map((p, i) => (
                        <a class:list={["card", "rise", { wide: wide[i % wide.length] }]} href={p.href} style={`--d:${(i % 2) * 0.08}s`}>
                            <div class="thumb">
                                <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                <span class="go" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M7 17 17 7M8 7h9v9" />
                                    </svg>
                                </span>
                            </div>
                            <ul class="tags" aria-label="Tags">
                                {p.tags.map((t) => (
                                    <li>{t}</li>
                                ))}
                            </ul>
                            <h3 class="outcome">{p.outcome}</h3>
                            <p class="subtitle">{p.subtitle}</p>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>
</Base>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 62rem;
        font: italic 400 7.25rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    /* each word rises out of a mask */
    .word {
        display: inline-block;
        overflow: hidden;
        padding: 0 0.06em 0.12em;
        margin-bottom: -0.12em;
        vertical-align: top;
    }
    .word > span {
        display: inline-block;
        transform: translateY(105%);
        animation: rise 1.1s var(--spring) forwards;
        animation-delay: calc(0.15s + var(--i) * 0.07s);
    }
    @keyframes rise {
        to {
            transform: none;
        }
    }
    .lede {
        max-width: 38rem;
        font: 400 1.25rem/1.5 var(--sans);
        color: var(--ink-2);
        opacity: 0;
        animation: fade 1s ease forwards 0.75s;
    }
    @keyframes fade {
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    .work {
        max-width: 85rem;
        margin: 0 auto;
        padding: 2rem 3rem 9rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
    .work-h {
        font: 500 2rem/1.1 var(--sans);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4rem 1.25rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .card.wide {
        grid-column: span 2;
    }
    .thumb {
        position: relative;
        height: 28rem;
        border-radius: 1.25rem;
        overflow: hidden;
        background: #eceae4;
        margin-bottom: 0.5rem;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.04);
    }
    .go {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 2.75rem;
        height: 2.75rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--ink);
        color: #fff;
        transition:
            transform 0.5s var(--spring),
            background-color 0.3s ease;
    }
    .go svg {
        width: 1.125rem;
        height: 1.125rem;
    }
    .card:hover .go {
        transform: rotate(45deg) scale(1.08);
        background: var(--accent);
    }
    .tags {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }
    .tags li {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        background: rgba(17, 17, 17, 0.06);
        font: 500 0.75rem/1.3 var(--sans);
        color: var(--ink-2);
    }
    .outcome {
        max-width: 34rem;
        font: 500 1.75rem/1.2 var(--sans);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .subtitle {
        font: 400 0.9375rem/1.4 var(--sans);
        color: var(--label);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .word > span,
        .lede {
            animation: none;
            transform: none;
            opacity: 1;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 5rem;
        }
        .lede {
            font-size: 1.125rem;
        }
        .work {
            padding: 1rem 2rem 7rem;
        }
        .grid {
            grid-template-columns: 1fr 1fr;
            gap: 3rem 1rem;
        }
        .card.wide {
            grid-column: span 2;
        }
        .thumb {
            height: 24rem;
        }
        .outcome {
            font-size: 1.5rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 3.25rem;
        }
        .lede {
            font-size: 1rem;
        }
        .work {
            padding: 0 1.25rem 6rem;
            gap: 1.75rem;
        }
        .work-h {
            font-size: 1.625rem;
        }
        .grid {
            grid-template-columns: 1fr;
            gap: 2.75rem;
        }
        .card.wide {
            grid-column: auto;
        }
        .thumb {
            height: auto;
            aspect-ratio: 1.25;
            border-radius: 1rem;
        }
        .go {
            width: 2.25rem;
            height: 2.25rem;
            top: 0.75rem;
            right: 0.75rem;
        }
        .outcome {
            font-size: 1.375rem;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>
