---
import Base from "../../layouts/Base.astro"
import { projects } from "../../data/projects"
import StippleSky from "../../components/StippleSky.astro"
import { links } from "../../data/projects"

// Big card, small card, small card, big card: a 2/3 + 1/3 grid that alternates by row.
const wide = [true, false, false, true]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Preview · Nav options" noindex nav="none">
    <StippleSky />

    <!-- A: Pills -->
    <nav class="nv nv-a" data-nav="a" aria-label="Main">
        <div class="pill">
            <a class="logo" href="/" aria-label="Home"><img src="/images/logo.png" alt="" width="30" height="24" /></a>
            <a href="/work">Work</a>
            <a href="/about">About</a>
        </div>
        <div class="right">
            <a class="dark" href={links.resume} target="_blank" rel="noopener noreferrer">Resume</a>
            <a class="round" href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
        </div>
    </nav>

    <!-- B: Split bar -->
    <nav class="nv nv-b" data-nav="b" aria-label="Main" hidden>
        <a class="brand" href="/">
            <img src="/images/logo.png" alt="" width="30" height="24" />
            <span>Sophia Tang</span>
        </a>
        <div class="links">
            <a href="/work">Work</a>
            <a href="/about">About</a>
            <span class="sep" aria-hidden="true"></span>
            <a href={links.resume} target="_blank" rel="noopener noreferrer">Resume ↗</a>
            <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
    </nav>

    <!-- C: Editorial corners -->
    <nav class="nv nv-c" data-nav="c" aria-label="Main" hidden>
        <a class="name" href="/">
            <span class="n1">Sophia Tang</span>
            <span class="n2">Product Designer</span>
        </a>
        <ul class="corner">
            <li><a href="/work"><span>01</span>Work</a></li>
            <li><a href="/about"><span>02</span>About</a></li>
            <li><a href={links.resume} target="_blank" rel="noopener noreferrer"><span>03</span>Resume ↗</a></li>
            <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer"><span>04</span>LinkedIn ↗</a></li>
        </ul>
    </nav>

    <!-- switcher (preview only) -->
    <div class="switch" role="group" aria-label="Nav option">
        <button type="button" data-pick="a" aria-pressed="true">A · Pills</button>
        <button type="button" data-pick="b" aria-pressed="false">B · Split bar</button>
        <button type="button" data-pick="c" aria-pressed="false">C · Editorial</button>
    </div>
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear aria-label={headline.join(" ")}>
                {
                    headline.map((w, i) => (
                        <span class="word" aria-hidden="true" style={`--i:${i}`}>
                            <span>{w}</span>
                        </span>
                    ))
                }
            </h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-labelledby="work-h">
            <h2 id="work-h" class="work-h reveal">Selected work</h2>
            <div class="grid">
                {
                    projects.map((p, i) => (
                        <a class:list={["card", "rise", { wide: wide[i % wide.length] }]} href={p.href} style={`--d:${(i % 2) * 0.08}s`}>
                            <div class="thumb">
                                <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                <span class="go" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M7 17 17 7M8 7h9v9" />
                                    </svg>
                                </span>
                            </div>
                            <ul class="tags" aria-label="Tags">
                                {p.tags.map((t) => (
                                    <li>{t}</li>
                                ))}
                            </ul>
                            <h3 class="outcome">{p.outcome}</h3>
                            <p class="subtitle">{p.subtitle}</p>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>
</Base>

<style>
    /* ---------- Nav options (preview) ---------- */
    .nv {
        position: fixed;
        z-index: 50;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font: 400 0.875rem/1 var(--sans);
        color: var(--ink);
    }
    .nv[hidden] {
        display: none;
    }
    .nv a {
        color: inherit;
    }

    /* A: pills */
    .nv-a {
        padding: 1.5rem 2.5rem;
    }
    .nv-a .pill {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: 3rem;
        padding: 0 1.5rem 0 1.125rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 0 0 1px rgba(17, 17, 17, 0.06), 0 0.5rem 1.5rem -1rem rgba(17, 17, 17, 0.3);
    }
    .nv-a .pill a:not(.logo) {
        transition: opacity 0.2s;
    }
    .nv-a .pill a:not(.logo):hover {
        opacity: 0.55;
    }
    .nv-a .logo img {
        width: 1.875rem;
        height: 1.5rem;
        transition: transform 0.7s var(--spring);
    }
    .nv-a .logo:hover img {
        transform: rotate(360deg);
    }
    .nv-a .right {
        display: flex;
        gap: 0.5rem;
    }
    .nv-a .dark,
    .nv-a .round {
        height: 3rem;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        transition:
            background-color 0.25s,
            transform 0.4s var(--spring);
    }
    .nv-a .dark {
        padding: 0 1.5rem;
    }
    .nv-a .round {
        width: 3rem;
    }
    .nv-a .round svg {
        width: 1.125rem;
        height: 1.125rem;
    }
    .nv-a .dark:hover,
    .nv-a .round:hover {
        background: var(--accent);
    }
    .nv-a .round:hover {
        transform: rotate(45deg);
    }

    /* B: split bar */
    .nv-b {
        padding: 1.25rem 2.5rem;
        background: linear-gradient(rgba(251, 250, 247, 0.92), rgba(251, 250, 247, 0.6));
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(17, 17, 17, 0.06);
    }
    .nv-b .brand {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font: 500 1.0625rem/1 var(--serif);
        letter-spacing: -0.01em;
    }
    .nv-b .brand img {
        width: 1.625rem;
        height: 1.3rem;
    }
    .nv-b .links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        color: var(--ink-2);
    }
    .nv-b .links a {
        position: relative;
    }
    .nv-b .links a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.375rem;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s var(--spring);
    }
    .nv-b .links a:hover::after {
        transform: none;
    }
    .nv-b .sep {
        width: 1px;
        height: 1rem;
        background: rgba(17, 17, 17, 0.15);
    }

    /* C: editorial corners */
    .nv-c {
        align-items: flex-start;
        padding: 1.75rem 2.5rem;
        mix-blend-mode: multiply;
    }
    .nv-c .name {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .nv-c .n1 {
        font: italic 400 1.5rem/1 var(--serif);
        letter-spacing: -0.02em;
    }
    .nv-c .n2 {
        font: 400 0.75rem/1.3 var(--sans);
        color: var(--label);
    }
    .nv-c .corner {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: auto auto;
        gap: 0.375rem 2rem;
        font-size: 0.8125rem;
    }
    .nv-c .corner a {
        display: flex;
        gap: 0.5rem;
        transition: opacity 0.2s;
    }
    .nv-c .corner a:hover {
        opacity: 0.55;
    }
    .nv-c .corner span {
        color: var(--label);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
    }

    /* switcher */
    .switch {
        position: fixed;
        z-index: 60;
        left: 50%;
        bottom: 1.25rem;
        transform: translateX(-50%);
        display: flex;
        gap: 0.25rem;
        padding: 0.25rem;
        border-radius: 999px;
        background: rgba(17, 17, 17, 0.88);
        box-shadow: 0 0.75rem 2rem -1rem rgba(0, 0, 0, 0.5);
    }
    .switch button {
        border: 0;
        border-radius: 999px;
        padding: 0.5rem 0.875rem;
        background: transparent;
        color: rgba(255, 255, 255, 0.7);
        font: 500 0.75rem/1 var(--sans);
        cursor: pointer;
        white-space: nowrap;
    }
    .switch button[aria-pressed="true"] {
        background: #fff;
        color: var(--ink);
    }

    @media (max-width: 809.98px) {
        .nv-a {
            padding: 1rem;
        }
        .nv-a .pill {
            height: 2.5rem;
            gap: 1rem;
            padding: 0 1rem 0 0.75rem;
        }
        .nv-a .dark {
            height: 2.5rem;
            padding: 0 1rem;
        }
        .nv-a .round {
            width: 2.5rem;
            height: 2.5rem;
        }
        .nv-b {
            padding: 1rem 1.25rem;
        }
        .nv-b .brand span {
            display: none;
        }
        .nv-b .links {
            gap: 1rem;
            font-size: 0.8125rem;
        }
        .nv-b .sep,
        .nv-b .links a[target] {
            display: none;
        }
        .nv-c {
            padding: 1.25rem;
        }
        .nv-c .n1 {
            font-size: 1.25rem;
        }
        .nv-c .corner {
            gap: 0.375rem 1rem;
            font-size: 0.75rem;
        }
        .nv-c .corner span {
            display: none;
        }
        .switch button {
            padding: 0.5rem 0.625rem;
        }
    }

    .controls {
        position: fixed;
        z-index: 60;
        left: 1rem;
        bottom: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        padding: 0.625rem 0.875rem;
        border-radius: 0.75rem;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
        font: 400 0.75rem/1.2 var(--sans);
        color: var(--ink-2);
    }
    .controls label {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    /* each word rises out of a mask */
    .word {
        display: inline-block;
        overflow: hidden;
        padding: 0 0.06em 0.12em;
        margin-bottom: -0.12em;
        vertical-align: top;
    }
    .word > span {
        display: inline-block;
        transform: translateY(105%);
        animation: rise 1.1s var(--spring) forwards;
        animation-delay: calc(0.15s + var(--i) * 0.07s);
    }
    @keyframes rise {
        to {
            transform: none;
        }
    }
    .lede {
        max-width: 38rem;
        font: 400 1.25rem/1.5 var(--sans);
        color: var(--ink-2);
        opacity: 0;
        animation: fade 1s ease forwards 0.75s;
    }
    @keyframes fade {
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    .work {
        max-width: 85rem;
        margin: 0 auto;
        padding: 2rem 3rem 9rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
    .work-h {
        font: 500 2rem/1.1 var(--sans);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4rem 1.25rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .card.wide {
        grid-column: span 2;
    }
    .thumb {
        position: relative;
        height: 28rem;
        border-radius: 1.25rem;
        overflow: hidden;
        background: #eceae4;
        margin-bottom: 0.5rem;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.04);
    }
    .go {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 2.75rem;
        height: 2.75rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--ink);
        color: #fff;
        transition:
            transform 0.5s var(--spring),
            background-color 0.3s ease;
    }
    .go svg {
        width: 1.125rem;
        height: 1.125rem;
    }
    .card:hover .go {
        transform: rotate(45deg) scale(1.08);
        background: var(--accent);
    }
    .tags {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }
    .tags li {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        background: rgba(17, 17, 17, 0.06);
        font: 500 0.75rem/1.3 var(--sans);
        color: var(--ink-2);
    }
    .outcome {
        max-width: 34rem;
        font: 500 1.75rem/1.2 var(--sans);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .subtitle {
        font: 400 0.9375rem/1.4 var(--sans);
        color: var(--label);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .word > span,
        .lede {
            animation: none;
            transform: none;
            opacity: 1;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1.125rem;
        }
        .work {
            padding: 1rem 2rem 7rem;
        }
        .grid {
            grid-template-columns: 1fr 1fr;
            gap: 3rem 1rem;
        }
        .card.wide {
            grid-column: span 2;
        }
        .thumb {
            height: 24rem;
        }
        .outcome {
            font-size: 1.5rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 1rem;
        }
        .work {
            padding: 0 1.25rem 6rem;
            gap: 1.75rem;
        }
        .work-h {
            font-size: 1.625rem;
        }
        .grid {
            grid-template-columns: 1fr;
            gap: 2.75rem;
        }
        .card.wide {
            grid-column: auto;
        }
        .thumb {
            height: auto;
            aspect-ratio: 1.25;
            border-radius: 1rem;
        }
        .go {
            width: 2.25rem;
            height: 2.25rem;
            top: 0.75rem;
            right: 0.75rem;
        }
        .outcome {
            font-size: 1.375rem;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>

<script>
    const navs = [...document.querySelectorAll<HTMLElement>("[data-nav]")]
    const btns = [...document.querySelectorAll<HTMLButtonElement>("[data-pick]")]
    const pick = (k: string) => {
        navs.forEach((n) => (n.hidden = n.dataset.nav !== k))
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.pick === k)))
        history.replaceState(null, "", "#" + k)
    }
    btns.forEach((b) => b.addEventListener("click", () => pick(b.dataset.pick!)))
    const h = location.hash.slice(1)
    if (["a", "b", "c"].includes(h)) pick(h)
</script>
