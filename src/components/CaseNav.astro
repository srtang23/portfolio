---
// Side navigation for case studies: a Back link plus one link per section.
// The link for the section you're reading is highlighted as you scroll.
interface Props {
    sections: { id: string; label: string }[]
    back?: string
}
const { sections, back = "/work" } = Astro.props
---

<nav class="case-nav" aria-label="Sections">
    <a href={back} data-back class="back">Back</a>
    <ul>
        {
            sections.map((s) => (
                <li>
                    <a href={`#${s.id}`} data-target={s.id}>
                        {s.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .case-nav {
        position: fixed;
        z-index: 40;
        top: 6.875rem;
        left: var(--gutter);
        width: 10.625rem;
        display: flex;
        flex-direction: column;
        gap: 1.875rem;
        font: 400 15px/1.4 var(--sans);
        letter-spacing: 0.01em;
    }
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3125rem;
    }
    a {
        display: inline-block;
        color: rgba(17, 17, 17, 0.35);
        transition:
            color 0.2s,
            opacity 0.2s;
    }
    a:hover {
        color: rgba(17, 17, 17, 0.25);
    }
    a.back,
    a.active {
        color: var(--ink);
    }
    a.back:hover,
    a.active:hover {
        color: rgba(17, 17, 17, 0.7);
    }

    @media (max-width: 1199.98px) {
        .case-nav {
            left: var(--gutter);
        }
    }
    @media (max-width: 809.98px) {
        .case-nav {
            display: none;
        }
    }
</style>

<script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".case-nav a[data-target]")]
    const targets = links.map((a) => document.getElementById(a.dataset.target!))
    let frame = 0
    const update = () => {
        frame = 0
        const line = innerHeight * 0.4
        let current = -1
        targets.forEach((el, i) => {
            if (el && el.getBoundingClientRect().top <= line) current = i
        })
        links.forEach((a, i) => a.classList.toggle("active", i === current))
    }
    const on = () => {
        if (!frame) frame = requestAnimationFrame(update)
    }
    update()
    addEventListener("scroll", on, { passive: true })
    addEventListener("resize", on)

    // Line "Back" up with the first line of the case study title. The title's position depends
    // on the screen size, so measure its layout position (ignoring entrance animations).
    const nav = document.querySelector<HTMLElement>(".case-nav")
    const back = nav?.querySelector<HTMLElement>(".back")
    const title = document.querySelector<HTMLElement>(".hero .title-area h1")
    const align = () => {
        if (!nav || !back || !title || innerWidth < 810) {
            nav?.style.removeProperty("top")
            return
        }
        let y = 0
        for (let el: HTMLElement | null = title; el; el = el.offsetParent as HTMLElement | null) y += el.offsetTop
        const lh = parseFloat(getComputedStyle(title).lineHeight) || title.offsetHeight
        const centre = y + lh / 2
        nav.style.top = `${Math.round(centre - back.offsetHeight / 2 - back.offsetTop)}px`
    }
    align()
    document.fonts?.ready.then(align)
    addEventListener("resize", align)
</script>
