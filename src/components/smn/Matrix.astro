---
// 2×2 used to prioritise the 20 nanny pain points from our research synthesis (Pain Point
// Analysis): impact on nannies' core workflows (up) against how feasible a fix was within our
// nanny-side scope (right). Impact follows the sheet's priority rating and how many participants
// were affected; feasibility follows the priority rationale (low-cost fix vs. risky, or a change
// on the family side). Each card names the broad areas its pain points fall into; the top-right
// card is what we designed for.
const quads = [
    { k: "tl", h: "Important, but out of scope", items: ["Control over which bookings to take", "Reporting safety concerns"] },
    { k: "tr", h: "Design for now", items: ["Managing availability", "Discovering open shifts", "Preparing for each booking", "Finding information quickly"] },
    { k: "bl", h: "Later", items: ["Relationships with favourite families", "Richer family profiles", "Self-managed scheduling"] },
    { k: "br", h: "Quick wins, lower impact", items: ["Reliable notifications", "Recovering cancelled time"] },
]
const label = quads.map((q) => `${q.h}: ${q.items.join(", ")}.`).join(" ")
---

<div class="matrix" role="img" aria-label={`Prioritisation of 20 nanny pain points by impact on core workflows and feasibility within our scope. ${label}`}>
    <div class="field" aria-hidden="true">
        <span class="axis ax-h"></span>
        <span class="axis ax-v"></span>
        <p class="al al-y">Impact on<br />core workflows</p>
        <p class="al al-x">Feasible within<br />our scope</p>
        {
            quads.map((q) => (
                <div class:list={["card", q.k]}>
                    <p class="ch">{q.h}</p>
                    <ul>
                        {q.items.map((t) => (
                            <li>{t}</li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</div>

<style>
    .matrix {
        position: relative;
        z-index: 1;
    }
    .field {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
        column-gap: 4.5rem;
        row-gap: 3rem;
        padding: 2.75rem 6rem 1.5rem 1.5rem;
    }
    /* the two axes cross in the middle, each with an arrowhead */
    .axis {
        position: absolute;
        background: #a3a7ad;
    }
    .ax-h {
        left: 0.5rem;
        right: 1.25rem;
        top: 50%;
        height: 1px;
    }
    .ax-v {
        left: calc(1.5rem + (100% - 7.5rem - 4.5rem) / 2 + 2.25rem);
        top: 0.5rem;
        bottom: 0.25rem;
        width: 1px;
    }
    .ax-h::after,
    .ax-v::after {
        content: "";
        position: absolute;
        width: 0.5rem;
        height: 0.5rem;
        border: solid #a3a7ad;
        border-width: 1px 1px 0 0;
    }
    .ax-h::after {
        right: 0;
        top: -0.25rem;
        transform: rotate(45deg);
    }
    .ax-v::after {
        top: 0;
        left: -0.25rem;
        transform: rotate(-45deg);
    }
    .al {
        position: absolute;
        font: 400 13px/1.3 var(--sans);
        color: var(--label);
    }
    .al-y {
        top: 0.25rem;
        left: calc(1.5rem + (100% - 7.5rem - 4.5rem) / 2 + 3rem);
    }
    .al-x {
        right: 0.25rem;
        top: calc(50% + 0.75rem);
    }
    .card {
        position: relative;
        z-index: 1;
        align-self: center;
        padding: 1rem 1.125rem 1.125rem;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.6);
    }
    .tl {
        grid-area: 1 / 1;
        justify-self: end;
        max-width: 15rem;
    }
    .tr {
        grid-area: 1 / 2;
        justify-self: start;
        max-width: 16rem;
        background: #fff;
        border-color: #3a3a3a;
    }
    .bl {
        grid-area: 2 / 1;
        justify-self: end;
        max-width: 15rem;
    }
    .br {
        grid-area: 2 / 2;
        justify-self: start;
        max-width: 15rem;
    }
    .ch {
        font: 500 1rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--label);
    }
    .tr .ch {
        color: var(--ink);
    }
    ul {
        list-style: none;
        margin: 0.5rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.25rem;
    }
    li {
        font: 400 13px/1.4 var(--para);
        color: var(--label);
    }
    .tr li {
        color: var(--ink);
    }
    @media (max-width: 809.98px) {
        .field {
            grid-template-columns: 1fr;
            grid-template-rows: none;
            row-gap: 0.75rem;
            padding: 0;
        }
        .axis,
        .al {
            display: none;
        }
        .tl,
        .tr,
        .bl,
        .br {
            grid-area: auto;
            justify-self: stretch;
            max-width: none;
        }
        .tr {
            order: -1;
        }
    }
</style>
