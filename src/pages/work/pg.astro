---
import Base from "../../layouts/Base.astro"
import CaseNav from "../../components/CaseNav.astro"

/*
 * Procter & Gamble case study, laid out like the Spilt Milk Nannies page:
 * hero → project info → overview → one section per stage, each with a visual.
 * Text in [square brackets] is a placeholder still to be written.
 */

const sections = [
    { id: "overview", label: "Overview" },
    { id: "challenge", label: "Challenge" },
    { id: "research", label: "Research" },
    { id: "concept-design", label: "Concept & Design" },
    { id: "final-deliverable", label: "Final deliverable" },
]

const info = [
    { h: "My Role", items: ["Design Research Lead", "Design Strategist"] },
    { h: "Team", items: ["[Team size]"] },
    { h: "Timeline", items: ["[Dates]", "([Length])"] },
    { h: "Skills", items: ["Consumer Research", "Insight Synthesis", "Design Strategy"] },
]

const stages = [
    {
        id: "challenge",
        heading: "[The challenge, in one line]",
        text: "[Describe the brief from P&G, what made it hard, and the constraints you worked within.]",
        visual: false,
    },
    {
        id: "research",
        heading: "[Research headline]",
        text: "We conducted 8 in-home visit interviews to understand the underlying motivations, needs, and feelings that shape how a typical user manages the smell of their homes.",
        visual: true,
    },
    {
        id: "concept-design",
        heading: "[Concept & Design headline]",
        text: "[Add your concepts, explorations and design decisions here.]",
        visual: true,
    },
    {
        id: "final-deliverable",
        heading: "[Final deliverable headline]",
        text: "[Add the final deliverable and its impact here.]",
        visual: true,
    },
]
---

<Base nav="case" title="Procter & Gamble · Sophia Tang" description="Design research and strategy to uncover new opportunities for product innovation.">
    <CaseNav sections={sections} />

    <main class="case">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>Procter &amp; Gamble<br />Product Innovation</h1>
            </div>
            <div class="hero-window">
                <img src="/images/pg/hero.png" alt="The P&G logo above a row of P&G products" width="1536" height="1024" fetchpriority="high" />
            </div>
        </header>

        <div class="content">
            <!-- Project info -->
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview: key insight, then the brief / tension / direction -->
            <section id="overview" class="sec">
                <p class="tag">#overview</p>
                <div class="insight">
                    <svg class="bulb" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M24 3v4M10 9l2.8 2.8M38 9l-2.8 2.8M4 22h4M40 22h4M11 33l2.8-2.8M37 33l-2.8-2.8"></path>
                        <path d="M18.5 37c0-4-1.6-5.6-3.6-8.3A11.5 11.5 0 1 1 35.5 22c0 2.6-.9 4.7-2.4 6.7-2 2.7-3.6 4.3-3.6 8.3"></path>
                        <path d="M19 41h10M21 45h6"></path>
                    </svg>
                    <h2 class="h">
                        In air care, scent is used to fix a smell rather than to shape how a home feels, so meaningful innovation must make creating a pleasant home feel as effortless
                        as covering up an odor.
                    </h2>
                </div>
                <dl class="framing body">
                    <div><dt>The brief:</dt> <dd>Find opportunities for innovation in the air care space.</dd></div>
                    <div>
                        <dt>The tension:</dt>
                        <dd>Everyday products are used out of habit, valued for what they solve rather than how they make people feel.</dd>
                    </div>
                    <div><dt>The direction:</dt> <dd>Design for the emotional experience, not just functional performance.</dd></div>
                </dl>
                <p class="body">
                    As Design Research Lead and Design Strategist, I led consumer research, synthesized insights, and translated findings into strategic opportunities for air care.
                </p>
            </section>

            <!-- One section per stage -->
            {
                stages.map((s) => (
                    <section id={s.id} class="sec">
                        <p class="tag">#{s.id}</p>
                        <h2 class="h">{s.heading}</h2>
                        <p class="body">{s.text}</p>
                        {s.visual && (
                            <div class="panel placeholder">
                                <p>[Placeholder: visual]</p>
                            </div>
                        )}
                    </section>
                ))
            }
        </div>
    </main>
</Base>

<style>
    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        height: 90vh;
        padding-top: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        border-radius: 0 0 5rem 5rem;
        background: url("/images/pg/hero-bg.jpg") center / cover no-repeat;
    }
    .grain {
        position: absolute;
        inset: 0 0 -2px 0;
        background: url("/images/smn/grain.png") center / cover;
        pointer-events: none;
    }
    .title-area {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 1.5rem;
    }
    .hero h1 {
        max-width: 66.67%;
        font: 500 4.25rem/1.25 var(--serif);
        letter-spacing: -0.02em;
        color: #fff;
        text-align: center;
    }
    .hero-window {
        position: relative;
        z-index: 1;
        width: 38.75rem;
        max-width: 80%;
        height: 18.4375rem;
        flex-shrink: 0;
        overflow: hidden;
    }
    .hero-window img {
        width: 100%;
        height: auto;
    }

    /* ---------- Content column ---------- */
    .content {
        display: flex;
        flex-direction: column;
        gap: 4.5rem;
        padding: 6rem 8.875rem 7.5rem 24.5rem;
    }
    .sec {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .h {
        font: 500 1.1875rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }

    .info {
        display: flex;
        justify-content: space-between;
        margin: 0;
    }
    .info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }
    .info dt {
        font: 500 1.1875rem/1.2 var(--serif);
        letter-spacing: -0.2px;
        color: var(--body);
    }
    .info dd {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font: 400 0.875rem/1.4 var(--sans);
        color: var(--ink-2);
    }

    /* Overview */
    .insight {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .bulb {
        flex-shrink: 0;
        width: 2.75rem;
        height: 2.75rem;
        color: var(--ink);
    }
    .framing {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .framing dt,
    .framing dd {
        display: inline;
        margin: 0;
    }
    .framing dt {
        font-weight: 500;
        color: var(--ink);
    }

    /* Visuals */
    .panel {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid var(--border);
        border-radius: inherit;
        pointer-events: none;
    }
    .placeholder {
        padding: 7.5rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .placeholder p {
        font: 400 0.8125rem/1.4 var(--sans);
        color: var(--label);
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .hero {
            padding-top: 6.25rem;
        }
        .hero h1 {
            font-size: 3rem;
            line-height: 1.05;
        }
        .content {
            padding: 4rem 3rem 10rem 11.5rem;
        }
        .info {
            gap: 2rem;
        }
        .info dd {
            white-space: nowrap;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding-top: 5.625rem;
        }
        .hero h1 {
            max-width: 80%;
            font-size: 2.25rem;
            line-height: 1.08;
        }
        .hero-window {
            height: 12rem;
        }
        .content {
            gap: 5rem;
            padding: 4rem 1.25rem 8.75rem;
        }
        .info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.75rem;
            padding-bottom: 1.5rem;
        }
        .info dd {
            white-space: normal;
        }
        .insight {
            align-items: flex-start;
            gap: 1rem;
        }
        .bulb {
            width: 2.25rem;
            height: 2.25rem;
        }
        .panel {
            border-radius: 0.75rem;
        }
        .placeholder {
            padding: 4.5rem 1rem;
        }
    }
</style>

<style is:global>
    /* Case studies sit on a slightly cooler, greyer paper than the rest of the site */
    :root {
        --paper: #f8f8f7;
    }
</style>
