---
import Base from "../layouts/Base.astro"
---

<Base title="Page not found · Sophia Tang">
    <main class="missing">
        <p class="tag">#404</p>
        <h1>This page is still being written.</h1>
        <p class="body">It may be a case study that hasn’t moved over yet.</p>
        <a class="back" href="/work">See all work →</a>
    </main>
</Base>

<style>
    .missing {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 75rem;
        margin: 0 auto;
        padding: 12.5rem 3rem 8rem;
    }
    h1 {
        font: 500 2.75rem/1.15 var(--serif);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .back {
        margin-top: 0.5rem;
        font: 400 0.875rem/1.4 var(--sans);
        color: var(--nav);
        transition: color 0.2s ease;
    }
    .back:hover {
        color: var(--ink);
    }
    @media (max-width: 809.98px) {
        .missing {
            padding: 7.5rem 1.25rem 6rem;
        }
        h1 {
            font-size: 2rem;
        }
    }
</style>
