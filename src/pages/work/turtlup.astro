---
import Base from "../../layouts/Base.astro"
import CaseNav from "../../components/CaseNav.astro"
import RevealBand from "../../components/smn/RevealBand.astro"
import "../../styles/case.css"

/*
 * TurtlUp, a one-minute case study in the same order as Spilt Milk Nannies:
 * overview → solution → problem → challenge → research → reflection.
 */

const sections = [
    { id: "overview", label: "Overview" },
    { id: "solution", label: "Solution" },
    { id: "problem", label: "Problem" },
    { id: "challenge", label: "Challenge" },
    { id: "research", label: "Research" },
    { id: "reflection", label: "Reflection" },
]

const info = [
    { h: "My Role", items: ["UX Engineer"] },
    { h: "Team", items: ["4 Members", "(Electrical, Bio,", "Web, UX)"] },
    { h: "Timeline", items: ["Mar – June 2025", "(11 weeks)"] },
    { h: "Skills", items: ["UX Research", "Hardware Design", "Frontend Development"] },
]

const outcomes = [
    { label: "User research", value: "10 interviews", text: "With college students on when and why they slouch." },
    { label: "Build", value: "11 weeks", text: "From first concept to a working prototype." },
    { label: "Business model", value: "$50 kit", text: "Plus an optional subscription under $10 a month." },
]

const features = [
    { h: "Personalization", p: "Calibrate the shirt to your own upright posture.", v: "calibration" },
    { h: "Real-time tracking", p: "See posture statistics and progress over time.", v: "posture-stats" },
    { h: "Customization", p: "Tune vibration sensitivity, intensity and reminders.", v: "settings" },
]

const insights = [
    { h: "Slouching happens during focused work", p: "“I only slouch when I’m really focused on my laptop, like writing papers or coding.”" },
    { h: "It happens unconsciously", p: "“I don’t realize I’m slouching until my back or shoulders start hurting.”" },
    { h: "Phones break concentration", p: "“I wouldn’t check my phone for notifications while I’m deep in work.”" },
    { h: "Nudges, not nagging", p: "“I don’t want something constantly nagging me. Just a gentle nudge would be helpful.”" },
]

const reflections = [
    { h: "Design meets engineering", p: "Balancing the design vision with hardware limits, from Bluetooth debugging to sensor placement that’s both comfortable and accurate." },
    { h: "Business-minded design", p: "My first project weighing market fit and commercial viability alongside the user experience." },
    { h: "Cross-disciplinary collaboration", p: "Translating design for engineers, and keeping the team aligned through clear documentation and regular check-ins." },
]
---

<Base nav="case" title="TurtlUp · Sophia Tang" description="A posture-sensing wearable and web app that turns unconscious slouching into gentle, real-time awareness.">
    <CaseNav sections={sections} />

    <main class="case" style="--hero-bg: url('/images/turtlup/hero-bg.jpg')">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>TurtlUp<br />Posture-Sensing Wearable</h1>
            </div>
            <div class="hero-window device-window">
                <img class="device" data-parallax src="/images/turtlup/laptop.png" alt="The TurtlUp web app on a laptop, showing posture statistics" width="1008" height="635" fetchpriority="high" />
            </div>
        </header>

        <div class="content first">
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview -->
            <section id="overview" class="sec">
                <p class="tag">#overview</p>
                <h2 class="h">Designing a wearable that turns unconscious slouching into gentle, real-time awareness.</h2>
                <p class="body">
                    As the only designer on an interdisciplinary team, I designed TurtlUp: a sensor-embedded shirt that vibrates when you slouch, paired with a web app for calibration
                    and tracking.
                </p>
                <div class="outcomes">
                    {
                        outcomes.map((o, i) => (
                            <div class="card outcome reveal" style={`--delay:${i * 0.08}s`}>
                                <p class="tag">{o.label}</p>
                                <p class="value">{o.value}</p>
                                <p class="body">{o.text}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Solution -->
            <section id="solution" class="sec">
                <p class="tag">#solution</p>
                <h2 class="h">A shirt that notices, and an app that adapts to you.</h2>
                <p class="body">
                    IMU sensors along the spine and shoulders track alignment, and a small motor gives a gentle vibration when you slouch. The shirt connects over Bluetooth to a
                    companion web app. <a class="link" href="https://www.youtube.com/watch?v=IXgoF7fWUYQ" target="_blank" rel="noopener noreferrer">Watch the demo ↗</a>
                </p>
                <div class="panel wearable">
                    <img src="/images/turtlup/wearable.png" alt="Sensor placement on the shirt: upper, mid and lower spine, both shoulder blades, a vibration motor, and a microcontroller in a waist pack" loading="lazy" />
                </div>
                <div class="features">
                    {
                        features.map((f) => (
                            <div class="feature">
                                <div class="feature-text">
                                    <h3>{f.h}</h3>
                                    <p class="body">{f.p}</p>
                                </div>
                                <div class="panel screen">
                                    <video data-loop muted loop playsinline preload="metadata" poster={`/images/turtlup/${f.v}-poster.jpg`} aria-label={`${f.h} in the TurtlUp web app`}>
                                        <source src={`/video/turtlup/${f.v}.webm`} type="video/webm" />
                                        <source src={`/video/turtlup/${f.v}.mp4`} type="video/mp4" />
                                    </video>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Problem -->
            <section id="problem" class="sec">
                <p class="tag">#problem</p>
                <h2 class="h">Most people don’t notice they’re slouching until it hurts.</h2>
                <p class="body">
                    Back pain affects 39% of U.S. adults, often from posture habits people aren’t aware of. Students and desk workers sit for hours, and existing posture products
                    either nag constantly or ask for attention they don’t have.
                </p>
            </section>
        </div>

        <RevealBand
            id="challenge"
            bg="/images/turtlup/hero-bg.jpg"
            text="How might we help users build **healthy sitting habits** through **real-time awareness and feedback?**"
        />

        <div class="content last">
            <!-- Research -->
            <section id="research" class="sec gap-16">
                <p class="tag">#research</p>
                <h2 class="h">Feedback has to fit around deep focus.</h2>
                <p class="body">
                    A size, pay and access comparison pointed us to college students first. We interviewed 10 of them, and four insights shaped the design toward subtle,
                    vibration-based nudges instead of phone notifications.
                </p>
                <div class="panel insights">
                    {
                        insights.map((x) => (
                            <div class="insight">
                                <div class="insight-text">
                                    <h3>{x.h}</h3>
                                    <p>{x.p}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Reflection -->
            <section id="reflection" class="sec reflection">
                <p class="tag">#reflection</p>
                <h2 class="h">My first end-to-end product, from concept to working hardware.</h2>
                <ol class="reflections">
                    {
                        reflections.map((r, i) => (
                            <li>
                                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <h3>{r.h}</h3>
                                    <p class="body">{r.p}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </div>
    </main>
</Base>

<style>
    /* The laptop sits higher in the hero and drifts up as you scroll */
    .device-window {
        width: 40rem;
        max-width: 84%;
        height: 20rem;
        display: block;
    }
    .device {
        width: 100%;
        height: auto;
        will-change: transform;
    }
    .link {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--border);
    }
    .link:hover {
        text-decoration-color: var(--ink);
    }
    .wearable {
        padding: 2rem 1.75rem;
    }
    .wearable img {
        width: 100%;
        height: auto;
    }
    .features {
        margin-top: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .feature {
        display: grid;
        grid-template-columns: 11rem 1fr;
        gap: 1.5rem;
        align-items: center;
    }
    .feature-text {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .feature h3 {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .screen {
        padding: 0.75rem;
    }
    .screen video {
        display: block;
        width: 100%;
        aspect-ratio: 1280 / 688;
        border-radius: 0.5rem;
        background: #fff;
        box-shadow: 0 0 0 1px var(--border);
    }
    @media (max-width: 809.98px) {
        .case .hero h1 {
            max-width: 92%;
        }
        .device-window {
            max-width: 90%;
            height: 13rem;
        }
        .feature {
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
    }
</style>

<style is:global>
    :root {
        --paper: #f8f8f7;
    }
</style>

<script>
    // Hero laptop drifts up as you scroll (capped).
    const el = document.querySelector<HTMLElement>("[data-parallax]")
    if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let frame = 0
        const update = () => {
            frame = 0
            const k = parseFloat(getComputedStyle(document.documentElement).fontSize) / 16
            el.style.transform = `translate3d(0, ${-Math.min(Math.max(scrollY, 0) * 0.2, 300 * k)}px, 0)`
        }
        addEventListener("scroll", () => frame || (frame = requestAnimationFrame(update)), { passive: true })
        update()
    }
    // Looping recordings play only while on screen.
    const io = new IntersectionObserver(
        (es) => es.forEach((e) => ((e.target as HTMLVideoElement)[e.isIntersecting ? "play" : "pause"]() as any)?.catch?.(() => {})),
        { threshold: 0.25 },
    )
    document.querySelectorAll("video[data-loop]").forEach((v) => io.observe(v))
</script>
