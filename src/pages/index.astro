---
import Base from "../layouts/Base.astro"
import { projects } from "../data/projects"
import StippleSky from "../components/StippleSky.astro"

// Two columns that stack on their own; thumbnail shapes alternate so the columns fall out of step.
const ratios = [1.78, 1.42, 1.42, 1.78]

const headline = ["A", "product", "designer", "who", "creates", "with", "vision"]
---

<Base title="Sophia Tang · Product Designer">
    <StippleSky />
    <main class="home">
        <!-- Hero -->
        <header class="hero">
            <h1 class="headline" data-sky-clear aria-label={headline.join(" ")}>
                {
                    headline.map((w, i) => (
                        <span class="word" aria-hidden="true" style={`--i:${i}`}>
                            <span>{w}</span>
                        </span>
                    ))
                }
            </h1>
            <p class="lede" data-sky-clear>
                I’m Sophia. I create experiences grounded in research and systems thinking, bringing curiosity to everyday interactions and a strategic lens to complex challenges.
            </p>
        </header>

        <!-- Work -->
        <section class="work" id="selected-work" aria-label="Selected work">
            <div class="grid">
                {
                    [0, 1].map((col) => (
                        <div class="col">
                            {projects.map((p, i) =>
                                i % 2 === col ? (
                                    <a class="card rise" href={p.href} style={`--d:${col * 0.08}s; --ratio:${ratios[i % ratios.length]}; --order:${i}`}>
                                        <div class="thumb">
                                            <img src={p.image} alt={p.alt} loading={i < 2 ? "eager" : "lazy"} />
                                        </div>
                                        <p class="caption">
                                            <span class="name">{p.title}</span>
                                            <span class="slash" aria-hidden="true">/</span>
                                            <span class="meta">{p.meta}</span>
                                        </p>
                                    </a>
                                ) : null,
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Base>

<style>
    .home {
        position: relative;
        isolation: isolate;
    }

    /* ---------- Hero ---------- */
    .hero {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        padding: 7rem 3rem 6rem;
        text-align: center;
    }
    .headline {
        max-width: 52rem;
        font: italic 400 5.5rem/0.98 var(--serif);
        letter-spacing: -0.035em;
        color: var(--ink);
    }
    /* each word rises out of a mask */
    .word {
        display: inline-block;
        overflow: hidden;
        padding: 0 0.06em 0.12em;
        margin-bottom: -0.12em;
        vertical-align: top;
    }
    .word > span {
        display: inline-block;
        transform: translateY(105%);
        animation: rise 1.1s var(--spring) forwards;
        animation-delay: calc(0.15s + var(--i) * 0.07s);
    }
    @keyframes rise {
        to {
            transform: none;
        }
    }
    .lede {
        max-width: 38rem;
        font: 400 1.25rem/1.5 var(--sans);
        color: var(--ink-2);
        opacity: 0;
        animation: fade 1s ease forwards 0.75s;
    }
    @keyframes fade {
        to {
            opacity: 1;
        }
    }

    /* ---------- Work ---------- */
    /* A centred column, shared with the nav (see Nav.astro) */
    .work {
        --col: 48rem;
        padding: 1rem max(1.25rem, calc((100% - var(--col)) / 2)) 9rem;
    }
    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    .col {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .thumb {
        aspect-ratio: var(--ratio, 1.6);
        border-radius: 0.375rem;
        overflow: hidden;
        background: #eceae4;
    }
    .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.001);
        transition: transform 0.9s var(--spring);
    }
    .card:hover .thumb img {
        transform: scale(1.03);
    }
    .caption {
        display: flex;
        gap: 0.5rem;
        font: 400 0.9375rem/1.5 var(--sans);
        letter-spacing: 0.005em;
    }
    .name {
        color: var(--ink);
    }
    .slash,
    .meta {
        color: var(--label);
    }
    .card:hover .name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--border);
    }

    /* cards lift and settle in as they scroll into view */
    .rise {
        opacity: 0;
        transform: translateY(3rem) scale(0.97);
        transition:
            opacity 0.9s ease,
            transform 1.1s var(--spring);
        transition-delay: var(--d, 0s);
    }
    .rise.in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .word > span,
        .lede {
            animation: none;
            transform: none;
            opacity: 1;
        }
        .rise {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .headline {
            font-size: 4rem;
        }
        .lede {
            font-size: 1.125rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding: 6rem 1.25rem 4rem;
            gap: 1.5rem;
        }
        .headline {
            font-size: 2.625rem;
        }
        .lede {
            font-size: 1rem;
        }
        .work {
            padding: 0 1.25rem 6rem;
        }
        /* one column, back in the original order */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
        .col {
            display: contents;
        }
        .card {
            order: var(--order);
        }
        .thumb {
            aspect-ratio: 1.5;
        }
    }
</style>

<script>
    const io = new IntersectionObserver(
        (es) =>
            es.forEach((e) => {
                if (e.isIntersecting) {
                    e.target.classList.add("in")
                    io.unobserve(e.target)
                }
            }),
        { threshold: 0.12, rootMargin: "0px 0px -5% 0px" },
    )
    document.querySelectorAll(".rise").forEach((el) => io.observe(el))
</script>
