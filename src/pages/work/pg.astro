---
import Base from "../../layouts/Base.astro"
import CaseNav from "../../components/CaseNav.astro"
import RevealBand from "../../components/smn/RevealBand.astro"
import ProcessDiamonds from "../../components/pg/ProcessDiamonds.astro"

/*
 * Procter & Gamble case study. Tells the story in the same order as Spilt Milk Nannies:
 * overview → solution → problem → challenge → research → pivot → my role →
 * opportunity → results → reflection.
 * Text in [square brackets] is a placeholder still to be written.
 */

const sections = [
    { id: "overview", label: "Overview" },
    { id: "solution", label: "Solution" },
    { id: "problem", label: "Problem" },
    { id: "challenge", label: "Challenge" },
    { id: "research", label: "Research" },
    { id: "process", label: "Pivot" },
    { id: "my-role", label: "My role" },
    { id: "opportunity", label: "Opportunity" },
    { id: "results", label: "Results" },
    { id: "reflection", label: "Reflection" },
]

const info = [
    { h: "My Role", items: ["Design Research Lead", "Design Strategist"] },
    { h: "Team", items: ["[Team size]"] },
    { h: "Timeline", items: ["[Dates]", "([Length])"] },
    { h: "Skills", items: ["Consumer Research", "Insight Synthesis", "Design Strategy"] },
]

const steps = [
    { h: "[Solution feature 1]", p: "[What it does, and the need it answers.]" },
    { h: "[Solution feature 2]", p: "[What it does, and the need it answers.]" },
    { h: "[Solution feature 3]", p: "[What it does, and the need it answers.]" },
]

const insights = [
    { h: "[Insight 1]", p: "[One line that explains it.]" },
    { h: "[Insight 2]", p: "[One line that explains it.]" },
    { h: "[Insight 3]", p: "[One line that explains it.]" },
    { h: "[Insight 4]", p: "[One line that explains it.]" },
]

const reflections = [
    { h: "[Lesson 1]", p: "[What you learned, and how it changed the way you work.]" },
    { h: "[Lesson 2]", p: "[What you learned, and how it changed the way you work.]" },
    { h: "[Lesson 3]", p: "[What you learned, and how it changed the way you work.]" },
]
---

<Base nav="case" title="Procter & Gamble · Sophia Tang" description="Design research and strategy to uncover new opportunities for product innovation.">
    <CaseNav sections={sections} />

    <main class="case">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>Procter &amp; Gamble<br />Product Innovation</h1>
            </div>
            <div class="hero-window pg-window">
                <img class="pg-hero-img" data-parallax src="/images/pg/hero.png" alt="The P&G logo above a row of P&G products" width="1536" height="1024" fetchpriority="high" />
            </div>
        </header>

        <div class="content first">
            <!-- Project info -->
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview: the question, the goal, and the process -->
            <section id="overview" class="sec ov">
                <p class="tag">#overview</p>
                <h2 class="h">How can air care earn a broader role in the home?</h2>
                <p class="body">Our goal was to find opportunities for innovation in the air care space.</p>
                <ProcessDiamonds />
            </section>

            <!-- Solution -->
            <section id="solution" class="sec story">
                <div class="phone-col">
                    <p class="tag">#solution</p>
                    <div class="panel placeholder solution-visual">
                        <p>[Placeholder: final design]</p>
                    </div>
                </div>
                <div class="steps">
                    {
                        steps.map((s, i) => (
                            <div class="step" data-step={i}>
                                <h3>{s.h}</h3>
                                <p class="body">{s.p}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Problem -->
            <section id="problem" class="sec">
                <p class="tag">#problem</p>
                <h2 class="h">[Problem headline]</h2>
                <p class="body">[What was wrong with the way things worked before, and who it affected.]</p>
                <div class="panel placeholder">
                    <p>[Placeholder: visual]</p>
                </div>
            </section>
        </div>

        <RevealBand id="challenge" bg="/images/pg/hero-bg.jpg" text="How might we **[the challenge you were given]**?" />

        <div class="content">
            <!-- Research -->
            <section id="research" class="sec gap-16">
                <p class="tag">#research</p>
                <h2 class="h">[Research headline]</h2>
                <p class="body">
                    We conducted 8 in-home visit interviews to understand the underlying motivations, needs, and feelings that shape how a typical user manages the smell of their
                    homes. [Our research revealed four key insights:]
                </p>
                <div class="panel insights">
                    {
                        insights.map((x) => (
                            <div class="insight">
                                <div class="preview">
                                    <p>[Image]</p>
                                </div>
                                <div class="insight-text">
                                    <h3>{x.h}</h3>
                                    <p>{x.p}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Pivot -->
            <section id="process" class="sec">
                <p class="tag">#pivot</p>
                <h2 class="h">[Pivot headline: the moment the problem changed shape]</h2>
                <p class="body">[What the research showed that you didn’t expect, and how it changed the direction.]</p>
                <div class="panel placeholder">
                    <p>[Placeholder: visual]</p>
                </div>
            </section>

            <!-- My role -->
            <section id="my-role" class="sec gap-16">
                <p class="tag">#my-role</p>
                <h2 class="h">[My role headline]</h2>
                <p class="body">
                    As Design Research Lead and Design Strategist, I led consumer research, synthesized insights, and translated findings into strategic opportunities for air care.
                </p>
                <p class="body">[A specific moment where you steered the team, and what it led to.]</p>
                <div class="panel placeholder">
                    <p>[Placeholder: visual]</p>
                </div>
            </section>
        </div>

        <RevealBand id="opportunity" bg="/images/pg/hero-bg.jpg" text="How might we **[the opportunity you landed on]**?" />

        <div class="content last">
            <!-- Results -->
            <section id="results" class="sec gap-16">
                <p class="tag">#results</p>
                <h2 class="h">What we delivered</h2>
                <p class="body">[What you handed to P&G, and how it was received.]</p>
                <div class="panel quotes">
                    <figure class="quote">
                        <div class="avatar" aria-hidden="true">PG</div>
                        <div class="quote-body">
                            <figcaption class="tag">[Who said it]</figcaption>
                            <blockquote>
                                <p>[A quote from a stakeholder or participant.]</p>
                            </blockquote>
                        </div>
                    </figure>
                </div>
            </section>

            <!-- Reflection -->
            <section id="reflection" class="sec reflection">
                <p class="tag">#reflection</p>
                <h2 class="h">[Reflection headline]</h2>
                <ol class="reflections">
                    {
                        reflections.map((r, i) => (
                            <li>
                                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <h3>{r.h}</h3>
                                    <p class="body">{r.p}</p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </div>
    </main>
</Base>

<style>
    /* ---------- Hero ---------- */
    .hero {
        position: relative;
        height: 90vh;
        padding-top: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        border-radius: 0 0 5rem 5rem;
        background: url("/images/pg/hero-bg.jpg") center / cover no-repeat;
    }
    .grain {
        position: absolute;
        inset: 0 0 -2px 0;
        background: url("/images/smn/grain.png") center / cover;
        pointer-events: none;
    }
    .title-area {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 1.5rem;
    }
    .hero h1 {
        max-width: 66.67%;
        font: 500 4.25rem/1.25 var(--serif);
        letter-spacing: -0.02em;
        color: #fff;
        text-align: center;
    }
    .hero-window {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 68.75rem;
        height: 18.75rem;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
    }
    .hero-phones {
        flex-shrink: 0;
        width: 141.36%;
        max-width: none;
        height: 42.5625rem;
        object-fit: cover;
        object-position: center top;
        will-change: transform;
    }

    /* ---------- Content columns ---------- */
    .content {
        display: flex;
        flex-direction: column;
        gap: 4.5rem;
        padding: 7.5rem 8.875rem 7.5rem 24.5rem;
    }
    .content.first {
        padding-top: 6rem;
    }
    .content.last {
        padding-bottom: 2.5rem;
    }

    .sec {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .sec.gap-16 {
        gap: 1rem;
    }
    .h {
        font: 500 1.1875rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .paras {
        display: flex;
        flex-direction: column;
        gap: 1.4em;
    }
    em {
        font-style: italic;
        font-synthesis: style;
    }

    /* Project info */
    .info {
        display: flex;
        justify-content: space-between;
        margin: 0;
    }
    .info-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }
    .info dt {
        font: 500 1.1875rem/1.2 var(--serif);
        letter-spacing: -0.2px;
        color: var(--body);
    }
    .info dd {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font: 400 0.875rem/1.4 var(--sans);
        color: var(--ink-2);
    }

    /* Cards and panels */
    /* Borders are drawn inside the box (as in the Framer design), so they don't eat into the content width */
    .card,
    .insight,
    .quote blockquote {
        box-shadow: inset 0 0 0 1px var(--border);
    }
    .card {
        background: var(--white);
        border-radius: 1rem;
    }
    .outcomes {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        padding: 0.5rem 0;
    }
    .outcome {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
    }
    .outcome.reveal {
        transform: none;
        transition: opacity 0.5s ease;
    }
    .value {
        font: 500 1.75rem/1.15 var(--serif);
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .panel {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid var(--border);
        border-radius: inherit;
        pointer-events: none;
    }

    /* Solution */
    .story {
        flex-direction: row;
        align-items: flex-start;
        gap: 4rem;
    }
    .phone-col {
        position: sticky;
        top: 6.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex-shrink: 0;
    }
    .steps {
        flex: 1;
        min-width: 0;
    }
    .step {
        height: 33.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.875rem;
    }
    .step h3 {
        font: 500 1.1875rem/1.15 var(--serif);
        letter-spacing: -0.5px;
        color: var(--ink);
    }

    /* Problem */
    .flow video {
        display: block;
        width: 100%;
        aspect-ratio: 1.6;
        object-fit: cover;
    }

    /* Research */
    .insights {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 1fr;
        gap: 0.75rem;
        padding: 0.875rem;
    }
    .insight {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 0.375rem 0.375rem 0.875rem;
        background: var(--white);
        border-radius: 1rem;
    }
    .preview {
        border-radius: 0.625rem;
        background: #f0f0f0;
        overflow: hidden;
    }
    .preview img {
        width: 100%;
        height: auto;
    }
    .insight-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.5rem;
    }
    .insight h3 {
        font: 500 0.875rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: var(--ink);
    }
    .insight p {
        font: 400 0.8125rem/1.5 var(--sans);
        letter-spacing: 0.01em;
        color: var(--body);
    }

    /* Pivot */
    .journey {
        padding: 2.25rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .journey picture,
    .journey img {
        width: 100%;
        height: auto;
    }

    /* My role */
    .placeholder {
        padding: 7.5rem 1.75rem;
        display: flex;
        justify-content: center;
    }
    .placeholder p {
        font: 400 0.8125rem/1.4 var(--sans);
        color: var(--label);
    }

    /* Results */
    .quotes {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 0.875rem 0.875rem 1.5rem;
    }
    .quote {
        margin: 0;
        display: flex;
        gap: 1rem;
        padding: 0 0.625rem;
    }
    .avatar {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        background: #ecebe7;
        display: grid;
        place-items: center;
        font: 500 0.75rem/1 var(--sans);
        color: var(--label);
    }
    .quote-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .quote blockquote {
        margin: 0;
        padding: 1.125rem 1.375rem;
        background: var(--white);
        border-radius: 4px 1rem 1rem 1rem;
    }
    .quote blockquote p {
        font: italic 400 1rem/1.5 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }

    /* Reflection */
    .reflection {
        padding-bottom: 3.75rem;
    }
    .reflections {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0 0;
    }
    .reflections li {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
    }
    .num {
        flex-shrink: 0;
        width: 1.75rem;
        font: 400 0.75rem/1.375rem var(--sans);
        color: var(--label);
    }
    .reflections li > div {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .reflections h3 {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    .reflections::before {
        content: "";
        display: block;
        height: 1px;
        background: var(--border);
    }

    /* ---------- Tablet ---------- */
    @media (max-width: 1199.98px) {
        .hero {
            padding-top: 6.25rem;
        }
        .hero h1 {
            max-width: 50%;
            font-size: 3rem;
            line-height: 1.05;
        }
        .content {
            padding: 6rem 3rem 6rem 11.5rem;
        }
        .content.first {
            padding-top: 4rem;
        }
        .content.last {
            padding-bottom: 10rem;
        }
        .info {
            gap: 2rem;
        }
        .info dd {
            white-space: nowrap;
        }
        .value {
            font-size: 1.625rem;
        }
        .story {
            gap: 2.5rem;
        }
        .step {
            height: 28.75rem;
        }
    }

    /* ---------- Phone ---------- */
    @media (max-width: 809.98px) {
        .hero {
            padding-top: 5.625rem;
        }
        .hero h1 {
            max-width: 66.67%;
            font-size: 2.25rem;
            line-height: 1.08;
        }
        .hero-window {
            height: 13.125rem;
        }
        .hero-phones {
            width: 170%;
            height: 18.1875rem;
        }
        .content {
            gap: 5rem;
            padding: 5rem 1.25rem;
        }
        .content.first {
            padding-top: 4rem;
        }
        .content.last {
            padding-bottom: 8.75rem;
        }
        .info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.75rem;
            padding-bottom: 1.5rem;
        }
        .outcomes {
            grid-template-columns: 1fr;
            grid-auto-rows: 1fr;
        }
        .value {
            font-size: 1.75rem;
        }
        .story {
            gap: 1.125rem;
        }
        .phone-col {
            gap: 0.625rem;
        }
        .step {
            height: 21.25rem;
            gap: 0.5rem;
        }
        .panel {
            border-radius: 0.75rem;
        }
        .insights {
            grid-template-columns: 1fr;
        }
        .journey {
            padding: 1.25rem 0.75rem;
        }
        .journey picture,
        .journey img {
            width: 86%;
        }
        .journey picture img {
            width: 100%;
        }
        .placeholder {
            padding: 4.5rem 1rem;
        }
        .quotes {
            padding: 0.625rem 0.625rem 1.125rem;
        }
        .quote {
            gap: 0.75rem;
            padding: 0 0.25rem;
        }
        .avatar {
            width: 2rem;
            height: 2rem;
        }
        .quote blockquote {
            padding: 0.875rem 1rem;
        }
        .quote blockquote p {
            font-size: 0.9375rem;
        }
        .reflections li {
            gap: 0.875rem;
            padding: 1.25rem 0;
        }
    }
</style>

<style>
    /* ---------- P&G specifics ---------- */
    /* The P&G image sits higher than the phones do, and drifts up as you scroll */
    .hero .pg-window {
        width: 40rem;
        max-width: 84%;
        height: 22rem;
        display: block;
    }
    .hero .pg-hero-img {
        width: 100%;
        height: auto;
        will-change: transform;
    }


    .solution-visual {
        width: 15.75rem;
        height: 32.375rem;
        padding: 1rem;
        align-items: center;
    }
    .preview {
        display: grid;
        place-items: center;
        aspect-ratio: 3 / 1;
    }
    .preview p {
        font: 400 0.75rem/1.4 var(--sans);
        color: var(--label);
    }

    @media (max-width: 1199.98px) {
        .solution-visual {
            width: 13.125rem;
            height: 27rem;
        }
    }
    @media (max-width: 809.98px) {
        .hero .pg-window {
            max-width: 88%;
            height: 13.125rem;
        }
        .hero .title-area h1 {
            max-width: 90%;
        }
        .solution-visual {
            width: 8.25rem;
            height: 16.9375rem;
            padding: 0.5rem;
        }
    }
    /* Overview: the question, a one-line goal, then the process diagram */
    .ov {
        gap: 1.25rem;
    }
</style>

<script>
    // Hero phones drift up as you scroll (capped so they never run out of the window).
    const phones = document.querySelector<HTMLElement>("[data-parallax]")
    if (phones && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let frame = 0
        const update = () => {
            frame = 0
            const k = parseFloat(getComputedStyle(document.documentElement).fontSize) / 16
            const max = 300 * k
            const y = Math.min(Math.max(scrollY, 0) * 0.2, max)
            phones.style.transform = `translate3d(0, ${-y}px, 0)`
        }
        const on = () => {
            if (!frame) frame = requestAnimationFrame(update)
        }
        update()
        addEventListener("scroll", on, { passive: true })
        addEventListener("resize", on)
        addEventListener("pageshow", update)
    }

    // Looping videos only play while they're on screen.
    const loops = document.querySelectorAll<HTMLVideoElement>("video[data-loop]")
    const vio = new IntersectionObserver(
        (entries) => {
            for (const e of entries) {
                const v = e.target as HTMLVideoElement
                if (e.isIntersecting) v.play().catch(() => {})
                else v.pause()
            }
        },
        { threshold: 0.25 },
    )
    loops.forEach((v) => vio.observe(v))
</script>

<style is:global>
    /* Case studies sit on a slightly cooler, greyer paper than the rest of the site */
    :root {
        --paper: #f8f8f7;
    }
</style>
