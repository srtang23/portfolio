---
// Full-width band that pins while you scroll through it. The statement's words light up
// one by one, and the teal background keeps drifting. Wrap phrases in **double
// asterisks** to give them the bright colour.
interface Props {
    id: string
    text: string
    bg?: string // background image; defaults to the Spilt Milk Nannies teal
}
const { id, text, bg = "/images/smn/hero-bg.jpg" } = Astro.props

const words: { w: string; strong: boolean }[] = []
text.split(/(\*\*[^*]+\*\*)/).forEach((part) => {
    const strong = part.startsWith("**") && part.endsWith("**")
    const clean = strong ? part.slice(2, -2) : part
    clean.split(/(\s+)/).forEach((w) => w && words.push({ w, strong }))
})
const plain = text.replace(/\*\*/g, "")
---

<section id={id} class="band" data-band>
    <div class="pin">
        <div class="bg" aria-hidden="true"><img src={bg} alt="" /></div>
        <p class="label">#{id}</p>
        <p class="statement">
            <span class="sr">{plain}</span>
            {words.map((x) => (x.w.trim() ? <span class:list={["w", { strong: x.strong }]} aria-hidden="true">{x.w}</span> : x.w))}
        </p>
    </div>
</section>

<style>
    .band {
        position: relative;
        height: 220vh;
        overflow: clip;
    }
    .pin {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.25rem;
        padding: 0 8.875rem 0 24.5rem;
        will-change: opacity;
    }
    .label,
    .statement {
        position: relative;
        z-index: 2;
    }
    .label {
        font: 400 0.75rem/1.4 var(--sans);
        letter-spacing: 0.01em;
        color: rgba(255, 255, 255, 0.72);
    }
    .statement {
        font: 500 2.125rem/1.25 var(--serif);
        letter-spacing: -0.02em;
    }
    .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .w {
        color: rgba(255, 255, 255, 0.22);
        transition: color 0.35s ease;
    }
    .w.lit {
        color: rgba(255, 255, 255, 0.72);
    }
    .w.lit.strong {
        color: #fff;
    }

    /* Drifting background: the image slowly rotates and pans, with soft white wisps over it */
    .bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }
    .bg img {
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        transform-origin: 50% 50%;
        will-change: transform;
        animation: sp-flow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    .bg::before,
    .bg::after {
        content: "";
        position: absolute;
        inset: -30%;
        pointer-events: none;
        will-change: transform;
        z-index: 1;
    }
    .bg::before {
        mix-blend-mode: screen;
        opacity: 0.9;
        filter: blur(30px);
        background:
            radial-gradient(26% 18% at 28% 38%, rgba(255, 255, 255, 0.6), transparent 72%),
            radial-gradient(22% 16% at 68% 60%, rgba(255, 255, 255, 0.45), transparent 72%),
            radial-gradient(18% 13% at 52% 22%, rgba(255, 255, 255, 0.4), transparent 72%),
            radial-gradient(20% 14% at 40% 78%, rgba(255, 255, 255, 0.35), transparent 72%);
        animation: sp-current-a 5s ease-in-out infinite;
    }
    .bg::after {
        mix-blend-mode: soft-light;
        opacity: 0.35;
        background:
            radial-gradient(28% 24% at 70% 30%, rgba(0, 0, 0, 0.35), transparent 70%),
            radial-gradient(32% 22% at 35% 70%, rgba(0, 0, 0, 0.3), transparent 70%);
        animation: sp-current-b 7.5s ease-in-out infinite;
    }
    @keyframes sp-flow {
        0% {
            transform: scale(1.3) translate(0%, 0%) rotate(0deg);
        }
        25% {
            transform: scale(1.36) translate(-5%, 3.5%) rotate(4deg);
        }
        50% {
            transform: scale(1.32) translate(1.5%, 6%) rotate(-2deg);
        }
        75% {
            transform: scale(1.38) translate(5.5%, -2%) rotate(-5deg);
        }
        100% {
            transform: scale(1.3) translate(0%, 0%) rotate(0deg);
        }
    }
    @keyframes sp-current-a {
        0% {
            transform: translate(-10%, -7%) rotate(0deg) scale(1);
        }
        25% {
            transform: translate(8%, -4%) rotate(22deg) scale(1.12);
        }
        50% {
            transform: translate(10%, 8%) rotate(40deg) scale(0.95);
        }
        75% {
            transform: translate(-4%, 9%) rotate(18deg) scale(1.08);
        }
        100% {
            transform: translate(-10%, -7%) rotate(0deg) scale(1);
        }
    }
    @keyframes sp-current-b {
        0% {
            transform: translate(6%, 5%) rotate(0deg);
        }
        40% {
            transform: translate(-7%, 2%) rotate(-30deg);
        }
        70% {
            transform: translate(-2%, -8%) rotate(12deg);
        }
        100% {
            transform: translate(6%, 5%) rotate(0deg);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .bg img,
        .bg::before,
        .bg::after {
            animation: none;
        }
    }

    @media (max-width: 1199.98px) {
        .pin {
            padding: 0 3rem 0 11.5rem;
        }
    }
    @media (max-width: 809.98px) {
        .band {
            height: 180vh;
        }
        .pin {
            padding: 0 1.5rem;
        }
        .statement {
            font-size: 1.75rem;
        }
    }
</style>

<script>
    // Light words up across the first 65% of the pinned scroll, and feather the band
    // in and out at its edges so it blends with the page.
    const FINISH = 0.65
    const FADE = 0.9
    const ease = (t: number) => t * t * (3 - 2 * t)
    const clamp = (t: number) => Math.min(1, Math.max(0, t))

    const bands = [...document.querySelectorAll<HTMLElement>("[data-band]")].map((band) => ({
        band,
        pin: band.querySelector<HTMLElement>(".pin")!,
        words: [...band.querySelectorAll<HTMLElement>(".w")],
    }))

    let frame = 0
    const update = () => {
        frame = 0
        const vh = innerHeight
        for (const { band, pin, words } of bands) {
            const r = band.getBoundingClientRect()
            if (r.bottom < -vh || r.top > vh * 2) continue
            const total = r.height - vh
            const p = total > 0 ? clamp(-r.top / (total * FINISH)) : 0
            words.forEach((w, i) => w.classList.toggle("lit", p * words.length > i + 0.5))

            const fin = clamp((vh - r.top) / (vh * FADE))
            const fout = clamp(r.bottom / (vh * FADE))
            pin.style.opacity = String(ease(Math.min(fin, fout)))
            const a = (60 * (1 - ease(fin))).toFixed(1)
            const b = (100 - 60 * (1 - ease(fout))).toFixed(1)
            const m = `linear-gradient(to bottom, transparent 0%, #000 ${a}%, #000 ${b}%, transparent 100%)`
            pin.style.maskImage = m
            pin.style.webkitMaskImage = m
        }
    }
    const on = () => {
        if (!frame) frame = requestAnimationFrame(update)
    }
    update()
    addEventListener("scroll", on, { passive: true })
    addEventListener("resize", on)
</script>
