---
import Base from "../../layouts/Base.astro"
import "../../styles/case-mobile.css"
import "../../styles/case-enter.css"
import CaseNav from "../../components/CaseNav.astro"
import "../../styles/case.css"

/*
 * Scribble, an AI planning app. Being written section by section, starting with the overview.
 */

const sections = [
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "principles", label: "Principles" },
]

// What makes a goal feel achievable: each principle and what it means for the design.
const ic = {
    clarity: `<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4M8.5 11h5M11 8.5v5"/>`,
    action: `<path d="M5 6.5h9M5 12h9M5 17.5h6"/><path d="m16 15.5 2 2 3.5-4"/>`,
    momentum: `<path d="m4 17 5-5 4 3 7-7"/><path d="M15 8h5v5"/>`,
}
const principles = [
    { k: "Clarity", i: ic.clarity, h: "Make sense of what you want to achieve.", p: "Allow users to express unstructured thoughts through conversation and gradually shape them into clearly defined goals." },
    { k: "Actionability", i: ic.action, h: "Make the next step obvious.", p: "Break overwhelming goals into manageable tasks, with clear priorities and a suggested starting point." },
    { k: "Momentum", i: ic.momentum, h: "Make progress visible and plans adaptable.", p: "Help users recognize their progress, adjust tasks as priorities change, and return to goals without starting over." },
]

const info = [
    { h: "My Role", items: ["Independent Designer"] },
    { h: "Methods", items: ["Competitive Analysis", "User Surveys"] },
    { h: "Focus", items: ["AI-Assisted Planning"] },
]
---

<Base nav="case" title="Scribble · Sophia Tang" description="Scribble, an AI planning app that turns scattered thoughts into clear next steps.">
    <CaseNav sections={sections} />

    <main class="case" style="--hero-bg: #4a4f52">
        <!-- Hero -->
        <header id="introduction" class="hero">
            <div class="grain" aria-hidden="true"></div>
            <div class="title-area">
                <h1>Scribble<br />AI Planning App</h1>
            </div>
        </header>

        <div class="content first">
            <dl class="info">
                {
                    info.map((col) => (
                        <div class="info-col">
                            <dt>{col.h}</dt>
                            <dd>
                                {col.items.map((t) => (
                                    <span>{t}</span>
                                ))}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <!-- Overview -->
            <section id="overview" class="sec">
                <p class="tag">#overview</p>
                <h2 class="h">Turning scattered thoughts into actionable plans through conversation.</h2>
                <p class="body">
                    Scribble is an AI-powered planning app that helps students turn overwhelming goals into manageable next steps. As an independent designer, I designed a
                    voice-first experience where users can talk through their thoughts, see their plans take shape in real time, and refine AI-generated tasks to make getting
                    started easier.
                </p>
            </section>

            <!-- Problem -->
            <section id="problem" class="sec">
                <p class="tag">#problem</p>
                <h2 class="h">Today’s planning tools assume you already know what to do.</h2>
                <p class="body">
                    People often have goals they want to achieve, whether it’s starting a personal project, preparing for a career change, or simply getting their lives
                    organized. Yet these goals rarely begin as clear, actionable tasks. They start as scattered thoughts, vague intentions, and ideas that haven’t fully taken
                    shape.
                </p>
                <p class="body">
                    Most productivity tools are designed to organize tasks once they’ve been defined. The difficult work of figuring out where to start, breaking down a goal,
                    and deciding what comes next still falls on the user. As a result, planning itself can become another overwhelming task.
                </p>
            </section>

            <!-- Principles -->
            <section id="principles" class="sec">
                <p class="tag">#principles</p>
                <h2 class="h">What makes a goal feel achievable?</h2>
                <p class="body">
                    Drawing on survey findings, I defined three design principles to guide Scribble: helping people clarify what they want to achieve, identify where to start,
                    and maintain momentum along the way.
                </p>
                <div class="principles">
                    {
                        principles.map((x) => (
                            <div class="pr">
                                <div class="pr-art">
                                    <span class="pr-chip">{x.k}</span>
                                    <span class="pr-ico">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.i} />
                                    </span>
                                </div>
                                <p class="pr-h">{x.h}</p>
                                <p class="pr-text">{x.p}</p>
                            </div>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Base>

<style>
    /* principle cards: grid panel with a pill label and an outlined icon, the implication underneath */
    .principles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .pr {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        min-width: 0;
    }
    .pr-art {
        position: relative;
        aspect-ratio: 1.45;
        display: grid;
        place-items: center;
        margin-bottom: 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: url("/images/smn/grid.png") center / cover;
    }
    .pr-chip {
        position: absolute;
        left: 0.75rem;
        top: 0.75rem;
        padding: 0.3125rem 0.625rem;
        border: 1px solid #dcdcdc;
        border-radius: 999px;
        background: #fff;
        font: 400 13px/1 var(--sans);
        color: var(--ink);
    }
    .pr-ico {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 1.2px var(--ink);
    }
    .pr-ico svg {
        width: 1.375rem;
        height: 1.375rem;
        fill: none;
        stroke: var(--ink);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .pr-h {
        font: 500 1.0625rem/1.3 var(--serif);
        letter-spacing: -0.01em;
        color: var(--ink);
        text-wrap: balance;
    }
    .pr-text {
        font: 400 14px/1.5 var(--para);
        color: var(--label);
    }
    @media (max-width: 809.98px) {
        .principles {
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }
        .pr-art {
            aspect-ratio: 2.2;
        }
    }
</style>
